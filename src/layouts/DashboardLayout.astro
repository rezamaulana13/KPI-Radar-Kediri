---
import { ClientRouter } from "astro:transitions";
import "../assets/styles/global.css";
import Sidebar from "../components/layout/Sidebar.astro";
import Topbar from "../components/layout/Topbar.astro";
import MobileBottomNav from "../components/layout/MobileBottomNav.astro";
import RealtimeLiveWatcher from "../components/common/RealtimeLiveWatcher.astro";
const { title } = Astro.props as { title: string };
const user = Astro.locals.user;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap" rel="stylesheet" />
    <title>{title} · Radar Kediri</title>
    <ClientRouter />
  </head>
  <body>
    <div id="page-progress-bar" class="nav-loading-bar" aria-hidden="true"></div>
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />
    <div class="app">
      <Sidebar /><Topbar />
      <main class="main" id="konten"><slot /></main>
    </div>
    <label for="nav-toggle" class="scrim" aria-hidden="true"></label>
    <script is:inline>
      function initDashboardScripts() {
        document.querySelectorAll("[data-confirm-open]").forEach((b) => {
          b.onclick = (e) => {
            e.preventDefault();
            document.getElementById(b.dataset.confirmOpen)?.showModal();
          };
        });
        const navOpen = document.querySelector(".nav-open");
        if (navOpen) {
          navOpen.onkeydown = (e) => {
            if (e.key === "Enter" || e.key === " ") {
              e.preventDefault();
              const t = document.getElementById("nav-toggle");
              if (t) t.checked = !t.checked;
            }
          };
        }
      }
      document.addEventListener("astro:before-preparation", () => {
        const bar = document.getElementById("page-progress-bar");
        if (bar) {
          bar.classList.remove("is-done");
          bar.classList.add("is-loading");
        }
      });
      document.addEventListener("astro:page-load", () => {
        const bar = document.getElementById("page-progress-bar");
        if (bar) {
          bar.classList.add("is-done");
          setTimeout(() => bar.classList.remove("is-loading", "is-done"), 200);
        }
      });
      document.addEventListener("astro:page-load", initDashboardScripts);
      initDashboardScripts();
    </script>
    <MobileBottomNav role={user?.role} />
    <RealtimeLiveWatcher role={user?.role} userId={user?.id} />
  </body>
</html>
