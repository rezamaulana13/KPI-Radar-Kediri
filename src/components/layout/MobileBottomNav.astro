---
import { db } from "../../lib/data/store";

interface Props {
  currentPath?: string;
  role?: string;
}

const { currentPath = Astro.url.pathname, role = Astro.locals.user?.role || "employee" } = Astro.props;

const isEmployee = role === "employee";
const isHrd = role === "hrd";
const isAdmin = role === "admin";

const pendingCount = db.activities.filter((a) => a.status === "pending").length;

const isActive = (path: string) => {
  if (path === "/" && currentPath === "/") return true;
  if (path !== "/" && currentPath.startsWith(path)) return true;
  return false;
};
---

<nav class="mobile-bottom-nav" aria-label="Navigasi Bawah Mobile">
  {isEmployee ? (
    <>
      {/* 1. NAVBAR KHUSUS ROLE KARYAWAN */}
      <a href="/" data-astro-prefetch="load" class={`nav-item ${isActive("/") ? "active" : ""}`}>
        <div class="nav-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
        </div>
        <span class="nav-label">Beranda</span>
      </a>

      <a href="/aktivitas-saya" data-astro-prefetch="load" class={`nav-item ${isActive("/aktivitas-saya") ? "active" : ""}`}>
        <div class="nav-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
        </div>
        <span class="nav-label">Riwayat</span>
      </a>

      {/* Tombol Floating Tengah: Modul Operasional (Input Pekerjaan Lapangan) */}
      <div class="nav-item-center">
        <a href="/modul-marketing" data-astro-prefetch="load" class={`btn-floating-action ${isActive("/modul-marketing") ? "active" : ""}`} title="Modul Operasional Marketing">
          <div class="floating-circle">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="7" height="7" x="3" y="3" rx="1"/>
              <rect width="7" height="7" x="14" y="3" rx="1"/>
              <rect width="7" height="7" x="14" y="14" rx="1"/>
              <rect width="7" height="7" x="3" y="14" rx="1"/>
            </svg>
          </div>
          <span class="floating-label">Modul</span>
        </a>
      </div>

      <a href="/kinerja" data-astro-prefetch="load" class={`nav-item ${isActive("/kinerja") ? "active" : ""}`}>
        <div class="nav-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="20" x2="18" y2="10"/>
            <line x1="12" y1="20" x2="12" y2="4"/>
            <line x1="6" y1="20" x2="6" y2="14"/>
          </svg>
        </div>
        <span class="nav-label">Kinerja</span>
      </a>

      <a href="/profile" data-astro-prefetch="load" class={`nav-item ${isActive("/profile") ? "active" : ""}`}>
        <div class="nav-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
        </div>
        <span class="nav-label">Profil</span>
      </a>
    </>
  ) : isHrd ? (
    <>
      {/* 2. NAVBAR KHUSUS ROLE ADMIN HRD */}
      <a href="/dashboard" data-astro-prefetch="load" class={`nav-item ${isActive("/dashboard") ? "active" : ""}`}>
        <div class="nav-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="7" height="9" x="3" y="3" rx="1"/>
            <rect width="7" height="5" x="14" y="3" rx="1"/>
            <rect width="7" height="9" x="14" y="12" rx="1"/>
            <rect width="7" height="5" x="3" y="16" rx="1"/>
          </svg>
        </div>
        <span class="nav-label">Dasbor</span>
      </a>

      <a href="/hrd/kpi/targets" data-astro-prefetch="load" class={`nav-item ${isActive("/hrd/kpi") ? "active" : ""}`}>
        <div class="nav-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/>
            <line x1="4" y1="22" x2="4" y2="15"/>
          </svg>
        </div>
        <span class="nav-label">Target KPI</span>
      </a>

      {/* Tombol Floating Tengah: Verifikasi Berkas (Fungsi Utama HRD) */}
      <div class="nav-item-center">
        <a href="/hrd/verifications" data-astro-prefetch="load" class={`btn-floating-action ${isActive("/hrd/verifications") ? "active" : ""}`} title="Antrean Verifikasi Berkas">
          <div class="floating-circle" style="background: linear-gradient(135deg, #059669 0%, #047857 100%); box-shadow: 0 8px 18px rgba(5, 150, 105, 0.45);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            {pendingCount > 0 && <span class="floating-badge">{pendingCount}</span>}
          </div>
          <span class="floating-label" style="color: #047857;">Verifikasi</span>
        </a>
      </div>

      <a href="/hrd/reports" data-astro-prefetch="load" class={`nav-item ${isActive("/hrd/reports") ? "active" : ""}`}>
        <div class="nav-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
            <polyline points="10 9 9 9 8 9"/>
          </svg>
        </div>
        <span class="nav-label">Laporan</span>
      </a>

      <a href="/profile" data-astro-prefetch="load" class={`nav-item ${isActive("/profile") ? "active" : ""}`}>
        <div class="nav-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
        </div>
        <span class="nav-label">Profil</span>
      </a>
    </>
  ) : isAdmin ? (
    <>
      {/* 3. NAVBAR KHUSUS ROLE SUPER ADMIN */}
      <a href="/dashboard" data-astro-prefetch="load" class={`nav-item ${isActive("/dashboard") ? "active" : ""}`}>
        <div class="nav-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="7" height="9" x="3" y="3" rx="1"/>
            <rect width="7" height="5" x="14" y="3" rx="1"/>
            <rect width="7" height="9" x="14" y="12" rx="1"/>
            <rect width="7" height="5" x="3" y="16" rx="1"/>
          </svg>
        </div>
        <span class="nav-label">Dasbor</span>
      </a>

      <a href="/hrd/verifications" data-astro-prefetch="load" class={`nav-item ${isActive("/hrd/verifications") ? "active" : ""}`}>
        <div class="nav-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
          </svg>
        </div>
        <span class="nav-label">Verifikasi</span>
      </a>

      {/* Tombol Floating Tengah: Pengguna & Hak Akses (Fungsi Utama Super Admin) */}
      <div class="nav-item-center">
        <a href="/admin/users" data-astro-prefetch="load" class={`btn-floating-action ${isActive("/admin/users") || isActive("/admin/employees") ? "active" : ""}`} title="Kelola Pengguna & Personel">
          <div class="floating-circle" style="background: linear-gradient(135deg, #0f2c4d 0%, #1e3a8a 100%); box-shadow: 0 8px 18px rgba(15, 44, 77, 0.45);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <span class="floating-label" style="color: #0f2c4d;">Pengguna</span>
        </a>
      </div>

      <a href="/admin/audit-logs" data-astro-prefetch="load" class={`nav-item ${isActive("/admin/audit-logs") ? "active" : ""}`}>
        <div class="nav-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </div>
        <span class="nav-label">Audit Log</span>
      </a>

      <a href="/profile" data-astro-prefetch="load" class={`nav-item ${isActive("/profile") ? "active" : ""}`}>
        <div class="nav-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
        </div>
        <span class="nav-label">Profil</span>
      </a>
    </>
  ) : (
    <>
      {/* 4. PENGUNJUNG UMUM / BELUM LOGIN */}
      <a href="/" class={`nav-item ${isActive("/") ? "active" : ""}`}>
        <div class="nav-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          </svg>
        </div>
        <span class="nav-label">Beranda</span>
      </a>
      <a href="/login" class={`nav-item ${isActive("/login") ? "active" : ""}`}>
        <div class="nav-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
            <polyline points="10 17 15 12 10 7"/>
            <line x1="15" y1="12" x2="3" y2="12"/>
          </svg>
        </div>
        <span class="nav-label">Masuk</span>
      </a>
    </>
  )}
</nav>

<style>
  /* Hanya tampil di Mobile / Android */
  .mobile-bottom-nav {
    display: none;
  }

  @media (max-width: 768px) {
    .mobile-bottom-nav {
      display: flex;
      align-items: center;
      justify-content: space-around;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      width: 100vw;
      max-width: 100vw;
      box-sizing: border-box;
      height: 64px;
      background: #ffffff;
      border-top: 1px solid #e2e8f0;
      box-shadow: 0 -4px 20px rgba(15, 23, 42, 0.08);
      z-index: 9999;
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }

    .nav-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      flex: 1;
      height: 100%;
      color: #64748b;
      text-decoration: none;
      font-size: 0.7rem;
      font-weight: 550;
      gap: 3px;
      transition: color 0.15s ease;
      -webkit-tap-highlight-color: transparent;
    }

    .nav-item:hover,
    .nav-item.active {
      color: #1d4ed8;
    }

    .nav-icon {
      display: grid;
      place-items: center;
      height: 24px;
    }

    .nav-label {
      line-height: 1;
    }

    /* Tombol Floating Tengah (Elevated Center Button) */
    .nav-item-center {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      flex: 1;
      position: relative;
    }

    .btn-floating-action {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-decoration: none;
      transform: translateY(-16px);
      -webkit-tap-highlight-color: transparent;
    }

    .floating-circle {
      width: 52px;
      height: 52px;
      background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
      color: #ffffff;
      border-radius: 50%;
      display: grid;
      place-items: center;
      box-shadow: 0 8px 18px rgba(29, 78, 216, 0.45);
      border: 4px solid #ffffff;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
      position: relative;
    }

    .btn-floating-action:active .floating-circle {
      transform: scale(0.92);
      box-shadow: 0 4px 10px rgba(29, 78, 216, 0.35);
    }

    .floating-badge {
      position: absolute;
      top: -3px;
      right: -3px;
      background: #ef4444;
      color: #ffffff;
      font-size: 0.65rem;
      font-weight: 700;
      min-width: 18px;
      height: 18px;
      border-radius: 999px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 2px solid #ffffff;
    }

    .floating-label {
      font-size: 0.7rem;
      font-weight: 700;
      color: #1d4ed8;
      margin-top: 2px;
      line-height: 1;
    }
  }
</style>
