---
import Breadcrumbs from "./Breadcrumbs.astro";
const { title, description, crumbs = [] } = Astro.props as { title: string; description?: string; crumbs?: { label: string; href?: string }[] };
---
<Breadcrumbs items={[{ label: "Beranda", href: "/dashboard" }, ...crumbs, { label: title }]} />
<header class="page-header">
  <div><h1>{title}</h1>{description && <p>{description}</p>}</div>
  <div class="row"><slot name="actions" /></div>
</header>
