---
import Badge from "./Badge.astro";
import Meter from "./Meter.astro";
import EmptyState from "./EmptyState.astro";
import Pagination from "./Pagination.astro";
import { rupiah, num, pct, dateID, dateTimeID } from "../../lib/formatters";

export interface Col {
  key: string; label: string;
  type?: "text" | "badge" | "date" | "datetime" | "number" | "rupiah" | "percent" | "meter" | "mono";
  href?: (row: any) => string | undefined;
  render?: (row: any) => string;
}
const { columns, rows, total, page = 1, perPage = 10, emptyTitle, emptyHint, caption } = Astro.props as {
  columns: Col[]; rows: any[]; total?: number; page?: number; perPage?: number; emptyTitle?: string; emptyHint?: string; caption?: string;
};
const t = total ?? rows.length;
const pages = Math.max(1, Math.ceil(t / perPage));
const numeric = new Set(["number", "rupiah", "percent"]);
---
{rows.length === 0 ? <EmptyState title={emptyTitle} hint={emptyHint}><slot name="empty" /></EmptyState> : (
  <>
    <div class="table-wrap" tabindex="0" role="region" aria-label={caption ?? "Tabel data"}>
      <table class="table">
        {caption && <caption class="sr-only">{caption}</caption>}
        <thead><tr>{columns.map((c) => <th scope="col" class={numeric.has(c.type ?? "") ? "num" : ""}>{c.label}</th>)}</tr></thead>
        <tbody>
          {rows.map((r) => (
            <tr>{columns.map((c) => {
              const raw = c.render ? c.render(r) : r[c.key];
              const href = c.href?.(r);
              return (
                <td class={numeric.has(c.type ?? "") ? "num" : c.type === "mono" ? "mono" : ""}>
                  {c.type === "badge" ? <Badge status={String(raw)} />
                    : c.type === "meter" ? (raw == null ? <span class="muted">Tanpa mapping</span> : <div class="row" style="flex-wrap:nowrap"><Meter value={raw} /><span class="mono text-xs">{num(raw, 0)}%</span></div>)
                    : href ? <a href={href}>{c.type === "rupiah" ? rupiah(raw) : raw}</a>
                    : c.type === "date" ? dateID(raw) : c.type === "datetime" ? dateTimeID(raw)
                    : c.type === "rupiah" ? rupiah(raw) : c.type === "number" ? num(raw) : c.type === "percent" ? pct(raw, 1)
                    : (raw ?? "—")}
                </td>
              );
            })}</tr>
          ))}
        </tbody>
      </table>
    </div>
    <Pagination page={page} pages={pages} total={t} perPage={perPage} />
  </>
)}
