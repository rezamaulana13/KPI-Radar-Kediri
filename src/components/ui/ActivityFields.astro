---
// Field rincian dinamis sesuai jenis aktivitas Marketing & Sirkulasi Radar Kediri.
import { db } from "../../lib/data/store";
import { noReasonCategories, oplahSources, progressTypes } from "../../lib/data/mock";
import FormError from "./FormError.astro";

interface Props {
  errors?: Record<string, string>;
  values?: Record<string, any>;
  offerId?: string;
  ownerId?: string;
  activeType?: string;
}

const {
  errors = {},
  values = {},
  offerId,
  ownerId,
  activeType = values.type ?? "oplah",
} = Astro.props;

const v = (k: string) => values[k] ?? "";
const myClients = ownerId ? db.clients.filter((c) => c.ownerId === ownerId) : db.clients;
const myOffers = ownerId ? db.offers.filter((o) => o.ownerId === ownerId) : db.offers;
const clientOpts = myClients.length ? myClients : db.clients;
const offerOpts = myOffers.length ? myOffers : db.offers;

const isBlockActive = (blockType: string) => blockType.split(" ").includes(activeType);
const isNoActive = activeType === "outcome" && v("outcome") === "no";
---

<!-- 1. OPLAH KORAN -->
<div
  data-block="oplah"
  class="dynamic-block"
  hidden={!isBlockActive("oplah")}
  style={!isBlockActive("oplah") ? "display: none;" : "display: block;"}
>
  <div class="dynamic-block-header">
    <div class="block-title">Rincian Sirkulasi Oplah Koran</div>
    <div class="block-kpi-tag">Indikator: IND-01 (Perolehan Oplah Koran)</div>
  </div>
  <div class="dynamic-grid-3">
    <div class="form-group">
      <label class="form-label" for="f-source">Sumber Oplah <span class="req">*</span></label>
      <select class="form-control" id="f-source" name="source" disabled={!isBlockActive("oplah")}>
        <option value="">-- Pilih Sumber Oplah --</option>
        {oplahSources.map((s) => (
          <option value={s} selected={v("source") === s}>{s}</option>
        ))}
      </select>
      <span class="form-hint">Kategori jalur distribusi koran</span>
      <FormError message={errors.source} />
    </div>

    <div class="form-group">
      <label class="form-label" for="f-sourceName">Nama Agen / Loper / Pembaca <span class="req">*</span></label>
      <input
        class="form-control"
        id="f-sourceName"
        name="sourceName"
        type="text"
        placeholder="Contoh: Agen Sumber Rejeki Kediri Kota"
        value={v("sourceName")}
        disabled={!isBlockActive("oplah")}
      />
      <span class="form-hint">Nama entitas penerima koran</span>
      <FormError message={errors.sourceName} />
    </div>

    <div class="form-group">
      <label class="form-label" for="f-qty">Jumlah Eksemplar <span class="req">*</span></label>
      <input
        class="form-control"
        id="f-qty"
        name="qty"
        type="number"
        min="1"
        step="1"
        placeholder="Contoh: 150"
        value={v("qty")}
        disabled={!isBlockActive("oplah")}
      />
      <span class="form-hint">Total eksemplar koran terkirim</span>
      <FormError message={errors.qty} />
    </div>
  </div>
</div>

<!-- 2. KLIEN BARU -->
<div
  data-block="client"
  class="dynamic-block"
  hidden={!isBlockActive("client")}
  style={!isBlockActive("client") ? "display: none;" : "display: block;"}
>
  <div class="dynamic-block-header">
    <div class="block-title">Rincian Pendaftaran Klien Baru</div>
    <div class="block-kpi-tag">Indikator: IND-02 (Client Baru Terdaftar)</div>
  </div>
  <div class="dynamic-grid-2">
    <div class="form-group">
      <label class="form-label" for="f-clientName">Nama Instansi / Perusahaan <span class="req">*</span></label>
      <input
        class="form-control"
        id="f-clientName"
        name="clientName"
        type="text"
        placeholder="Contoh: Dinas Komunikasi & Informatika Kota Kediri"
        value={v("clientName")}
        disabled={!isBlockActive("client")}
      />
      <span class="form-hint">Nama resmi calon pengiklan</span>
      <FormError message={errors.clientName} />
    </div>

    <div class="form-group">
      <label class="form-label" for="f-sector">Sektor Usaha / Bidang <span class="req">*</span></label>
      <input
        class="form-control"
        id="f-sector"
        name="sector"
        type="text"
        placeholder="Contoh: Pemerintahan Daerah (OPD) / Perbankan"
        value={v("sector")}
        disabled={!isBlockActive("client")}
      />
      <span class="form-hint">Kategori bidang usaha</span>
      <FormError message={errors.sector} />
    </div>

    <div class="form-group">
      <label class="form-label" for="f-contact">Nama Person In Charge (PIC) <span class="req">*</span></label>
      <input
        class="form-control"
        id="f-contact"
        name="contact"
        type="text"
        placeholder="Contoh: Bpk. Hendro Wijaya (Kabid IKP)"
        value={v("contact")}
        disabled={!isBlockActive("client")}
      />
      <span class="form-hint">Pejabat atau kontak perwakilan</span>
      <FormError message={errors.contact} />
    </div>

    <div class="form-group">
      <label class="form-label" for="f-phone">Nomor Telepon / WhatsApp <span class="req">*</span></label>
      <input
        class="form-control"
        id="f-phone"
        name="phone"
        type="tel"
        placeholder="Contoh: 081234567890"
        value={v("phone")}
        disabled={!isBlockActive("client")}
      />
      <span class="form-hint">Nomor yang dapat dihubungi</span>
      <FormError message={errors.phone} />
    </div>

    <div class="form-group full-col">
      <label class="form-label" for="f-city">Kota / Kabupaten <span class="req">*</span></label>
      <input
        class="form-control"
        id="f-city"
        name="city"
        type="text"
        placeholder="Contoh: Kota Kediri / Kab. Kediri / Nganjuk"
        value={v("city")}
        disabled={!isBlockActive("client")}
      />
      <span class="form-hint">Wilayah domisili kantor mitra</span>
      <FormError message={errors.city} />
    </div>
  </div>
</div>

<!-- 3. PENAWARAN IKLAN -->
<div
  data-block="offer"
  class="dynamic-block"
  hidden={!isBlockActive("offer")}
  style={!isBlockActive("offer") ? "display: none;" : "display: block;"}
>
  <div class="dynamic-block-header">
    <div class="block-title">Rincian Proposal Penawaran Iklan</div>
    <div class="block-kpi-tag">Indikator: IND-03 (Penawaran Dikirim)</div>
  </div>
  <div class="dynamic-grid-2">
    <div class="form-group full-col">
      <label class="form-label" for="f-offer-client">Pilih Klien Sasaran <span class="req">*</span></label>
      <select class="form-control" id="f-offer-client" name="clientId" disabled={!isBlockActive("offer")}>
        <option value="">-- Pilih Klien Terdaftar --</option>
        {clientOpts.map((c) => (
          <option value={c.id} selected={v("clientId") === c.id}>
            {c.name} ({c.city} - {c.sector})
          </option>
        ))}
      </select>
      <span class="form-hint">Pilih mitra dari database. Jika belum ada, daftarkan lewat jenis "Klien Baru".</span>
      <FormError message={errors.clientId} />
    </div>

    <div class="form-group">
      <label class="form-label" for="f-offer-program">Nama Paket Penawaran <span class="req">*</span></label>
      <input
        class="form-control"
        id="f-offer-program"
        name="programName"
        type="text"
        placeholder="Contoh: Paket Advertorial Liputan Program Pemkot 1 Hal FC"
        value={v("programName")}
        disabled={!isBlockActive("offer")}
      />
      <span class="form-hint">Judul paket atau rubrik iklan</span>
      <FormError message={errors.programName} />
    </div>

    <div class="form-group">
      <label class="form-label" for="f-offer-value">Nilai Penawaran (Rp) <span class="req">*</span></label>
      <input
        class="form-control"
        id="f-offer-value"
        name="value"
        type="number"
        min="1"
        step="1000"
        placeholder="Contoh: 15000000"
        value={v("value")}
        disabled={!isBlockActive("offer")}
      />
      <span class="form-hint">Nominal proposal dalam Rupiah (tanpa titik)</span>
      <FormError message={errors.value} />
    </div>
  </div>
</div>

<!-- 4. PROGRES KUNJUNGAN -->
<div
  data-block="progress"
  class="dynamic-block"
  hidden={!isBlockActive("progress")}
  style={!isBlockActive("progress") ? "display: none;" : "display: block;"}
>
  <div class="dynamic-block-header">
    <div class="block-title">Rincian Progres &amp; Kunjungan Lapangan</div>
    <div class="block-kpi-tag">Indikator: IND-08 (Progress &amp; Kunjungan)</div>
  </div>
  <div class="dynamic-grid-2">
    <div class="form-group">
      <label class="form-label" for="f-progress-offer">Pilih Proposal Penawaran <span class="req">*</span></label>
      <select class="form-control" id="f-progress-offer" name="offerId" disabled={!isBlockActive("progress")}>
        <option value="">-- Pilih Proposal Terkait --</option>
        {offerOpts.map((o) => (
          <option value={o.id} selected={(offerId ?? v("offerId")) === o.id}>
            {o.id} · {db.clients.find((c) => c.id === o.clientId)?.name} · {o.programName}
          </option>
        ))}
      </select>
      <span class="form-hint">Pilih berkas penawaran yang sedang difollow-up</span>
      <FormError message={errors.offerId} />
    </div>

    <div class="form-group">
      <label class="form-label" for="f-progress-type">Tahapan Progres <span class="req">*</span></label>
      <select class="form-control" id="f-progress-type" name="progressType" disabled={!isBlockActive("progress")}>
        <option value="">-- Pilih Tahapan Progres --</option>
        {progressTypes.map((t) => (
          <option value={t} selected={v("progressType") === t}>{t}</option>
        ))}
      </select>
      <span class="form-hint">Metode interaksi dengan pengambil keputusan</span>
      <FormError message={errors.progressType} />
    </div>
  </div>
</div>

<!-- 5. RISET PROFILING -->
<div
  data-block="profiling"
  class="dynamic-block"
  hidden={!isBlockActive("profiling")}
  style={!isBlockActive("profiling") ? "display: none;" : "display: block;"}
>
  <div class="dynamic-block-header">
    <div class="block-title">Rincian Riset &amp; Profiling Pasar</div>
    <div class="block-kpi-tag">Indikator: IND-06 (Riset Profiling Selesai)</div>
  </div>
  <div class="dynamic-grid-2">
    <div class="form-group">
      <label class="form-label" for="f-profiling-client">Pilih Klien Riset <span class="req">*</span></label>
      <select class="form-control" id="f-profiling-client" name="clientId" disabled={!isBlockActive("profiling")}>
        <option value="">-- Pilih Klien Terdaftar --</option>
        {clientOpts.map((c) => (
          <option value={c.id} selected={v("clientId") === c.id}>
            {c.name} ({c.city})
          </option>
        ))}
      </select>
      <span class="form-hint">Pilih entitas mitra yang diriset</span>
      <FormError message={errors.clientId} />
    </div>

    <div class="form-group">
      <label class="form-label" for="f-profiling-pot">Potensi Anggaran Promosi <span class="req">*</span></label>
      <select class="form-control" id="f-profiling-pot" name="potential" disabled={!isBlockActive("profiling")}>
        <option value="">-- Pilih Potensi Anggaran --</option>
        {["Tinggi", "Sedang", "Rendah"].map((s) => (
          <option value={s} selected={v("potential") === s}>{s}</option>
        ))}
      </select>
      <span class="form-hint">Estimasi kapasitas belanja media mitra</span>
      <FormError message={errors.potential} />
    </div>
  </div>
</div>

<!-- 6. PROGRAM & BARTER -->
<div
  data-block="program"
  class="dynamic-block"
  hidden={!isBlockActive("program")}
  style={!isBlockActive("program") ? "display: none;" : "display: block;"}
>
  <div class="dynamic-block-header">
    <div class="block-title">Rincian Program, Event &amp; Barter Promosi</div>
    <div class="block-kpi-tag">Indikator: IND-07 (Program/Barter Terlaksana)</div>
  </div>
  <div class="dynamic-grid-2">
    <div class="form-group">
      <label class="form-label" for="f-program-name">Nama Agenda / Program <span class="req">*</span></label>
      <input
        class="form-control"
        id="f-program-name"
        name="programName"
        type="text"
        placeholder="Contoh: Radar Kediri School Futsal Cup 2026"
        value={v("programName")}
        disabled={!isBlockActive("program")}
      />
      <span class="form-hint">Nama kegiatan atau kemitraan acara</span>
      <FormError message={errors.programName} />
    </div>

    <div class="form-group">
      <label class="form-label" for="f-program-kind">Jenis Kerjasama <span class="req">*</span></label>
      <select class="form-control" id="f-program-kind" name="kind" disabled={!isBlockActive("program")}>
        <option value="">-- Pilih Jenis --</option>
        <option value="program" selected={v("kind") === "program"}>Program Sponsorship / Event</option>
        <option value="barter" selected={v("kind") === "barter"}>Barter Promosi Publikasi</option>
      </select>
      <span class="form-hint">Skema bentuk kerja sama</span>
      <FormError message={errors.kind} />
    </div>

    <div class="form-group">
      <label class="form-label" for="f-program-start">Tanggal Mulai <span class="req">*</span></label>
      <input
        class="form-control"
        id="f-program-start"
        name="start"
        type="date"
        value={v("start")}
        disabled={!isBlockActive("program")}
      />
      <FormError message={errors.start} />
    </div>

    <div class="form-group">
      <label class="form-label" for="f-program-end">Tanggal Selesai <span class="req">*</span></label>
      <input
        class="form-control"
        id="f-program-end"
        name="end"
        type="date"
        value={v("end")}
        disabled={!isBlockActive("program")}
      />
      <FormError message={errors.end} />
    </div>

    <div class="form-group full-col">
      <label class="form-label" for="f-program-value">Nilai Estimasi (Rp)</label>
      <input
        class="form-control"
        id="f-program-value"
        name="value"
        type="number"
        min="0"
        step="1000"
        placeholder="Contoh: 25000000"
        value={v("value")}
        disabled={!isBlockActive("program")}
      />
      <span class="form-hint">Estimasi total nilai kontrak / barter sponsor</span>
      <FormError message={errors.value} />
    </div>

    <div class="form-group full-col">
      <label class="form-label">Mitra / Klien Peserta Kegiatan</label>
      <div class="participants-checkbox-grid">
        {db.clients.map((c) => (
          <label class="checkbox-pill">
            <input
              type="checkbox"
              name="participants"
              value={c.id}
              checked={(values.participants ?? []).includes(c.id)}
              disabled={!isBlockActive("program")}
            />
            <span>{c.name}</span>
          </label>
        ))}
      </div>
      <span class="form-hint">Pilih satu atau lebih mitra yang berpartisipasi</span>
    </div>
  </div>
</div>

<!-- 7. CLOSING DEAL / HASIL AKHIR -->
<div
  data-block="outcome"
  class="dynamic-block"
  hidden={!isBlockActive("outcome")}
  style={!isBlockActive("outcome") ? "display: none;" : "display: block;"}
>
  <div class="dynamic-block-header">
    <div class="block-title">Rincian Closing Deal &amp; Kesepakatan Akhir</div>
    <div class="block-kpi-tag">Indikator: IND-04 &amp; IND-05 (Deal Tercapai)</div>
  </div>
  <div class="dynamic-grid-2">
    <div class="form-group">
      <label class="form-label" for="f-outcome-offer">Pilih Proposal Penawaran <span class="req">*</span></label>
      <select class="form-control" id="f-outcome-offer" name="offerId" disabled={!isBlockActive("outcome")}>
        <option value="">-- Pilih Proposal yang Diberi Keputusan --</option>
        {offerOpts.map((o) => (
          <option value={o.id} selected={(offerId ?? v("offerId")) === o.id}>
            {o.id} · {db.clients.find((c) => c.id === o.clientId)?.name} · Rp {Number(o.value || 0).toLocaleString("id-ID")}
          </option>
        ))}
      </select>
      <span class="form-hint">Pilih berkas penawaran yang telah selesai negosiasi</span>
      <FormError message={errors.offerId} />
    </div>

    <div class="form-group">
      <label class="form-label" for="f-outcome-choice">Hasil Akhir Keputusan <span class="req">*</span></label>
      <select class="form-control" id="f-outcome-choice" name="outcome" disabled={!isBlockActive("outcome")}>
        <option value="">-- Pilih Hasil Akhir --</option>
        <option value="deal" selected={v("outcome") === "deal"}>✅ DEAL (Disepakati / Tayang Iklan)</option>
        <option value="no" selected={v("outcome") === "no"}>❌ NO (Ditolak / Batal Beriklan)</option>
      </select>
      <span class="form-hint">Pilih Deal untuk pencapaian closing, atau NO jika ditolak</span>
      <FormError message={errors.outcome} />
    </div>

    <!-- BLOK KHUSUS JIKA HASIL NO -->
    <div
      data-no
      class="form-group full-col alert-no-wrap"
      hidden={!isNoActive}
      style={!isNoActive ? "display: none;" : "display: block;"}
    >
      <div class="alert-no-head">
        <span class="alert-no-tag">EVALUASI PENOLAKAN (NO)</span>
        <p style="margin: 0.2rem 0 0.75rem; font-size: var(--text-xs); color: #991b1b;">
          Catatan penolakan ini wajib diisi secara objektif untuk bahan evaluasi strategi penetapan tarif dan pendekatan klien berikutnya.
        </p>
      </div>

      <div class="form-group">
        <label class="form-label" for="f-reason-cat">Kategori Alasan Penolakan <span class="req">*</span></label>
        <select class="form-control" id="f-reason-cat" name="reasonCategory" disabled={!isNoActive}>
          <option value="">-- Pilih Kategori Alasan NO --</option>
          {noReasonCategories.map((s) => (
            <option value={s} selected={v("reasonCategory") === s}>{s}</option>
          ))}
        </select>
        <FormError message={errors.reasonCategory} />
      </div>

      <div class="form-group">
        <label class="form-label" for="f-reason-detail">Penjelasan Rinci Alasan NO <span class="req">*</span></label>
        <textarea
          class="form-control"
          id="f-reason-detail"
          name="reason"
          rows={3}
          placeholder="Jelaskan alasan detail mitra tidak sepakat (contoh: Klien mengalihkan anggaran ke media sosial, atau anggaran APBD telah terikat program lain)... Minimal 10 karakter."
          disabled={!isNoActive}
        >{v("reason")}</textarea>
        <span class="form-hint">Minimal 10 karakter agar dapat dianalisis tim pimpinan</span>
        <FormError message={errors.reason} />
      </div>
    </div>
  </div>
</div>

<style>
  .dynamic-block {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.5rem;
    animation: blockFadeIn 0.2s ease-out;
  }

  @keyframes blockFadeIn {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .dynamic-block-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #e2e8f0;
    flex-wrap: wrap;
  }

  .block-title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-primary-900);
  }

  .block-kpi-tag {
    font-size: 0.6875rem;
    font-weight: 650;
    padding: 0.2rem 0.65rem;
    background: #e0f2fe;
    color: #0369a1;
    border-radius: 999px;
  }

  .dynamic-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .dynamic-grid-3 {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1.25rem;
  }

  @media (max-width: 768px) {
    .dynamic-grid-2,
    .dynamic-grid-3 {
      grid-template-columns: 1fr;
    }
  }

  .full-col {
    grid-column: 1 / -1;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    margin-bottom: 0.5rem;
  }

  .form-label {
    font-size: 0.8125rem;
    font-weight: 650;
    color: #1e293b;
    margin-bottom: 0.35rem;
  }

  .req {
    color: #dc2626;
  }

  .form-control {
    width: 100%;
    padding: 0.6rem 0.8rem;
    font-size: 0.875rem;
    border: 1px solid #cbd5e1;
    border-radius: var(--radius-sm);
    background: #ffffff;
    color: #0f172a;
    font-family: inherit;
    box-sizing: border-box;
    transition: all 0.15s ease;
  }

  .form-control:focus {
    outline: none;
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
  }

  .form-control:disabled {
    background: #f1f5f9;
    color: #94a3b8;
    cursor: not-allowed;
  }

  .form-hint {
    font-size: 0.75rem;
    color: #64748b;
    margin-top: 0.25rem;
  }

  .participants-checkbox-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.35rem;
  }

  .checkbox-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: var(--radius-sm);
    font-size: 0.8125rem;
    color: #334155;
    cursor: pointer;
    user-select: none;
    transition: all 0.12s ease;
  }

  .checkbox-pill:hover {
    background: #f1f5f9;
    border-color: #94a3b8;
  }

  .alert-no-wrap {
    background: #fff1f2;
    border: 1px solid #fecdd3;
    border-radius: var(--radius-sm);
    padding: 1rem 1.25rem;
    margin-top: 0.5rem;
  }

  .alert-no-tag {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    color: #9f1239;
    background: #ffe4e6;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    letter-spacing: 0.04em;
  }
</style>
