---
// Field rincian dinamis sesuai jenis aktivitas Marketing & Sirkulasi Radar Kediri.
import { db } from "../../lib/data/store";
import { noReasonCategories, oplahSources, progressTypes } from "../../lib/data/mock";
import FormError from "./FormError.astro";

interface Props {
  errors?: Record<string, string>;
  values?: Record<string, any>;
  offerId?: string;
  ownerId?: string;
  activeType?: string;
}

const {
  errors = {},
  values = {},
  offerId,
  ownerId,
  activeType = values.type ?? "oplah",
} = Astro.props;

const v = (k: string) => values[k] ?? "";
const myClients = ownerId ? db.clients.filter((c) => c.ownerId === ownerId) : db.clients;
const myOffers = ownerId ? db.offers.filter((o) => o.ownerId === ownerId) : db.offers;
const clientOpts = myClients.length ? myClients : db.clients;
const offerOpts = myOffers.length ? myOffers : db.offers;

const isBlockActive = (blockType: string) => blockType.split(" ").includes(activeType);
const isNoActive = activeType === "outcome" && v("outcome") === "no";
---

<!-- 1. OPLAH KORAN -->
<div
  data-block="oplah"
  class="dynamic-block"
  hidden={!isBlockActive("oplah")}
  style={!isBlockActive("oplah") ? "display: none;" : "display: block;"}
>
  <div class="dynamic-block-header">
    <div class="block-title">Rincian Sirkulasi Oplah &amp; Retur Koran</div>
    <div class="block-kpi-tag">Indikator: IND-01 (Eksemplar Bersih Terjual Masuk KPI)</div>
  </div>

  <div class="dynamic-grid-3">
    <div class="form-group">
      <label class="form-label" for="f-editionName">Edisi Koran</label>
      <input
        class="form-control"
        id="f-editionName"
        name="editionName"
        type="text"
        placeholder="Contoh: Edisi Harian Radar Kediri"
        value={v("editionName")}
        disabled={!isBlockActive("oplah")}
      />
      <span class="form-hint">Nama atau nomor edisi terbit</span>
      <FormError message={errors.editionName} />
    </div>

    <div class="form-group">
      <label class="form-label" for="f-source">Kanal Distribusi <span class="req">*</span></label>
      <select class="form-control" id="f-source" name="source" disabled={!isBlockActive("oplah")}>
        <option value="">-- Pilih Kanal Distribusi --</option>
        {oplahSources.map((s) => (
          <option value={s} selected={v("source") === s}>{s}</option>
        ))}
      </select>
      <span class="form-hint">Jalur peredaran / agen sasaran</span>
      <FormError message={errors.source} />
    </div>

    <div class="form-group">
      <label class="form-label" for="f-sourceName">Nama Agen / Mitra Penerima <span class="req">*</span></label>
      <input
        class="form-control"
        id="f-sourceName"
        name="sourceName"
        type="text"
        placeholder="Contoh: Agen Sumber Rejeki Kediri Kota"
        value={v("sourceName")}
        disabled={!isBlockActive("oplah")}
      />
      <span class="form-hint">Nama entitas penerima koran</span>
      <FormError message={errors.sourceName} />
    </div>
  </div>

  <div class="dynamic-grid-3" style="margin-top: 1rem;">
    <div class="form-group">
      <label class="form-label" for="f-qty">Eksemplar Dikirim <span class="req">*</span></label>
      <input
        class="form-control"
        id="f-qty"
        name="qty"
        type="number"
        min="1"
        step="1"
        placeholder="Contoh: 150"
        value={v("qty")}
        disabled={!isBlockActive("oplah")}
      />
      <span class="form-hint">Total koran yang didistribusikan</span>
      <FormError message={errors.qty} />
    </div>

    <div class="form-group">
      <label class="form-label" for="f-returnQty">Eksemplar Retur</label>
      <input
        class="form-control"
        id="f-returnQty"
        name="returnQty"
        type="number"
        min="0"
        step="1"
        placeholder="0 jika tidak ada retur"
        value={v("returnQty") || "0"}
        disabled={!isBlockActive("oplah")}
      />
      <span class="form-hint">Koran kembali tidak laku</span>
      <FormError message={errors.returnQty} />
    </div>

    <div class="form-group">
      <label class="form-label" for="f-returnCondition">Kondisi Retur</label>
      <select class="form-control" id="f-returnCondition" name="returnCondition" disabled={!isBlockActive("oplah")}>
        <option value="layak_stok" selected={v("returnCondition") !== "rusak"}>Layak Stok Gudang</option>
        <option value="rusak" selected={v("returnCondition") === "rusak"}>Rusak / Afkir</option>
      </select>
      <span class="form-hint">Kelayakan koran retur untuk arsip</span>
      <FormError message={errors.returnCondition} />
    </div>
  </div>

  <!-- Box Rekonsiliasi Otomatis (Live Preview Terjual) -->
  <div class="oplah-reconcile-card" id="oplah-reconcile-card" style="margin-top: 1rem; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; padding: 0.75rem 1rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
    <div>
      <span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: #166534; letter-spacing: 0.05em;">Hasil Rekonsiliasi Sirkulasi:</span>
      <div style="font-size: 0.9375rem; font-weight: 700; color: #14532d;" id="oplah-calc-text">
        Eksemplar Terjual (Laku): <span id="oplah-sold-val">0</span> eksemplar (<span id="oplah-sold-pct">100%</span>)
      </div>
    </div>
    <div style="font-size: 0.8125rem; color: #15803d; font-weight: 500;" id="oplah-return-note">
      Retur: <span id="oplah-return-pct">0%</span>
    </div>
  </div>
</div>

<script>
  function setupOplahCalc() {
    const qtyInput = document.getElementById("f-qty") as HTMLInputElement | null;
    const returnInput = document.getElementById("f-returnQty") as HTMLInputElement | null;
    const soldVal = document.getElementById("oplah-sold-val");
    const soldPct = document.getElementById("oplah-sold-pct");
    const returnPct = document.getElementById("oplah-return-pct");

    function recalc() {
      if (!qtyInput || !returnInput || !soldVal || !soldPct || !returnPct) return;
      const q = Math.max(0, parseInt(qtyInput.value) || 0);
      const r = Math.max(0, parseInt(returnInput.value) || 0);
      const sold = Math.max(0, q - r);
      soldVal.textContent = sold.toLocaleString("id-ID");
      if (q > 0) {
        const sPercent = Math.round((sold / q) * 100);
        const rPercent = Math.round((r / q) * 100);
        soldPct.textContent = `${sPercent}%`;
        returnPct.textContent = `${rPercent}% (${r.toLocaleString("id-ID")} eks)`;
      } else {
        soldPct.textContent = "100%";
        returnPct.textContent = "0%";
      }
    }

    if (qtyInput) qtyInput.addEventListener("input", recalc);
    if (returnInput) returnInput.addEventListener("input", recalc);
    recalc();
  }

  document.addEventListener("DOMContentLoaded", setupOplahCalc);
  setupOplahCalc();
</script>

<!-- 2. KLIEN BARU -->
<div
  data-block="client"
  class="dynamic-block"
  hidden={!isBlockActive("client")}
  style={!isBlockActive("client") ? "display: none;" : "display: block;"}
>
  <div class="dynamic-block-header">
    <div class="block-title">Rincian Pendaftaran Klien Baru</div>
    <div class="block-kpi-tag">Indikator: IND-02 (Client Baru Terdaftar)</div>
  </div>
  <div class="dynamic-grid-2">
    <div class="form-group">
      <label class="form-label" for="f-clientName">Nama Instansi / Perusahaan <span class="req">*</span></label>
      <input
        class="form-control"
        id="f-clientName"
        name="clientName"
        type="text"
        placeholder="Contoh: Dinas Komunikasi & Informatika Kota Kediri"
        value={v("clientName")}
        disabled={!isBlockActive("client")}
      />
      <span class="form-hint">Nama resmi calon pengiklan</span>
      <FormError message={errors.clientName} />
    </div>

    <div class="form-group">
      <label class="form-label" for="f-sector">Sektor Usaha / Bidang <span class="req">*</span></label>
      <input
        class="form-control"
        id="f-sector"
        name="sector"
        type="text"
        placeholder="Contoh: Pemerintahan Daerah (OPD) / Perbankan"
        value={v("sector")}
        disabled={!isBlockActive("client")}
      />
      <span class="form-hint">Kategori bidang usaha</span>
      <FormError message={errors.sector} />
    </div>

    <div class="form-group">
      <label class="form-label" for="f-contact">Nama Person In Charge (PIC) <span class="req">*</span></label>
      <input
        class="form-control"
        id="f-contact"
        name="contact"
        type="text"
        placeholder="Contoh: Bpk. Hendro Wijaya (Kabid IKP)"
        value={v("contact")}
        disabled={!isBlockActive("client")}
      />
      <span class="form-hint">Pejabat atau kontak perwakilan</span>
      <FormError message={errors.contact} />
    </div>

    <div class="form-group">
      <label class="form-label" for="f-phone">Nomor Telepon / WhatsApp <span class="req">*</span></label>
      <input
        class="form-control"
        id="f-phone"
        name="phone"
        type="tel"
        placeholder="Contoh: 081234567890"
        value={v("phone")}
        disabled={!isBlockActive("client")}
      />
      <span class="form-hint">Nomor yang dapat dihubungi</span>
      <FormError message={errors.phone} />
    </div>

    <div class="form-group full-col">
      <label class="form-label" for="f-city">Kota / Kabupaten <span class="req">*</span></label>
      <input
        class="form-control"
        id="f-city"
        name="city"
        type="text"
        placeholder="Contoh: Kota Kediri / Kab. Kediri / Nganjuk"
        value={v("city")}
        disabled={!isBlockActive("client")}
      />
      <span class="form-hint">Wilayah domisili kantor mitra</span>
      <FormError message={errors.city} />
    </div>
  </div>
</div>

<!-- 3. PENAWARAN IKLAN -->
<div
  data-block="offer"
  class="dynamic-block"
  hidden={!isBlockActive("offer")}
  style={!isBlockActive("offer") ? "display: none;" : "display: block;"}
>
  <div class="dynamic-block-header">
    <div class="block-title">Rincian Proposal Kerja Sama &amp; Iklan</div>
    <div class="block-kpi-tag">Indikator: IND-03 (Penawaran Dikirim) &amp; IND-05 (Omzet)</div>
  </div>
  <div class="dynamic-grid-2">
    <div class="form-group full-col">
      <label class="form-label" for="f-offer-client">Pilih Klien Sasaran <span class="req">*</span></label>
      <select class="form-control" id="f-offer-client" name="clientId" disabled={!isBlockActive("offer")}>
        <option value="">-- Pilih Klien Terdaftar --</option>
        {clientOpts.map((c) => (
          <option value={c.id} selected={v("clientId") === c.id}>
            {c.name} ({c.city} - {c.sector})
          </option>
        ))}
      </select>
      <span class="form-hint">Pilih mitra dari database. Jika belum ada, daftarkan lewat jenis "Klien Baru".</span>
      <FormError message={errors.clientId} />
    </div>

    <div class="form-group">
      <label class="form-label" for="f-offer-program">Nama Paket / Program Iklan <span class="req">*</span></label>
      <input
        class="form-control"
        id="f-offer-program"
        name="programName"
        type="text"
        placeholder="Contoh: Paket Advertorial Liputan Pemkot 1 Hal FC"
        value={v("programName")}
        disabled={!isBlockActive("offer")}
      />
      <span class="form-hint">Judul paket atau rubrik iklan</span>
      <FormError message={errors.programName} />
    </div>

    <div class="form-group">
      <label class="form-label" for="f-partnership-type">Jenis Kerja Sama <span class="req">*</span></label>
      <select class="form-control" id="f-partnership-type" name="partnershipType" disabled={!isBlockActive("offer")}>
        <option value="tunai" selected={v("partnershipType") === "tunai" || !v("partnershipType")}>Tunai (Uang Kas Penuh)</option>
        <option value="barter" selected={v("partnershipType") === "barter"}>Barter (Barang / Jasa Penuh)</option>
        <option value="hybrid" selected={v("partnershipType") === "hybrid"}>Hybrid (Kombinasi Tunai + Barter)</option>
      </select>
      <span class="form-hint">Model kesepakatan komersial dengan klien</span>
      <FormError message={errors.partnershipType} />
    </div>

    <!-- Porsi Tunai (Kas) -->
    <div class="form-group" id="wrap-cash-val">
      <label class="form-label" for="f-cash-value">Porsi Nilai Tunai / Kas (Rp) <span class="req">*</span></label>
      <input
        class="form-control"
        id="f-cash-value"
        name="cashValue"
        type="number"
        min="0"
        step="1000"
        placeholder="Contoh: 10000000"
        value={v("cashValue") || (v("partnershipType") !== "barter" ? v("value") : "0")}
        disabled={!isBlockActive("offer")}
      />
      <span class="form-hint">Uang kas nyata yang dibayarkan pengiklan</span>
      <FormError message={errors.cashValue} />
    </div>

    <!-- Porsi Barter -->
    <div class="form-group" id="wrap-barter-val">
      <label class="form-label" for="f-barter-value">Porsi Nilai Barter (Rp)</label>
      <input
        class="form-control"
        id="f-barter-value"
        name="barterValue"
        type="number"
        min="0"
        step="1000"
        placeholder="0 jika murni tunai"
        value={v("barterValue") || (v("partnershipType") === "barter" ? v("value") : "0")}
        disabled={!isBlockActive("offer")}
      />
      <span class="form-hint">Estimasi nilai wajar produk/jasa yang dibarter</span>
      <FormError message={errors.barterValue} />
    </div>

    <!-- Rincian Barter (Muncul jika Barter atau Hybrid) -->
    <div class="form-group full-col" id="wrap-barter-desc">
      <div style="display: grid; grid-template-columns: 180px 1fr; gap: 0.75rem;">
        <div>
          <label class="form-label" for="f-barter-type">Bentuk Barter</label>
          <select class="form-control" id="f-barter-type" name="barterType" disabled={!isBlockActive("offer")}>
            <option value="barang" selected={v("barterType") !== "jasa"}>Barter Barang / Produk</option>
            <option value="jasa" selected={v("barterType") === "jasa"}>Barter Jasa / Layanan</option>
          </select>
        </div>
        <div>
          <label class="form-label" for="f-barter-desc">Rincian Barang / Layanan Barter</label>
          <input
            class="form-control"
            id="f-barter-desc"
            name="barterDesc"
            type="text"
            placeholder="Contoh: 5 Voucher Menginap Hotel Grand Surya @ Rp500.000"
            value={v("barterDesc")}
            disabled={!isBlockActive("offer")}
          />
        </div>
      </div>
      <span class="form-hint">Wajib diisi jika ada porsi barter untuk keperluan rekonsiliasi</span>
      <FormError message={errors.barterDesc} />
    </div>

    <input type="hidden" id="f-offer-value" name="value" value={v("value") || "0"} />
  </div>

  <!-- Live Card Total Komersial & Pemisahan Arus -->
  <div style="margin-top: 1rem; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 8px; padding: 0.75rem 1rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
    <div>
      <span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: #1e40af; letter-spacing: 0.05em;">Total Nilai Komersial:</span>
      <div style="font-size: 1.05rem; font-weight: 700; color: #1e3a8a;" id="offer-total-display">
        Rp 0
      </div>
    </div>
    <div style="font-size: 0.8125rem; color: #1d4ed8; font-weight: 500;" id="offer-breakdown-note">
      Kas Tunai: Rp 0 (0%) · Barter: Rp 0 (0%)
    </div>
  </div>
</div>

<script>
  function setupOfferCalc() {
    const typeSelect = document.getElementById("f-partnership-type") as HTMLSelectElement | null;
    const cashInput = document.getElementById("f-cash-value") as HTMLInputElement | null;
    const barterInput = document.getElementById("f-barter-value") as HTMLInputElement | null;
    const hiddenValue = document.getElementById("f-offer-value") as HTMLInputElement | null;
    const totalDisplay = document.getElementById("offer-total-display");
    const breakdownNote = document.getElementById("offer-breakdown-note");
    const wrapBarterDesc = document.getElementById("wrap-barter-desc");
    const wrapCashVal = document.getElementById("wrap-cash-val");
    const wrapBarterVal = document.getElementById("wrap-barter-val");

    function updateVisibility() {
      if (!typeSelect) return;
      const t = typeSelect.value;
      if (wrapBarterDesc) {
        wrapBarterDesc.style.display = t === "tunai" ? "none" : "block";
      }
      if (wrapBarterVal) {
        wrapBarterVal.style.display = t === "tunai" ? "none" : "block";
      }
      if (wrapCashVal) {
        wrapCashVal.style.display = t === "barter" ? "none" : "block";
      }
      if (t === "tunai" && barterInput) barterInput.value = "0";
      if (t === "barter" && cashInput) cashInput.value = "0";
      recalcOffer();
    }

    function recalcOffer() {
      if (!cashInput || !barterInput || !totalDisplay || !breakdownNote) return;
      const c = Math.max(0, parseInt(cashInput.value) || 0);
      const b = Math.max(0, parseInt(barterInput.value) || 0);
      const total = c + b;
      if (hiddenValue) hiddenValue.value = String(total);
      totalDisplay.textContent = `Rp ${total.toLocaleString("id-ID")}`;
      if (total > 0) {
        const cPct = Math.round((c / total) * 100);
        const bPct = Math.round((b / total) * 100);
        breakdownNote.textContent = `Kas Tunai: Rp ${c.toLocaleString("id-ID")} (${cPct}%) · Barter: Rp ${b.toLocaleString("id-ID")} (${bPct}%)`;
      } else {
        breakdownNote.textContent = `Kas Tunai: Rp 0 (0%) · Barter: Rp 0 (0%)`;
      }
    }

    if (typeSelect) typeSelect.addEventListener("change", updateVisibility);
    if (cashInput) cashInput.addEventListener("input", recalcOffer);
    if (barterInput) barterInput.addEventListener("input", recalcOffer);
    updateVisibility();
  }

  document.addEventListener("DOMContentLoaded", setupOfferCalc);
  setupOfferCalc();
</script>

<!-- 4. PROGRES KUNJUNGAN -->
<div
  data-block="progress"
  class="dynamic-block"
  hidden={!isBlockActive("progress")}
  style={!isBlockActive("progress") ? "display: none;" : "display: block;"}
>
  <div class="dynamic-block-header">
    <div class="block-title">Rincian Progres &amp; Kunjungan Lapangan</div>
    <div class="block-kpi-tag">Indikator: IND-08 (Progress &amp; Kunjungan)</div>
  </div>
  <div class="dynamic-grid-2">
    <div class="form-group">
      <label class="form-label" for="f-progress-offer">Pilih Proposal Penawaran <span class="req">*</span></label>
      <select class="form-control" id="f-progress-offer" name="offerId" disabled={!isBlockActive("progress")}>
        <option value="">-- Pilih Proposal Terkait --</option>
        {offerOpts.map((o) => (
          <option value={o.id} selected={(offerId ?? v("offerId")) === o.id}>
            {o.id} · {db.clients.find((c) => c.id === o.clientId)?.name} · {o.programName}
          </option>
        ))}
      </select>
      <span class="form-hint">Pilih berkas penawaran yang sedang difollow-up</span>
      <FormError message={errors.offerId} />
    </div>

    <div class="form-group">
      <label class="form-label" for="f-progress-type">Tahapan Progres <span class="req">*</span></label>
      <select class="form-control" id="f-progress-type" name="progressType" disabled={!isBlockActive("progress")}>
        <option value="">-- Pilih Tahapan Progres --</option>
        {progressTypes.map((t) => (
          <option value={t} selected={v("progressType") === t}>{t}</option>
        ))}
      </select>
      <span class="form-hint">Metode interaksi dengan pengambil keputusan</span>
      <FormError message={errors.progressType} />
    </div>
  </div>
</div>

<!-- 5. RISET PROFILING -->
<div
  data-block="profiling"
  class="dynamic-block"
  hidden={!isBlockActive("profiling")}
  style={!isBlockActive("profiling") ? "display: none;" : "display: block;"}
>
  <div class="dynamic-block-header">
    <div class="block-title">Rincian Riset &amp; Profiling Pasar</div>
    <div class="block-kpi-tag">Indikator: IND-06 (Riset Profiling Selesai)</div>
  </div>
  <div class="dynamic-grid-2">
    <div class="form-group">
      <label class="form-label" for="f-profiling-client">Pilih Klien Riset <span class="req">*</span></label>
      <select class="form-control" id="f-profiling-client" name="clientId" disabled={!isBlockActive("profiling")}>
        <option value="">-- Pilih Klien Terdaftar --</option>
        {clientOpts.map((c) => (
          <option value={c.id} selected={v("clientId") === c.id}>
            {c.name} ({c.city})
          </option>
        ))}
      </select>
      <span class="form-hint">Pilih entitas mitra yang diriset</span>
      <FormError message={errors.clientId} />
    </div>

    <div class="form-group">
      <label class="form-label" for="f-profiling-pot">Potensi Anggaran Promosi <span class="req">*</span></label>
      <select class="form-control" id="f-profiling-pot" name="potential" disabled={!isBlockActive("profiling")}>
        <option value="">-- Pilih Potensi Anggaran --</option>
        {["Tinggi", "Sedang", "Rendah"].map((s) => (
          <option value={s} selected={v("potential") === s}>{s}</option>
        ))}
      </select>
      <span class="form-hint">Estimasi kapasitas belanja media mitra</span>
      <FormError message={errors.potential} />
    </div>
  </div>
</div>

<!-- 6. PROGRAM & BARTER -->
<div
  data-block="program"
  class="dynamic-block"
  hidden={!isBlockActive("program")}
  style={!isBlockActive("program") ? "display: none;" : "display: block;"}
>
  <div class="dynamic-block-header">
    <div class="block-title">Rincian Program, Event &amp; Barter Promosi</div>
    <div class="block-kpi-tag">Indikator: IND-07 (Program/Barter Terlaksana)</div>
  </div>
  <div class="dynamic-grid-2">
    <div class="form-group">
      <label class="form-label" for="f-program-name">Nama Agenda / Program <span class="req">*</span></label>
      <input
        class="form-control"
        id="f-program-name"
        name="programName"
        type="text"
        placeholder="Contoh: Radar Kediri School Futsal Cup 2026"
        value={v("programName")}
        disabled={!isBlockActive("program")}
      />
      <span class="form-hint">Nama kegiatan atau kemitraan acara</span>
      <FormError message={errors.programName} />
    </div>

    <div class="form-group">
      <label class="form-label" for="f-program-kind">Jenis Kerjasama <span class="req">*</span></label>
      <select class="form-control" id="f-program-kind" name="kind" disabled={!isBlockActive("program")}>
        <option value="">-- Pilih Jenis --</option>
        <option value="program" selected={v("kind") === "program"}>Program Sponsorship / Event</option>
        <option value="barter" selected={v("kind") === "barter"}>Barter Promosi Publikasi</option>
      </select>
      <span class="form-hint">Skema bentuk kerja sama</span>
      <FormError message={errors.kind} />
    </div>

    <div class="form-group">
      <label class="form-label" for="f-program-start">Tanggal Mulai <span class="req">*</span></label>
      <input
        class="form-control"
        id="f-program-start"
        name="start"
        type="date"
        value={v("start")}
        disabled={!isBlockActive("program")}
      />
      <FormError message={errors.start} />
    </div>

    <div class="form-group">
      <label class="form-label" for="f-program-end">Tanggal Selesai <span class="req">*</span></label>
      <input
        class="form-control"
        id="f-program-end"
        name="end"
        type="date"
        value={v("end")}
        disabled={!isBlockActive("program")}
      />
      <FormError message={errors.end} />
    </div>

    <div class="form-group full-col">
      <label class="form-label" for="f-program-value">Nilai Estimasi (Rp)</label>
      <input
        class="form-control"
        id="f-program-value"
        name="value"
        type="number"
        min="0"
        step="1000"
        placeholder="Contoh: 25000000"
        value={v("value")}
        disabled={!isBlockActive("program")}
      />
      <span class="form-hint">Estimasi total nilai kontrak / barter sponsor</span>
      <FormError message={errors.value} />
    </div>

    <div class="form-group full-col">
      <label class="form-label">Mitra / Klien Peserta Kegiatan</label>
      <div class="participants-checkbox-grid">
        {db.clients.map((c) => (
          <label class="checkbox-pill">
            <input
              type="checkbox"
              name="participants"
              value={c.id}
              checked={(values.participants ?? []).includes(c.id)}
              disabled={!isBlockActive("program")}
            />
            <span>{c.name}</span>
          </label>
        ))}
      </div>
      <span class="form-hint">Pilih satu atau lebih mitra yang berpartisipasi</span>
    </div>
  </div>
</div>

<!-- 7. CLOSING DEAL / HASIL AKHIR -->
<div
  data-block="outcome"
  class="dynamic-block"
  hidden={!isBlockActive("outcome")}
  style={!isBlockActive("outcome") ? "display: none;" : "display: block;"}
>
  <div class="dynamic-block-header">
    <div class="block-title">Rincian Closing Deal &amp; Kesepakatan Akhir</div>
    <div class="block-kpi-tag">Indikator: IND-04 &amp; IND-05 (Deal Tercapai)</div>
  </div>
  <div class="dynamic-grid-2">
    <div class="form-group">
      <label class="form-label" for="f-outcome-offer">Pilih Proposal Penawaran <span class="req">*</span></label>
      <select class="form-control" id="f-outcome-offer" name="offerId" disabled={!isBlockActive("outcome")}>
        <option value="">-- Pilih Proposal yang Diberi Keputusan --</option>
        {offerOpts.map((o) => (
          <option value={o.id} selected={(offerId ?? v("offerId")) === o.id}>
            {o.id} · {db.clients.find((c) => c.id === o.clientId)?.name} · Rp {Number(o.value || 0).toLocaleString("id-ID")}
          </option>
        ))}
      </select>
      <span class="form-hint">Pilih berkas penawaran yang telah selesai negosiasi</span>
      <FormError message={errors.offerId} />
    </div>

    <div class="form-group">
      <label class="form-label" for="f-outcome-choice">Hasil Akhir Keputusan <span class="req">*</span></label>
      <select class="form-control" id="f-outcome-choice" name="outcome" disabled={!isBlockActive("outcome")}>
        <option value="">-- Pilih Hasil Akhir --</option>
        <option value="deal" selected={v("outcome") === "deal"}>✅ DEAL (Disepakati / Tayang Iklan)</option>
        <option value="no" selected={v("outcome") === "no"}>❌ NO (Ditolak / Batal Beriklan)</option>
      </select>
      <span class="form-hint">Pilih Deal untuk pencapaian closing, atau NO jika ditolak</span>
      <FormError message={errors.outcome} />
    </div>

    <!-- BLOK KHUSUS JIKA HASIL NO -->
    <div
      data-no
      class="form-group full-col alert-no-wrap"
      hidden={!isNoActive}
      style={!isNoActive ? "display: none;" : "display: block;"}
    >
      <div class="alert-no-head">
        <span class="alert-no-tag">EVALUASI PENOLAKAN (NO)</span>
        <p style="margin: 0.2rem 0 0.75rem; font-size: var(--text-xs); color: #991b1b;">
          Catatan penolakan ini wajib diisi secara objektif untuk bahan evaluasi strategi penetapan tarif dan pendekatan klien berikutnya.
        </p>
      </div>

      <div class="form-group">
        <label class="form-label" for="f-reason-cat">Kategori Alasan Penolakan <span class="req">*</span></label>
        <select class="form-control" id="f-reason-cat" name="reasonCategory" disabled={!isNoActive}>
          <option value="">-- Pilih Kategori Alasan NO --</option>
          {noReasonCategories.map((s) => (
            <option value={s} selected={v("reasonCategory") === s}>{s}</option>
          ))}
        </select>
        <FormError message={errors.reasonCategory} />
      </div>

      <div class="form-group">
        <label class="form-label" for="f-reason-detail">Penjelasan Rinci Alasan NO <span class="req">*</span></label>
        <textarea
          class="form-control"
          id="f-reason-detail"
          name="reason"
          rows={3}
          placeholder="Jelaskan alasan detail mitra tidak sepakat (contoh: Klien mengalihkan anggaran ke media sosial, atau anggaran APBD telah terikat program lain)... Minimal 10 karakter."
          disabled={!isNoActive}
        >{v("reason")}</textarea>
        <span class="form-hint">Minimal 10 karakter agar dapat dianalisis tim pimpinan</span>
        <FormError message={errors.reason} />
      </div>
    </div>
  </div>
</div>

