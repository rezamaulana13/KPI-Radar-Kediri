---
import Badge from "./Badge.astro";
import { client, offer, employeeName, divisionName, employee, period } from "../../lib/data/store";
import { TYPE_LABEL, dateID, rupiah, num } from "../../lib/formatters";
const { activity: a } = Astro.props as { activity: any };
const o = employee(a.ownerId);
const c = client(a.clientId ?? offer(a.offerId)?.clientId);
---
<dl class="kv">
  <dt>ID</dt><dd class="mono">{a.id}</dd>
  <dt>Jenis</dt><dd>{TYPE_LABEL[a.type]}</dd>
  <dt>Tanggal</dt><dd>{dateID(a.date)} · {period(a.periodId)?.name}</dd>
  <dt>Pemilik aktivitas</dt><dd>{employeeName(a.ownerId)} ({divisionName(o?.divisionId)})</dd>
  <dt>Pencatat</dt><dd>{employeeName(a.createdBy)}{a.createdBy !== a.ownerId && " (menginput atas nama pemilik)"}</dd>
  <dt>Deskripsi</dt><dd>{a.description}</dd>
  {c && (<><dt>Client</dt><dd>{c.name} · {c.sector}</dd></>)}
  {a.offerId && (<><dt>Penawaran</dt><dd><a href={`/marketing/offers/${a.offerId}`}>{a.offerId}</a></dd></>)}
  {a.editionName && (<><dt>Edisi Koran</dt><dd><strong>{a.editionName}</strong></dd></>)}
  {a.source && (<><dt>Kanal Distribusi</dt><dd>{a.source}: <strong>{a.sourceName}</strong></dd></>)}
  {a.qty != null && (
    <>
      <dt>Eksemplar Dikirim</dt><dd>{num(a.qty)} eksemplar</dd>
      {a.returnQty != null && a.returnQty > 0 && (
        <>
          <dt>Eksemplar Retur</dt>
          <dd style="color: #dc2626; font-weight: 600;">
            {num(a.returnQty)} eksemplar
            <span style="font-size: 0.75rem; background: #fee2e2; color: #991b1b; padding: 0.15rem 0.5rem; border-radius: 999px; margin-left: 0.4rem;">
              {a.returnCondition === "layak_stok" ? "Layak Stok Gudang" : "Rusak / Afkir"}
            </span>
          </dd>
        </>
      )}
      {a.soldQty != null && (
        <>
          <dt>Eksemplar Terjual (Net)</dt>
          <dd style="color: #15803d; font-weight: 700;">
            {num(a.soldQty)} eksemplar
            {a.qty > 0 && <span style="font-size: 0.8rem; color: #64748b; font-weight: normal; margin-left: 0.4rem;">({Math.round((a.soldQty / a.qty) * 100)}% terjual)</span>}
          </dd>
        </>
      )}
    </>
  )}
  {a.value != null && (
    <>
      <dt>Total Komersial</dt>
      <dd>
        <strong>{rupiah(a.value)}</strong>
        {a.partnershipType && (
          <span style="font-size: 0.75rem; background: #e0f2fe; color: #0369a1; padding: 0.15rem 0.5rem; border-radius: 999px; margin-left: 0.5rem; text-transform: uppercase; font-weight: 700;">
            {a.partnershipType}
          </span>
        )}
      </dd>
      {a.cashValue != null && a.cashValue > 0 && (
        <>
          <dt>Porsi Kas Tunai</dt>
          <dd style="color: #15803d; font-weight: 600;">{rupiah(a.cashValue)}</dd>
        </>
      )}
      {a.barterValue != null && a.barterValue > 0 && (
        <>
          <dt>Porsi Nilai Barter</dt>
          <dd style="color: #b45309; font-weight: 600;">
            {rupiah(a.barterValue)}
            {a.barterType && <span style="font-size: 0.8rem; color: #64748b; font-weight: normal; margin-left: 0.35rem;">({a.barterType})</span>}
          </dd>
          {a.barterDesc && (
            <>
              <dt>Rincian Barter</dt>
              <dd style="color: #475569; font-style: italic;">{a.barterDesc}</dd>
            </>
          )}
        </>
      )}
    </>
  )}
  {a.progressType && (<><dt>Tipe progress</dt><dd>{a.progressType}</dd></>)}
  {a.potential && (<><dt>Potensi client</dt><dd>{a.potential}</dd></>)}
  {a.outcome && (<><dt>Hasil akhir</dt><dd><Badge status={a.outcome} /></dd></>)}
  {a.outcome === "no" && (<><dt>Alasan NO</dt><dd><strong>{a.reasonCategory}</strong>. {a.reason}</dd></>)}
  {a.proofUrl && (
    <>
      <dt>Berkas / Bukti Fisik</dt>
      <dd>
        <a
          href={a.proofUrl}
          target="_blank"
          rel="noopener noreferrer"
          style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.35rem 0.75rem; background: #f0f9ff; border: 1px solid #bae6fd; border-radius: 6px; color: #0284c7; font-weight: 600; text-decoration: none; font-size: 0.8125rem;"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
            <polyline points="10 9 9 9 8 9"/>
          </svg>
          <span>Buka Berkas Bukti Lapangan &rarr;</span>
        </a>
      </dd>
    </>
  )}
  <dt>Status</dt><dd><Badge status={a.status} /></dd>
</dl>
