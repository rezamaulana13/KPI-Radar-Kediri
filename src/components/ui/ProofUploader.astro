---
// Komponen Pengunggah Bukti Pendukung (Mendukung Pilih File, Pilih Folder, dan Tautan Cloud)
interface Props {
  id?: string;
  label?: string;
  hint?: string;
}

const {
  id = "proof",
  label = "Berkas / Bukti Fisik Lapangan",
  hint = "Unggah foto nota, dokumentasi penyerahan oplah, PDF proposal, scan MoU, atau berkas pendukung lainnya (Bisa pilih per file atau satu folder sekaligus).",
} = Astro.props;

const fileInputId = `file-input-${id}`;
const folderInputId = `folder-input-${id}`;
const proofUrlId = `proof-url-${id}`;
const statusBoxId = `upload-status-${id}`;
const driveToggleId = `drive-toggle-${id}`;
const driveWrapId = `drive-wrap-${id}`;
---

<div class="field proof-uploader-component" style="margin-bottom: 1.15rem;">
  <label class="form-label" style="font-weight: 600; display: flex; justify-content: space-between; align-items: center;">
    <span>{label}</span>
    <span style="font-size: 0.75rem; color: #64748b; font-weight: normal;">Opsional tapi dianjurkan</span>
  </label>

  <!-- Hidden input untuk menyimpan URL bukti yang dikirim ke server -->
  <input type="hidden" name="proofUrl" id={proofUrlId} value="" />

  <!-- Hidden File & Folder Inputs -->
  <input
    type="file"
    id={fileInputId}
    multiple
    accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.zip,.rar"
    style="display: none;"
  />
  <input
    type="file"
    id={folderInputId}
    webkitdirectory
    directory
    multiple
    style="display: none;"
  />

  <!-- Dropzone & Tombol Pilihan -->
  <div class="upload-dropzone" id={`dropzone-${id}`}>
    <div class="upload-btn-group">
      <button
        type="button"
        class="upload-picker-btn"
        onclick={`document.getElementById('${fileInputId}').click()`}
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
          <line x1="12" y1="18" x2="12" y2="12"/>
          <line x1="9" y1="15" x2="15" y2="15"/>
        </svg>
        <span>Pilih Berkas File</span>
      </button>

      <button
        type="button"
        class="upload-picker-btn btn-folder"
        onclick={`document.getElementById('${folderInputId}').click()`}
        title="Pilih seluruh folder foto/dokumen sekaligus"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"/>
          <line x1="12" y1="11" x2="12" y2="17"/>
          <line x1="9" y1="14" x2="15" y2="14"/>
        </svg>
        <span>Pilih Folder Bukti</span>
      </button>

      <button
        type="button"
        class="upload-picker-btn"
        id={driveToggleId}
        style="background: #f8fafc; border-style: dashed;"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
        </svg>
        <span>Input Link Drive</span>
      </button>
    </div>

    <!-- Area Input Tautan Cloud / Google Drive (Default Hidden) -->
    <div id={driveWrapId} style="display: none; margin: 0.6rem 0; text-align: left;">
      <div style="display: flex; gap: 0.4rem;">
        <input
          type="url"
          class="form-control"
          id={`drive-input-${id}`}
          placeholder="https://drive.google.com/... atau tautan Dropbox/Cloud"
          style="font-size: 0.8125rem;"
        />
        <button
          type="button"
          class="btn btn-secondary btn-sm"
          id={`drive-apply-${id}`}
        >
          Gunakan
        </button>
      </div>
      <span class="form-hint" style="font-size: 0.72rem;">Pastikan izin akses tautan disetel publik / siapa saja yang memiliki link.</span>
    </div>

    <div style="font-size: 0.75rem; color: #64748b; margin-top: 0.2rem;">
      Format yang didukung: JPG, PNG, WEBP, PDF, DOCX, XLSX (Maks. 25 MB per berkas)
    </div>

    <!-- Kotak Status Berkas yang Dipilih / Diunggah -->
    <div class="upload-status-box" id={statusBoxId}>
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
        <span style="font-weight: 700; color: #166534;" id={`status-title-${id}`}>Mengunggah berkas...</span>
        <button
          type="button"
          id={`btn-reset-${id}`}
          style="background: transparent; border: none; color: #94a3b8; font-size: 0.75rem; cursor: pointer; text-decoration: underline;"
        >
          Hapus / Ganti
        </button>
      </div>
      <div id={`status-desc-${id}`} style="color: #334155; word-break: break-all; font-size: 0.75rem;">
        Menyiapkan berkas...
      </div>
      <div id={`progress-bar-${id}`} style="margin-top: 0.4rem; height: 4px; background: #e2e8f0; border-radius: 999px; overflow: hidden; display: none;">
        <div id={`progress-fill-${id}`} style="height: 100%; width: 0%; background: #16a34a; transition: width 0.3s ease;"></div>
      </div>
    </div>
  </div>

  <span class="form-hint" style="font-size: 0.75rem; margin-top: 0.35rem; display: block;">{hint}</span>
</div>

<script is:inline define:vars={{ id, fileInputId, folderInputId, proofUrlId, statusBoxId, driveToggleId, driveWrapId }}>
  (function() {
    const fileInput = document.getElementById(fileInputId);
    const folderInput = document.getElementById(folderInputId);
    const proofUrlInput = document.getElementById(proofUrlId);
    const statusBox = document.getElementById(statusBoxId);
    const statusTitle = document.getElementById('status-title-' + id);
    const statusDesc = document.getElementById('status-desc-' + id);
    const progressBar = document.getElementById('progress-bar-' + id);
    const progressFill = document.getElementById('progress-fill-' + id);
    const btnReset = document.getElementById('btn-reset-' + id);
    const driveToggle = document.getElementById(driveToggleId);
    const driveWrap = document.getElementById(driveWrapId);
    const driveInput = document.getElementById('drive-input-' + id);
    const driveApply = document.getElementById('drive-apply-' + id);

    // Toggle Input Drive
    driveToggle?.addEventListener('click', () => {
      if (!driveWrap) return;
      driveWrap.style.display = driveWrap.style.display === 'none' ? 'block' : 'none';
      if (driveWrap.style.display === 'block') driveInput?.focus();
    });

    driveApply?.addEventListener('click', () => {
      const val = driveInput?.value.trim();
      if (!val) return;
      if (proofUrlInput) proofUrlInput.value = val;
      if (statusBox) statusBox.style.display = 'block';
      if (statusTitle) {
        statusTitle.textContent = 'Tautan Cloud Berhasil Diterapkan';
        statusTitle.style.color = '#166534';
      }
      if (statusDesc) {
        statusDesc.innerHTML = `<a href="${val}" target="_blank" style="color:#0369a1;text-decoration:underline;">${val}</a>`;
      }
      if (progressBar) progressBar.style.display = 'none';
    });

    async function handleUpload(files, isFolder = false) {
      if (!files || files.length === 0) return;

      if (statusBox) statusBox.style.display = 'block';
      if (progressBar) progressBar.style.display = 'block';
      if (progressFill) progressFill.style.width = '30%';

      const fileCount = files.length;
      const sampleNames = Array.from(files).slice(0, 3).map(f => f.name).join(', ');
      const extraCount = fileCount > 3 ? ` dan ${fileCount - 3} berkas lainnya` : '';

      if (statusTitle) {
        statusTitle.textContent = isFolder 
          ? `Mengunggah Folder (${fileCount} berkas)...`
          : `Mengunggah ${fileCount} berkas...`;
        statusTitle.style.color = '#0284c7';
      }
      if (statusDesc) {
        statusDesc.textContent = `${sampleNames}${extraCount}`;
      }

      try {
        const fd = new FormData();
        for (let i = 0; i < files.length; i++) {
          fd.append('files', files[i]);
        }

        if (progressFill) progressFill.style.width = '60%';

        const res = await fetch('/api/upload', {
          method: 'POST',
          body: fd,
        });

        const data = await res.json();
        if (progressFill) progressFill.style.width = '100%';

        if (res.ok && data.ok) {
          if (proofUrlInput) proofUrlInput.value = data.url;
          if (statusTitle) {
            statusTitle.textContent = isFolder 
              ? `Folder Berhasil Diunggah (${data.count} berkas)`
              : `${data.count} Berkas Berhasil Diunggah`;
            statusTitle.style.color = '#166534';
          }
          if (statusDesc) {
            statusDesc.innerHTML = `<span style="color:#15803d;font-weight:600;">Tersimpan di Cloud Storage:</span> <a href="${data.url}" target="_blank" style="color:#0284c7;text-decoration:underline;">Lihat Berkas &rarr;</a>`;
          }
        } else {
          // Fallback lokal jika ada gangguan jaringan
          if (proofUrlInput) proofUrlInput.value = `file://${files[0].name}`;
          if (statusTitle) {
            statusTitle.textContent = `${fileCount} Berkas Terpilih`;
            statusTitle.style.color = '#166534';
          }
          if (statusDesc) {
            statusDesc.textContent = `${sampleNames}${extraCount} (Siap diajukan)`;
          }
        }
      } catch (e) {
        // Fallback offline
        if (proofUrlInput) proofUrlInput.value = `file://${files[0].name}`;
        if (statusTitle) {
          statusTitle.textContent = `${fileCount} Berkas Terpilih (Mode Cepat)`;
          statusTitle.style.color = '#166534';
        }
        if (statusDesc) {
          statusDesc.textContent = `${sampleNames}${extraCount} (Siap diajukan ke HRD)`;
        }
      } finally {
        setTimeout(() => {
          if (progressBar) progressBar.style.display = 'none';
        }, 800);
      }
    }

    fileInput?.addEventListener('change', (e) => {
      const files = e.target.files;
      if (files && files.length > 0) handleUpload(files, false);
    });

    folderInput?.addEventListener('change', (e) => {
      const files = e.target.files;
      if (files && files.length > 0) handleUpload(files, true);
    });

    btnReset?.addEventListener('click', () => {
      if (fileInput) fileInput.value = '';
      if (folderInput) folderInput.value = '';
      if (proofUrlInput) proofUrlInput.value = '';
      if (statusBox) statusBox.style.display = 'none';
      if (driveInput) driveInput.value = '';
    });
  })();
</script>
