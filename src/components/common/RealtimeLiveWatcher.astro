---
// Realtime Live Watcher: Memantau pengajuan aktivitas baru & hasil verifikasi secara otomatis
interface Props {
  role?: string;
  userId?: string;
}

const { role = "employee", userId = "" } = Astro.props;
---

<div id="rk-realtime-toast-container" class="rk-toast-container" aria-live="polite"></div>

<script is:inline define:vars={{ role, userId }}>
  (function () {
    // Hindari multi-inisialisasi
    if (window.__rk_watcher_initialized) return;
    window.__rk_watcher_initialized = true;

    let prevState = {
      pendingCount: null,
      latestActId: null,
      latestVerifId: null,
      init: false,
    };

    function showToast(title, message, tone = "info", duration = 6000) {
      const container = document.getElementById("rk-realtime-toast-container");
      if (!container) return;

      const toast = document.createElement("div");
      toast.className = `rk-toast rk-toast-${tone}`;
      toast.innerHTML = `
        <div class="rk-toast-icon">
          ${
            tone === "success"
              ? '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>'
              : tone === "warning"
              ? '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>'
              : '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>'
          }
        </div>
        <div class="rk-toast-body">
          <div class="rk-toast-title">${title}</div>
          <div class="rk-toast-desc">${message}</div>
        </div>
        <button type="button" class="rk-toast-close" aria-label="Tutup">&times;</button>
      `;

      toast.querySelector(".rk-toast-close")?.addEventListener("click", () => {
        toast.remove();
      });

      container.appendChild(toast);

      // Mainkan suara notifikasi halus jika browser mengizinkan
      try {
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.type = "sine";
        osc.frequency.setValueAtTime(587.33, audioCtx.currentTime); // D5
        osc.frequency.setValueAtTime(880.0, audioCtx.currentTime + 0.1); // A5
        gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.35);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.35);
      } catch (e) {
        // Abaikan jika audio dibatasi oleh browser policy
      }

      setTimeout(() => {
        toast.classList.add("rk-toast-hide");
        setTimeout(() => toast.remove(), 400);
      }, duration);
    }

    async function checkLiveSync() {
      try {
        const res = await fetch("/api/realtime/live-sync?_t=" + Date.now(), {
          headers: { "Cache-Control": "no-cache" },
        });
        if (!res.ok) return;
        const data = await res.json();
        if (!data.ok) return;

        // Inisialisasi awal saat pertama kali buka halaman
        if (!prevState.init) {
          prevState.pendingCount = data.pendingCount;
          prevState.latestActId = data.latestActivity?.id || null;
          prevState.latestVerifId = data.latestVerification?.id || null;
          prevState.init = true;
          return;
        }

        const isHRDOrAdmin = role === "admin" || role === "hrd";
        const isCurrentVerifPage = window.location.pathname.startsWith("/hrd/verifications");
        const isCurrentAktivitasPage = window.location.pathname.startsWith("/aktivitas-saya");

        // 1. CEK UNTUK HRD / SUPER ADMIN: Ada pengajuan aktivitas baru dari karyawan
        if (isHRDOrAdmin) {
          const hasNewPending = data.pendingCount > (prevState.pendingCount ?? 0);
          const hasNewActivity = data.latestActivity && data.latestActivity.id !== prevState.latestActId;

          if (hasNewPending || (hasNewActivity && data.latestActivity.status === "pending")) {
            const act = data.latestActivity;
            showToast(
              "Pengajuan Baru Masuk!",
              `<strong>${act.createdByName || act.ownerName}</strong> baru saja mengajukan laporan <strong>${act.type.toUpperCase()}</strong> (${act.id}).`,
              "info",
              7000
            );

            // Update badge antrean di sidebar secara instan jika elemennya ada
            const badgePending = document.querySelector(".nav-badge-pending, [data-badge-pending]");
            if (badgePending) {
              badgePending.textContent = String(data.pendingCount);
            }

            // Jika HRD sedang berada di halaman antrean verifikasi, lakukan refresh otomatis!
            if (isCurrentVerifPage && !document.querySelector("dialog[open]")) {
              showToast("Memperbarui Data...", "Tabel antrean diperbarui otomatis dengan data terbaru.", "success", 3000);
              setTimeout(() => {
                window.location.reload();
              }, 1200);
            }
          }
        }

        // 2. CEK UNTUK KARYAWAN: Ada keputusan verifikasi dari HRD
        if (!isHRDOrAdmin && data.latestVerification && data.latestVerification.id !== prevState.latestVerifId) {
          const v = data.latestVerification;
          const statusText = v.status === "approved" ? "DISETUJUI" : v.status === "revision" ? "DIMINTA REVISI" : "DITOLAK";
          const tone = v.status === "approved" ? "success" : v.status === "revision" ? "warning" : "danger";

          showToast(
            `Status Berkas: ${statusText}`,
            `Berkas <strong>${v.activityId}</strong> telah diperiksa oleh ${v.byName}. Catatan: ${v.note}`,
            tone,
            8000
          );

          // Jika karyawan sedang membuka halaman rapor/aktivitas saya, reload otomatis agar progres bertambah!
          if (isCurrentAktivitasPage && !document.querySelector("dialog[open]")) {
            setTimeout(() => {
              window.location.reload();
            }, 1500);
          }
        }

        // Update state lokal
        prevState.pendingCount = data.pendingCount;
        prevState.latestActId = data.latestActivity?.id || null;
        prevState.latestVerifId = data.latestVerification?.id || null;
      } catch (err) {
        // Background polling silent fail (tidak mengganggu UX user)
      }
    }

    // Jalankan polling setiap 5 detik
    const pollInterval = setInterval(checkLiveSync, 5000);

    // Jalankan juga saat tab kembali aktif (focus)
    window.addEventListener("focus", checkLiveSync);

    document.addEventListener("astro:before-swap", () => {
      clearInterval(pollInterval);
      window.removeEventListener("focus", checkLiveSync);
      window.__rk_watcher_initialized = false;
    });
  })();
</script>

<style is:global>
  .rk-toast-container {
    position: fixed;
    top: 1.25rem;
    right: 1.25rem;
    z-index: 999999;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 24rem;
    width: calc(100vw - 2.5rem);
    pointer-events: none;
  }

  .rk-toast {
    pointer-events: auto;
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background: #ffffff;
    border-radius: 10px;
    padding: 0.9rem 1.15rem;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.15), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
    border: 1px solid #e2e8f0;
    animation: rkToastSlideIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    transition: all 0.3s ease;
  }

  .rk-toast-hide {
    opacity: 0;
    transform: translateX(100%);
  }

  @keyframes rkToastSlideIn {
    from {
      opacity: 0;
      transform: translateX(100%) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateX(0) scale(1);
    }
  }

  .rk-toast-info {
    border-left: 4px solid #0284c7;
  }
  .rk-toast-info .rk-toast-icon {
    color: #0284c7;
    background: #e0f2fe;
  }

  .rk-toast-success {
    border-left: 4px solid #10b981;
  }
  .rk-toast-success .rk-toast-icon {
    color: #10b981;
    background: #d1fae5;
  }

  .rk-toast-warning {
    border-left: 4px solid #f59e0b;
  }
  .rk-toast-warning .rk-toast-icon {
    color: #f59e0b;
    background: #fef3c7;
  }

  .rk-toast-danger {
    border-left: 4px solid #ef4444;
  }
  .rk-toast-danger .rk-toast-icon {
    color: #ef4444;
    background: #fee2e2;
  }

  .rk-toast-icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .rk-toast-body {
    flex: 1;
    min-width: 0;
  }

  .rk-toast-title {
    font-size: 0.875rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 0.2rem;
    line-height: 1.25;
  }

  .rk-toast-desc {
    font-size: 0.8rem;
    color: #475569;
    line-height: 1.4;
  }

  .rk-toast-close {
    background: transparent;
    border: none;
    color: #94a3b8;
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    padding: 0 0.25rem;
  }
  .rk-toast-close:hover {
    color: #0f172a;
  }
</style>
