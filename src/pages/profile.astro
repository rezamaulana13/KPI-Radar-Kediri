---
import DashboardLayout from "../layouts/DashboardLayout.astro";
import PublicLayout from "../layouts/PublicLayout.astro";
import PageHeader from "../components/layout/PageHeader.astro";
import Alert from "../components/ui/Alert.astro";
import Icon from "../components/ui/Icon.astro";
import PeriodFilter from "../components/ui/PeriodFilter.astro";
import { db, activePeriod, activitiesFor, employee, employeeName, divisionName, positionName, positions } from "../lib/data/store";
import { achievements } from "../features/kpi/achievements";
import { selectedPeriod } from "../lib/utils/period";
import { ROLE_LABEL, dateTimeID, rupiah, num, pct, dateID, initials } from "../lib/formatters";

const u = Astro.locals.user!;
const e = employee(u.id)!;
const info = Astro.url.searchParams.get("info");
const error = Astro.url.searchParams.get("error");
const Layout = u.role === "employee" ? PublicLayout : DashboardLayout;

const p = selectedPeriod(Astro.url);

// Pastikan karyawan memiliki target individual standar jika belum diset manual oleh HRD
if (u.role === "employee") {
  const existingUserTargets = db.targets.filter((t) => t.employeeId === u.id && t.periodId === p.id);
  const userActs = db.activities.filter((a) => a.ownerId === u.id && a.periodId === p.id);
  const hasOplah = e.positionId === "POS-OPL" || userActs.some((a) => a.type === "oplah");
  const hasMarketing = e.positionId === "POS-EXM" || userActs.some((a) => a.type === "offer" || a.type === "client" || a.type === "outcome");

  if (existingUserTargets.length === 0) {
    if (hasOplah && !hasMarketing) {
      // Khusus Staf Sirkulasi & Oplah
      db.targets.push(
        { id: `TG-IND-${u.id.slice(0, 4)}-1`, indicatorId: "IND-01", periodId: p.id, scope: "individual", employeeId: u.id, value: 500 },
        { id: `TG-IND-${u.id.slice(0, 4)}-4`, indicatorId: "IND-08", periodId: p.id, scope: "individual", employeeId: u.id, value: 15 }
      );
    } else if (hasOplah && hasMarketing) {
      // Staf Operasional Gabungan (Sirkulasi + Iklan)
      db.targets.push(
        { id: `TG-IND-${u.id.slice(0, 4)}-1`, indicatorId: "IND-01", periodId: p.id, scope: "individual", employeeId: u.id, value: 500 },
        { id: `TG-IND-${u.id.slice(0, 4)}-2`, indicatorId: "IND-03", periodId: p.id, scope: "individual", employeeId: u.id, value: 10 },
        { id: `TG-IND-${u.id.slice(0, 4)}-3`, indicatorId: "IND-04", periodId: p.id, scope: "individual", employeeId: u.id, value: 3 },
        { id: `TG-IND-${u.id.slice(0, 4)}-4`, indicatorId: "IND-08", periodId: p.id, scope: "individual", employeeId: u.id, value: 15 }
      );
    } else {
      // Staf Account Executive / Iklan
      db.targets.push(
        { id: `TG-IND-${u.id.slice(0, 4)}-1`, indicatorId: "IND-02", periodId: p.id, scope: "individual", employeeId: u.id, value: 10 },
        { id: `TG-IND-${u.id.slice(0, 4)}-2`, indicatorId: "IND-03", periodId: p.id, scope: "individual", employeeId: u.id, value: 15 },
        { id: `TG-IND-${u.id.slice(0, 4)}-3`, indicatorId: "IND-04", periodId: p.id, scope: "individual", employeeId: u.id, value: 5 },
        { id: `TG-IND-${u.id.slice(0, 4)}-4`, indicatorId: "IND-08", periodId: p.id, scope: "individual", employeeId: u.id, value: 20 }
      );
    }
  } else {
    // Jika target sudah diset oleh HRD, tapi staf punya aktivitas sirkulasi dan belum ada target IND-01:
    if (hasOplah && !existingUserTargets.some((t) => t.indicatorId === "IND-01")) {
      db.targets.push({
        id: `TG-IND-${u.id.slice(0, 4)}-OPL`,
        indicatorId: "IND-01",
        periodId: p.id,
        scope: "individual",
        employeeId: u.id,
        value: 500,
      });
    }
  }
}

// Data Target Capaian KPI
const allRows = achievements(p.id);
const myTargets = allRows.filter((r) => r.target.scope === "individual" && r.target.employeeId === u.id);
const divTargets = allRows.filter((r) => r.target.scope === "division" && (r.target.divisionId === e.divisionId || r.target.divisionId === "DIV-MKT"));

// Data Aktivitas Lapangan Karyawan
const acts = activitiesFor({ id: u.id, role: u.role }).filter((a) => a.periodId === p.id);
const approvedActs = acts.filter((a) => a.status === "approved");

// Hitung Indeks Kinerja Terbobot (Rata-rata Capaian Target Individu)
const measurable = myTargets.filter((r) => r.percent != null);
const avgPercent = measurable.length ? Math.round(measurable.reduce((s, r) => s + Math.min(r.percent!, 100), 0) / measurable.length) : 0;

// Penetapan Predikat Evaluasi Kinerja
let predikat = {
  grade: "D",
  label: "Kurang",
  color: "#ef4444",
  badgeBg: "#fee2e2",
  badgeColor: "#991b1b",
  desc: "Capaian target kinerja di bawah 55%. Diperlukan percepatan penutupan deal atau perluasan sebaran sirkulasi.",
};
if (avgPercent >= 85) {
  predikat = {
    grade: "A",
    label: "Sangat Baik",
    color: "#10b981",
    badgeBg: "#d1fae5",
    badgeColor: "#065f46",
    desc: "Performa luar biasa! Konsistensi dan kontribusi operasional melampaui standar target periode ini.",
  };
} else if (avgPercent >= 70) {
  predikat = {
    grade: "B",
    label: "Baik",
    color: "#0284c7",
    badgeBg: "#e0f2fe",
    badgeColor: "#075985",
    desc: "Kinerja stabil dan memenuhi seluruh standar target operasional utama divisi.",
  };
} else if (avgPercent >= 55) {
  predikat = {
    grade: "C",
    label: "Cukup",
    color: "#f59e0b",
    badgeBg: "#fef3c7",
    badgeColor: "#92400e",
    desc: "Sebagian target telah tercapai, optimalkan follow-up proposal penawaran untuk meningkatkan skor.",
  };
}

// 4 Metrik Operasional SIMOKP Karyawan
const userCash = approvedActs
  .filter((a) => a.type === "outcome" && a.outcome === "deal")
  .reduce((s, a) => s + (a.cashValue != null ? a.cashValue : (a.value || 0)), 0);

const userBarter = approvedActs
  .filter((a) => (a.type === "outcome" && a.outcome === "deal" && (a.barterValue || 0) > 0) || a.type === "program")
  .reduce((s, a) => s + (a.barterValue != null ? a.barterValue : 0), 0);

const userSentOplah = approvedActs
  .filter((a) => a.type === "oplah")
  .reduce((s, a) => s + (a.qty || 0), 0);
const userReturnOplah = approvedActs
  .filter((a) => a.type === "oplah")
  .reduce((s, a) => s + (a.returnQty || 0), 0);
const userSoldOplah = approvedActs
  .filter((a) => a.type === "oplah")
  .reduce((s, a) => s + (a.soldQty != null ? a.soldQty : Math.max(0, (a.qty || 0) - (a.returnQty || 0))), 0);
const userReturnRate = userSentOplah > 0 ? ((userReturnOplah / userSentOplah) * 100).toFixed(1) : "0.0";

const formatVal = (val: number | null | undefined, unit: string) => {
  if (val == null) return "—";
  if (unit === "Rp" || unit.toLowerCase().includes("rupiah")) return rupiah(val);
  return `${num(val)} ${unit}`;
};
---

<Layout title="Profil & Capaian Kinerja">
  <div class={u.role === "employee" ? "pub-page-container" : ""}>
    {/* Breadcrumb untuk mode Karyawan */}
    {u.role === "employee" ? (
      <nav class="pub-breadcrumb no-print" aria-label="Breadcrumb">
        <a href="/">Beranda</a>
        <span class="sep">/</span>
        <span class="current">Profil &amp; Capaian Kinerja</span>
      </nav>
    ) : (
      <PageHeader title="Profil Saya" description="Data akun dan penempatan operasional Divisi Pemasaran Radar Kediri." crumbs={[]} />
    )}

    {info && <Alert tone="success" title="Informasi Akun">{info}</Alert>}
    {error && <Alert tone="danger" title="Terjadi Kendala">{error}</Alert>}

    {/* KARTU PROFIL UTAMA (Hero Profile Banner) */}
    <section class="card profile-hero-card">
      <div class="profile-hero-inner">
        <div class="profile-avatar-wrap">
          <div class="profile-avatar-large" aria-hidden="true">
            {initials(e.name)}
          </div>
        </div>
        <div class="profile-hero-content">
          <div class="profile-tags-row">
            <span class="status-pill status-pill-active">Akun Aktif</span>
            <span class="badge badge-neutral">{ROLE_LABEL[u.role]}</span>
            <span class="badge badge-primary">{p.name}</span>
          </div>
          <h1 class="profile-name-title">{e.name}</h1>
          <p class="profile-sub-text">
            {positionName(e.positionId)} &bull; {divisionName(e.divisionId)} &bull; <span class="mono">NIP: {e.nip}</span>
          </p>
        </div>

        {/* Tombol Aksi Rapor / Export */}
        <div class="profile-hero-actions no-print">
          <PeriodFilter />
          <button type="button" class="btn btn-secondary btn-sm" onclick="window.print()" title="Cetak Rapor Kinerja">
            <Icon name="printer" size={15} />
            <span>Cetak</span>
          </button>
          <a href={`/api/export/excel?type=${u.role === "employee" ? "employee" : "hrd"}&period=${p.id}`} class="btn btn-primary btn-sm" download title="Unduh Rekapitulasi Excel">
            <Icon name="download" size={15} />
            <span>Unduh Excel</span>
          </a>
        </div>
      </div>
    </section>

    {/* BAGIAN 1: CAPAIAN TARGET & EVALUASI KINERJA (KPI) */}
    <div id="kpi" style="margin-top: 1.5rem;">
      <div class="section-title-wrap">
        <div>
          <h2 class="section-main-title">Rapor Capaian Target &amp; Kinerja KPI</h2>
          <p class="section-sub-title">Realisasi operasional periode <strong>{p.name}</strong> yang telah diverifikasi dan disetujui HRD.</p>
        </div>
        <div class="no-print">
          <a href="/modul-marketing" class="btn btn-secondary btn-sm">
            <Icon name="plus" size={14} />
            <span>Input via Modul</span>
          </a>
        </div>
      </div>

      <!-- Skor KPI & 4 Metrik Operasional Utama -->
      <div class="kpi-score-overview">
        <!-- Panel Indeks Prestasi KPI -->
        <div class="kpi-grade-box">
          <div class="grade-circle" style={`border-color: ${predikat.color};`}>
            <span class="grade-pct" style={`color: ${predikat.color};`}>{avgPercent}%</span>
            <span class="grade-caption">Rata-rata Target</span>
          </div>
          <div class="grade-info">
            <div class="grade-badge" style={`background-color: ${predikat.badgeBg}; color: ${predikat.badgeColor};`}>
              Predikat: {predikat.label} ({predikat.grade})
            </div>
            <p class="grade-desc">{predikat.desc}</p>
          </div>
        </div>

        <!-- 4 Kotak Metrik SIMOKP -->
        <div class="kpi-metrics-grid">
          <div class="kpi-metric-card tone-kas">
            <div class="metric-head">
              <span class="metric-label">Omzet Kas Tunai</span>
              <span class="metric-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              </span>
            </div>
            <div class="metric-value">{rupiah(userCash)}</div>
            <div class="metric-note">Penerimaan kas riil deal iklan</div>
          </div>

          <div class="kpi-metric-card tone-barter">
            <div class="metric-head">
              <span class="metric-label">Realisasi Barter</span>
              <span class="metric-icon">
                <Icon name="handshake" size={15} />
              </span>
            </div>
            <div class="metric-value">{rupiah(userBarter)}</div>
            <div class="metric-note">Barang/jasa promosi non-tunai</div>
          </div>

          <div class="kpi-metric-card tone-oplah">
            <div class="metric-head">
              <span class="metric-label">Oplah Bersih Terjual</span>
              <span class="metric-icon">
                <Icon name="news" size={15} />
              </span>
            </div>
            <div class="metric-value">{num(userSoldOplah)} <small style="font-size:0.8rem;font-weight:600;">Eks</small></div>
            <div class="metric-note">Sirkulasi terverifikasi bersih</div>
          </div>

          <div class="kpi-metric-card tone-retur">
            <div class="metric-head">
              <span class="metric-label">Rasio Retur Koran</span>
              <span class="metric-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></svg>
              </span>
            </div>
            <div class="metric-value">{userReturnRate}%</div>
            <div class="metric-note">{num(userReturnOplah)} retur / {num(userSentOplah)} kirim</div>
          </div>
        </div>
      </div>

      <!-- TABEL CAPAIAN TARGET INDIVIDU -->
      <section class="card target-table-card" style="margin-top: 1.25rem;">
        <div class="card-head" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem;">
          <div>
            <h3 style="font-size:1.05rem; margin:0; font-weight:700;">Rincian Target Kinerja Individu</h3>
            <p class="muted text-xs" style="margin:0.2rem 0 0;">Daftar sasaran kerja yang ditetapkan HRD untuk periode {p.name}</p>
          </div>
          <span class="text-xs muted">{myTargets.length} Indikator Terpantau</span>
        </div>

        <div class="table-responsive">
          <table class="target-table">
            <thead>
              <tr>
                <th style="width: 80px;">Kode</th>
                <th>Indikator Kinerja</th>
                <th style="width: 100px;">Satuan</th>
                <th style="width: 120px; text-align: right;">Target</th>
                <th style="width: 120px; text-align: right;">Realisasi</th>
                <th style="width: 200px;">Capaian (%)</th>
                <th style="width: 130px; text-align: center;">Status</th>
              </tr>
            </thead>
            <tbody>
              {myTargets.length === 0 ? (
                <tr>
                  <td colspan="7" style="text-align: center; padding: 2rem; color: var(--color-muted);">
                    Belum ada target khusus yang ditetapkan untuk periode ini.
                  </td>
                </tr>
              ) : (
                myTargets.map((r) => {
                  const pctVal = r.percent != null ? Math.round(r.percent) : 0;
                  const barWidth = Math.min(pctVal, 100);
                  const isSuccess = pctVal >= 100;
                  const isGood = pctVal >= 70;
                  const isWarning = pctVal >= 40;
                  const barColor = isSuccess ? "#10b981" : isGood ? "#0284c7" : isWarning ? "#f59e0b" : "#ef4444";
                  const statusLabel = isSuccess ? "Tercapai" : isGood ? "Progres Baik" : isWarning ? "Berjalan" : "Perlu Ditingkatkan";
                  const statusBadgeBg = isSuccess ? "#d1fae5" : isGood ? "#e0f2fe" : isWarning ? "#fef3c7" : "#fee2e2";
                  const statusBadgeColor = isSuccess ? "#065f46" : isGood ? "#075985" : isWarning ? "#92400e" : "#991b1b";

                  return (
                    <tr>
                      <td><span class="mono-code">{r.indicator.code}</span></td>
                      <td>
                        <div class="font-bold text-dark">{r.indicator.name}</div>
                        <div class="indicator-def">{r.indicator.definition || "Indikator standar marketing operasional"}</div>
                      </td>
                      <td><span class="badge-unit">{r.indicator.unit}</span></td>
                      <td style="text-align: right; font-weight: 600;">{formatVal(r.target.value, r.indicator.unit)}</td>
                      <td style="text-align: right; font-weight: 700; color: var(--color-primary-900);">
                        {formatVal(r.actual, r.indicator.unit)}
                      </td>
                      <td>
                        <div class="meter-wrapper">
                          <div class="meter-track">
                            <div class="meter-fill" style={`width: ${barWidth}%; background-color: ${barColor};`}></div>
                          </div>
                          <span class="meter-pct font-bold" style={`color: ${barColor};`}>{pctVal}%</span>
                        </div>
                      </td>
                      <td style="text-align: center;">
                        <span class="status-pill" style={`background-color: ${statusBadgeBg}; color: ${statusBadgeColor};`}>
                          {statusLabel}
                        </span>
                      </td>
                    </tr>
                  );
                })
              )}
            </tbody>
          </table>
        </div>
      </section>

      {/* TARGET BERSAMA DIVISI (Jika ada) */}
      {divTargets.length > 0 && (
        <section class="card target-table-card" style="margin-top: 1.25rem;">
          <div class="card-head">
            <h3 style="font-size:1.05rem; margin:0; font-weight:700;">Target Kolektif Divisi Pemasaran &amp; Sirkulasi</h3>
            <p class="muted text-xs" style="margin:0.2rem 0 0;">Capaian tim bersama yang memengaruhi kinerja korporat</p>
          </div>
          <div class="table-responsive">
            <table class="target-table">
              <thead>
                <tr>
                  <th style="width: 80px;">Kode</th>
                  <th>Sasaran Divisi</th>
                  <th style="width: 100px;">Satuan</th>
                  <th style="width: 130px; text-align: right;">Target Divisi</th>
                  <th style="width: 130px; text-align: right;">Realisasi Tim</th>
                  <th style="width: 200px;">Capaian (%)</th>
                </tr>
              </thead>
              <tbody>
                {divTargets.map((r) => {
                  const pctVal = r.percent != null ? Math.round(r.percent) : 0;
                  const barWidth = Math.min(pctVal, 100);
                  const barColor = pctVal >= 100 ? "#10b981" : pctVal >= 70 ? "#0284c7" : pctVal >= 40 ? "#f59e0b" : "#ef4444";
                  return (
                    <tr>
                      <td><span class="mono-code">{r.indicator.code}</span></td>
                      <td class="font-bold">{r.indicator.name}</td>
                      <td><span class="badge-unit">{r.indicator.unit}</span></td>
                      <td style="text-align: right; font-weight: 600;">{formatVal(r.target.value, r.indicator.unit)}</td>
                      <td style="text-align: right; font-weight: 700; color: var(--color-primary-900);">{formatVal(r.actual, r.indicator.unit)}</td>
                      <td>
                        <div class="meter-wrapper">
                          <div class="meter-track">
                            <div class="meter-fill" style={`width: ${barWidth}%; background-color: ${barColor};`}></div>
                          </div>
                          <span class="meter-pct font-bold" style={`color: ${barColor};`}>{pctVal}%</span>
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>
      )}
    </div>

    {/* BAGIAN 2: PENGATURAN PROFIL & DATA KEPEGAWAIAN RESMI */}
    <div style="margin-top: 2rem;">
      <div class="section-title-wrap">
        <div>
          <h2 class="section-main-title">Pengaturan Profil &amp; Data Kepegawaian</h2>
          <p class="section-sub-title">Perbarui nama lengkap, alamat email, atau kata sandi Anda. Data jabatan dan NIP dikunci untuk integritas sistem.</p>
        </div>
      </div>

      <div class="grid-profile-settings" style="margin-top: 1rem;">
        {/* Kolom Kiri: Formulir Edit Profil (Bisa Diubah: Nama, Email, Password) */}
        <section class="card edit-profile-card">
          <div class="card-head" style="display:flex; justify-content:space-between; align-items:center;">
            <div>
              <h3 style="font-size:1.05rem; margin:0; font-weight:700;">Ubah Data Profil &amp; Kata Sandi</h3>
              <p class="muted text-xs" style="margin:0.2rem 0 0;">Perubahan langsung tersimpan ke database dan diperbarui realtime di seluruh sistem.</p>
            </div>
            <span class="badge badge-info" style="font-size:0.75rem;">Dapat Diubah</span>
          </div>
          <div class="card-body">
            <form method="post" action="/api/profile/update" class="stack" style="gap: 1.15rem;">
              <div class="form-group">
                <label for="field-name" class="form-label font-bold text-sm">
                  Nama Lengkap <span style="color: #ef4444;">*</span>
                </label>
                <input
                  type="text"
                  id="field-name"
                  name="name"
                  value={e.name}
                  required
                  minlength="2"
                  class="form-control"
                  placeholder="Contoh: Nama Lengkap Anda"
                />
                <span class="text-xs muted" style="margin-top: 0.25rem; display: block;">
                  Nama resmi yang tercantum pada rapor KPI, kwitansi, dan verifikasi berkas.
                </span>
              </div>

              <div class="form-group">
                <label for="field-email" class="form-label font-bold text-sm">
                  Alamat Email Akun <span style="color: #ef4444;">*</span>
                </label>
                <input
                  type="email"
                  id="field-email"
                  name="email"
                  value={e.email}
                  required
                  class="form-control"
                  placeholder="nama@radarkediri.example"
                />
                <span class="text-xs muted" style="margin-top: 0.25rem; display: block;">
                  Email aktif yang digunakan untuk masuk ke sistem SIMOKP.
                </span>
              </div>

              <div class="divider-form">
                <span>Keamanan Kata Sandi</span>
              </div>

              <div class="form-row-2">
                <div class="form-group">
                  <label for="field-password" class="form-label font-bold text-sm">
                    Kata Sandi Baru (Opsional)
                  </label>
                  <input
                    type="password"
                    id="field-password"
                    name="password"
                    minlength="6"
                    class="form-control"
                    placeholder="Kosongkan jika tidak diubah"
                    autocomplete="new-password"
                  />
                  <span class="text-xs muted" style="margin-top: 0.25rem; display: block;">
                    Minimal 6 karakter.
                  </span>
                </div>

                <div class="form-group">
                  <label for="field-confirm" class="form-label font-bold text-sm">
                    Konfirmasi Kata Sandi Baru
                  </label>
                  <input
                    type="password"
                    id="field-confirm"
                    name="confirmPassword"
                    minlength="6"
                    class="form-control"
                    placeholder="Ketik ulang kata sandi baru"
                    autocomplete="new-password"
                  />
                  <span class="text-xs muted" style="margin-top: 0.25rem; display: block;">
                    Harus sama dengan sandi baru di samping.
                  </span>
                </div>
              </div>

              <div style="display:flex; justify-content:flex-end; gap:0.75rem; margin-top:0.5rem; padding-top:1rem; border-top:1px solid #e2e8f0;">
                <button type="submit" class="btn btn-primary" style="padding:0.6rem 1.4rem;">
                  <Icon name="check" size={16} />
                  <span>Simpan Perubahan Profil</span>
                </button>
              </div>
            </form>
          </div>
        </section>

