---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import PublicLayout from "../../layouts/PublicLayout.astro";
import ListPage from "../../components/ui/ListPage.astro";
import Alert from "../../components/ui/Alert.astro";
import ProofUploader from "../../components/ui/ProofUploader.astro";
import { db, employeeName, client, visibleEmployeeIds } from "../../lib/data/store";
import { takeFormState } from "../../lib/utils/flash";

const u = Astro.locals.user!;
const ids = visibleEmployeeIds(u);
const rows = db.activities
  .filter((a) => a.type === "profiling" && ids.includes(a.ownerId))
  .sort((a, b) => (b.date || "").localeCompare(a.date || "") || (b.id || "").localeCompare(a.id || "", undefined, { numeric: true }))
  .map((a) => ({
    ...a,
    owner: employeeName(a.ownerId),
    clientName: client(a.clientId)?.name || "—"
  }));

const created = Astro.url.searchParams.get("created");
const st = takeFormState(Astro.cookies, Astro.url);
const today = new Date().toLocaleDateString("sv-SE", { timeZone: "Asia/Jakarta" });
const clientList = db.clients.filter((c) => ids.includes(c.ownerId));
const availableClients = clientList.length > 0 ? clientList : db.clients;

const Layout = u.role === "employee" ? PublicLayout : DashboardLayout;
---

<Layout title="Riset Profiling Mitra">
  <div class={u.role === "employee" ? "pub-page-container" : ""}>
    {created && (
      <div style="margin-bottom: 1.25rem;">
        <Alert tone="success" title="Riset Profiling Berhasil Dicatat">
          Hasil riset profiling dengan ID <strong>{created}</strong> telah berhasil disimpan dan diteruskan ke antrean verifikasi HRD.
        </Alert>
      </div>
    )}
    {st.error && (
      <div style="margin-bottom: 1.25rem;">
        <Alert tone="danger" title="Gagal Menyimpan Riset">
          <div style="font-weight: 600; margin-bottom: 0.35rem;">{st.error}</div>
          {Object.keys(st.fields || {}).length > 0 && (
            <ul style="margin: 0.25rem 0 0 1.2rem; padding: 0; font-size: 0.85rem; line-height: 1.5;">
              {Object.entries(st.fields).map(([field, msg]) => (
                <li>
                  <strong>
                    {field === "description" ? "Hasil Riset / Deskripsi" : field === "clientId" ? "Mitra / Klien" : field === "date" ? "Tanggal" : field}:
                  </strong> {msg}
                </li>
              ))}
            </ul>
          )}
        </Alert>
      </div>
    )}

    <ListPage
      title="Riset Profiling Mitra"
      description="Hasil riset mendalam kebutuhan, potensi anggaran promosi, dan pemetaan stakeholder klien."
      crumbs={[{ label: "Modul Marketing", href: "/modul-marketing" }]}
      rows={rows}
      searchKeys={["clientName", "description", "owner"]}
      filters={[{ name: "potential", label: "Potensi", options: ["Tinggi", "Sedang", "Rendah"].map((s) => ({ value: s, label: s })) }]}
      columns={[
        { key: "date", label: "Tanggal Riset", type: "date" },
        { key: "clientName", label: "Mitra / Klien" },
        { key: "owner", label: "Riset Oleh" },
        { key: "potential", label: "Potensi Nilai" },
        { key: "description", label: "Hasil Analisis Riset" },
        { key: "status", label: "Status", type: "badge" }
      ]}
    >
      {u.role === "employee" && (
        <button
          slot="actions"
          type="button"
          class="btn btn-primary"
          onclick="document.getElementById('modal-input-profiling')?.showModal()"
        >
          + Catat Riset Profiling
        </button>
      )}
    </ListPage>

    <!-- Modal Pop-Up Dialog Input Profiling Baru -->
    <dialog id="modal-input-profiling" class="activity-modal">
      <div class="modal-content">
        <div class="modal-header">
          <div>
            <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.25rem;">
              <span style="font-size:0.7rem;font-weight:700;background:#eff6ff;color:#1d4ed8;padding:0.2rem 0.55rem;border-radius:999px;border:1px solid #bfdbfe;letter-spacing:0.04em;">IND-06 RISET PROFILING</span>
            </div>
            <h3 class="modal-title">Catat Riset Profiling Klien</h3>
            <p class="modal-subtitle">Indikator IND-06: Riset Profiling Mitra &amp; Analisis Kebutuhan Iklan</p>
          </div>
          <button type="button" class="modal-close" onclick="this.closest('dialog').close()" title="Tutup Pop-up">&times;</button>
        </div>
        <form method="post" action="/api/activities" style="display: flex; flex-direction: column; flex: 1; overflow: hidden; margin: 0;">
          <input type="hidden" name="type" value="profiling" />
          <input type="hidden" name="ownerId" value={u.id} />
          <input type="hidden" name="redirectTo" value="/marketing/profiling" />

          <div class="modal-body">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-bottom: 1rem;">
              <div class="field">
                <label class="form-label" for="prof-date">Tanggal Riset <span class="req">*</span></label>
                <input
                  type="date"
                  id="prof-date"
                  name="date"
                  class={`form-control ${st.fields?.date ? "is-invalid" : ""}`}
                  value={st.values?.date || today}
                  max={today}
                  required
                />
                {st.fields?.date && (
                  <span class="text-xs" style="color:#dc2626;font-weight:600;margin-top:0.25rem;display:block;">
                    {st.fields.date}
                  </span>
                )}
                <span class="form-hint">Tanggal observasi atau riset</span>
              </div>
              <div class="field">
                <label class="form-label" for="prof-client">Pilih Mitra / Klien <span class="req">*</span></label>
                <select
                  id="prof-client"
                  name="clientId"
                  class={`form-control ${st.fields?.clientId ? "is-invalid" : ""}`}
                  required
                >
                  <option value="">-- Pilih Klien Terdaftar --</option>
                  {availableClients.map((c) => (
                    <option value={c.id} selected={st.values?.clientId === c.id}>{c.name} ({c.city})</option>
                  ))}
                </select>
                {st.fields?.clientId && (
                  <span class="text-xs" style="color:#dc2626;font-weight:600;margin-top:0.25rem;display:block;">
                    {st.fields.clientId}
                  </span>
                )}
                <span class="form-hint">Mitra yang diriset (jika belum ada, daftarkan di menu Klien &amp; Mitra)</span>
              </div>
            </div>

            <div class="field" style="margin-bottom: 1rem;">
              <label class="form-label" for="prof-pot">Tingkat Potensi Kerja Sama <span class="req">*</span></label>
              <select id="prof-pot" name="potential" class="form-control" required>
                <option value="Tinggi" selected={st.values?.potential === "Tinggi"}>Tinggi (Anggaran Besar / Momentum Dekat)</option>
                <option value="Sedang" selected={st.values?.potential === "Sedang" || !st.values?.potential}>Sedang (Anggaran Reguler)</option>
                <option value="Rendah" selected={st.values?.potential === "Rendah"}>Rendah (Eksplorasi Awal)</option>
              </select>
              <span class="form-hint">Klasifikasi peluang kesepakatan komersial</span>
            </div>

            <div class="field" style="margin-bottom: 1rem;">
              <label class="form-label" for="prof-desc">Hasil Riset &amp; Rekomendasi Pendekatan <span class="req">*</span></label>
              <textarea
                id="prof-desc"
                name="description"
                class={`form-control ${st.fields?.description ? "is-invalid" : ""}`}
                rows="3"
                placeholder="Rangkuman profil lembaga, pemegang keputusan anggaran, event terdekat yang bisa didanai, dan format pendekatan..."
                required
              >{st.values?.description || ""}</textarea>
              {st.fields?.description && (
                <span class="text-xs" style="color:#dc2626;font-weight:600;margin-top:0.25rem;display:block;">
                  {st.fields.description}
                </span>
              )}
              <span class="form-hint">Rincikan minimal 5 karakter agar dapat diverifikasi oleh HRD</span>
            </div>

            <!-- Upload File / Folder Bukti Riset -->
            <ProofUploader
              id="profiling"
              label="Dokumen Bahan Riset / Foto Bukti Observasi"
              hint="Unggah dokumen profil anggaran, kliping berita, foto audiensi awal, atau folder hasil riset."
              initialUrl={st.values?.proofUrl || ""}
            />
          </div>

          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" onclick="this.closest('dialog').close()">Batal</button>
            <button type="submit" class="btn btn-primary">Simpan Riset Profiling</button>
          </div>
        </form>
      </div>
    </dialog>
  </div>
</Layout>

<script is:inline>
  var urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('action') === 'new' || urlParams.get('retry') === '1') {
    var dlg = document.getElementById('modal-input-profiling');
    if (dlg && typeof dlg.showModal === 'function') dlg.showModal();
  }
</script>
