---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import PublicLayout from "../../layouts/PublicLayout.astro";
import ListPage from "../../components/ui/ListPage.astro";
import { db, employeeName, visibleEmployeeIds } from "../../lib/data/store";
const u = Astro.locals.user!;
const ids = visibleEmployeeIds(u);
const rows = db.clients.filter((c) => ids.includes(c.ownerId)).map((c) => ({ ...c, owner: employeeName(c.ownerId), offers: db.offers.filter((o) => o.clientId === c.id).length }));
const Layout = u.role === "employee" ? PublicLayout : DashboardLayout;
---
<Layout title="Database Klien">
  <div class={u.role === "employee" ? "pub-page-container" : ""}>
    <ListPage title="Database Klien &amp; Mitra" description="Daftar client instansi pemerintah (OPD), swasta, dan calon client Marketing." crumbs={[{ label: "Beranda", href: "/" }, { label: "Klien" }]} rows={rows} searchKeys={["name", "sector", "contact", "city"]}
      filters={[{ name: "sector", label: "Sektor", options: [...new Set(db.clients.map((c) => c.sector))].map((s) => ({ value: s, label: s })) }]}
      columns={[{ key: "name", label: "Client" }, { key: "sector", label: "Sektor" }, { key: "contact", label: "Kontak" }, { key: "phone", label: "Telepon", type: "mono" }, { key: "city", label: "Kota" }, { key: "owner", label: "Pemegang" }, { key: "offers", label: "Penawaran", type: "number" }]}>
      {u.role !== "hrd" && <a slot="actions" class="btn btn-primary" href="/catat-aktivitas?type=client">Tambah Klien</a>}
    </ListPage>
  </div>
</Layout>
