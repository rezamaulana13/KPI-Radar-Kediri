---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import PublicLayout from "../../layouts/PublicLayout.astro";
import ListPage from "../../components/ui/ListPage.astro";
import StatCard from "../../components/dashboard/StatCard.astro";
import Alert from "../../components/ui/Alert.astro";
import Icon from "../../components/ui/Icon.astro";
import ProofUploader from "../../components/ui/ProofUploader.astro";
import { db, employeeName, visibleEmployeeIds } from "../../lib/data/store";
import { num } from "../../lib/formatters";
import { oplahSources } from "../../lib/data/mock";
import { takeFormState } from "../../lib/utils/flash";

const u = Astro.locals.user!;
const ids = visibleEmployeeIds(u);
const all = db.activities
  .filter((a) => a.type === "oplah" && ids.includes(a.ownerId))
  .sort((a, b) => (b.date || "").localeCompare(a.date || "") || (b.id || "").localeCompare(a.id || "", undefined, { numeric: true }));

const rows = all.map((a) => {
  const returnQty = a.returnQty ?? 0;
  const soldQty = a.soldQty ?? Math.max(0, (a.qty ?? 0) - returnQty);
  return {
    ...a,
    owner: employeeName(a.ownerId),
    returnQty,
    soldQty,
    editionName: a.editionName || "—",
    sourceDetail: `${a.source || "Agen"}: ${a.sourceName || "—"}`,
  };
});

const totalSent = all.reduce((t, a) => t + (a.qty ?? 0), 0);
const totalReturn = all.reduce((t, a) => t + (a.returnQty ?? 0), 0);
const totalSold = all.reduce((t, a) => t + (a.soldQty ?? Math.max(0, (a.qty ?? 0) - (a.returnQty ?? 0))), 0);
const approvedSold = all.filter((a) => a.status === "approved").reduce((t, a) => t + (a.soldQty ?? Math.max(0, (a.qty ?? 0) - (a.returnQty ?? 0))), 0);
const pendingCount = all.filter((a) => a.status === "pending").length;
const returnRate = totalSent > 0 ? ((totalReturn / totalSent) * 100).toFixed(1) + "%" : "0%";

const created = Astro.url.searchParams.get("created");
const st = takeFormState(Astro.cookies, Astro.url);
const today = new Date().toLocaleDateString("sv-SE", { timeZone: "Asia/Jakarta" });

const Layout = u.role === "employee" ? PublicLayout : DashboardLayout;
---

<Layout title="Sirkulasi Oplah & Retur Koran">
  <div class={u.role === "employee" ? "pub-page-container" : ""}>
    {created && (
      <div style="margin-bottom: 1.25rem;">
        <Alert tone="success" title="Pencatatan Oplah Berhasil Disimpan">
          Laporan sirkulasi oplah dengan ID <strong>{created}</strong> telah berhasil diajukan dan sedang menunggu verifikasi HRD.
        </Alert>
      </div>
    )}
    {st.error && (
      <div style="margin-bottom: 1.25rem;">
        <Alert tone="danger" title="Gagal Menyimpan Oplah">
          <div style="font-weight: 600; margin-bottom: 0.35rem;">{st.error}</div>
          {Object.keys(st.fields || {}).length > 0 && (
            <ul style="margin: 0.25rem 0 0 1.2rem; padding: 0; font-size: 0.85rem; line-height: 1.5;">
              {Object.entries(st.fields).map(([field, msg]) => (
                <li>
                  <strong>
                    {field === "description" ? "Uraian Tugas / Catatan" : field === "qty" ? "Jumlah Dikirim" : field === "returnQty" ? "Retur Koran" : field === "sourceName" ? "Nama Sumber/Agen" : field}:
                  </strong> {msg}
                </li>
              ))}
            </ul>
          )}
        </Alert>
      </div>
    )}

    <ListPage
      title="Sirkulasi Oplah & Retur Koran"
      description="Monitoring siklus distribusi oplah harian, pencatatan koran retur, dan rekonsiliasi eksemplar terjual riil."
      crumbs={[{ label: "Modul Marketing", href: "/modul-marketing" }]}
      rows={rows}
      searchKeys={["sourceName", "owner", "editionName", "description"]}
      filters={[
        { name: "source", label: "Kanal", options: oplahSources.map((s) => ({ value: s, label: s })) },
        { name: "status", label: "Status", options: ["pending", "approved", "revision", "rejected"].map((s) => ({ value: s, label: { pending: "Menunggu verifikasi", approved: "Disetujui", revision: "Perlu revisi", rejected: "Ditolak" }[s]! })) }
      ]}
      columns={[
        { key: "date", label: "Tanggal", type: "date" },
        { key: "editionName", label: "Edisi Koran" },
        { key: "owner", label: "Staf Sirkulasi" },
        { key: "sourceDetail", label: "Kanal / Agen" },
        { key: "qty", label: "Dikirim", type: "number" },
        { key: "returnQty", label: "Retur", type: "number" },
        { key: "soldQty", label: "Terjual (Net)", type: "number" },
        { key: "status", label: "Status", type: "badge" }
      ]}
    >
      {u.role === "employee" && (
        <button
          slot="actions"
          type="button"
          class="btn btn-primary"
          onclick="document.getElementById('modal-input-oplah')?.showModal()"
        >
          + Catat Sirkulasi / Retur
        </button>
      )}

      <div slot="before" class="stat-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));">
        <StatCard label="Oplah Bersih Disetujui" value={num(approvedSold)} tone="ok" note="Eksemplar laku masuk KPI" />
        <StatCard label="Total Eksemplar Dikirim" value={num(totalSent)} note={`${all.length} transaksi distribusi`} />
        <StatCard label="Total Retur Koran" value={num(totalReturn)} tone={totalReturn > 0 ? "warn" : "ok"} note={`Rasio retur: ${returnRate}`} />
        <StatCard label="Menunggu Verifikasi" value={num(pendingCount)} tone={pendingCount > 0 ? "warn" : "ok"} note="Perlu validasi admin" />
      </div>
    </ListPage>

    <!-- Modal Pop-Up Dialog Input Oplah -->
    <dialog id="modal-input-oplah" class="activity-modal">
      <div class="modal-content">
        <div class="modal-header">
          <div>
            <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.25rem;">
              <span style="font-size:0.7rem;font-weight:700;background:#eff6ff;color:#1d4ed8;padding:0.2rem 0.55rem;border-radius:999px;border:1px solid #bfdbfe;letter-spacing:0.04em;">IND-01 SIRKULASI</span>
            </div>
            <h3 class="modal-title">Catat Sirkulasi &amp; Retur Koran</h3>
            <p class="modal-subtitle">Indikator IND-01: Eksemplar Bersih Terjual (Koran Terkirim &minus; Retur)</p>
          </div>
          <button type="button" class="modal-close" onclick="this.closest('dialog').close()" title="Tutup Pop-up">&times;</button>
        </div>
        <form method="post" action="/api/activities" style="display: flex; flex-direction: column; flex: 1; overflow: hidden; margin: 0;">
          <input type="hidden" name="type" value="oplah" />
          <input type="hidden" name="ownerId" value={u.id} />
          <input type="hidden" name="redirectTo" value="/marketing/oplah" />

          <div class="modal-body">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.15rem; margin-bottom: 1.15rem;">
              <div class="field">
                <label class="form-label" for="oplah-date">Tanggal Distribusi <span class="req">*</span></label>
                <input type="date" id="oplah-date" name="date" class="form-control" value={today} max={today} required />
                <span class="form-hint">Tanggal distribusi koran pagi</span>
              </div>
              <div class="field">
                <label class="form-label" for="oplah-edition">Edisi Koran</label>
                <input type="text" id="oplah-edition" name="editionName" class="form-control" placeholder="Contoh: Edisi Harian Radar Kediri" />
                <span class="form-hint">Nomor / nama edisi koran terbit</span>
              </div>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.15rem; margin-bottom: 1.15rem;">
              <div class="field">
                <label class="form-label" for="oplah-source">Kanal Distribusi <span class="req">*</span></label>
                <select id="oplah-source" name="source" class="form-control" required>
                  <option value="">-- Pilih Kanal Distribusi --</option>
                  {oplahSources.map((s) => <option value={s}>{s}</option>)}
                </select>
                <span class="form-hint">Jalur peredaran / agen</span>
              </div>
              <div class="field">
                <label class="form-label" for="oplah-sourceName">Nama Agen / Mitra Penerima <span class="req">*</span></label>
                <input type="text" id="oplah-sourceName" name="sourceName" class="form-control" placeholder="Contoh: Agen Sumber Rejeki Kediri" required />
                <span class="form-hint">Entitas penerima distribusi</span>
              </div>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1.15rem; margin-bottom: 1.15rem;">
              <div class="field">
                <label class="form-label" for="oplah-qty">Eksemplar Dikirim <span class="req">*</span></label>
                <input type="number" id="oplah-qty" name="qty" class="form-control" min="1" step="1" placeholder="150" required />
                <span class="form-hint">Total eksemplar yang dikirim</span>
              </div>
              <div class="field">
                <label class="form-label" for="oplah-returnQty">Eksemplar Retur</label>
                <input type="number" id="oplah-returnQty" name="returnQty" class="form-control" min="0" step="1" value="0" />
                <span class="form-hint">Retur koran tidak laku</span>
              </div>
              <div class="field">
                <label class="form-label" for="oplah-returnCond">Kondisi Retur</label>
                <select id="oplah-returnCond" name="returnCondition" class="form-control">
                  <option value="layak_stok">Layak Stok</option>
                  <option value="rusak">Rusak / Afkir</option>
                </select>
                <span class="form-hint">Kelayakan simpan koran</span>
              </div>
            </div>

            <!-- Live Rekonsiliasi Card (Luxury Upgrade) -->
            <div style="background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%); border: 1.5px solid #a7f3d0; border-radius: 12px; padding: 0.95rem 1.25rem; margin-bottom: 1.15rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; box-shadow: 0 2px 6px rgba(16, 185, 129, 0.08);">
              <div>
                <span style="font-size: 0.725rem; font-weight: 700; color: #166534; text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 0.2rem;">Estimasi Bersih Laku Terjual:</span>
                <div style="font-size: 1.45rem; font-weight: 800; color: #14532d; line-height: 1.1;" id="oplah-calc-display">0 eksemplar</div>
              </div>
              <div style="display: flex; align-items: center; gap: 0.4rem; background: #ffffff; padding: 0.35rem 0.75rem; border-radius: 999px; border: 1px solid #bbf7d0; font-size: 0.75rem; color: #15803d; font-weight: 700;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>Masuk Perhitungan Target KPI</span>
              </div>
            </div>

            <div class="field" style="margin-bottom: 1rem;">
              <label class="form-label" for="oplah-desc">Deskripsi Laporan Lapangan <span class="req">*</span></label>
              <textarea id="oplah-desc" name="description" class="form-control" rows="3" placeholder="Rincian proses pengiriman, titik temu agen, dan kendala lapangan (minimal 10 karakter)..." required></textarea>
              <span class="form-hint">Jelaskan kegiatan distribusi lapangan secara ringkas dan faktual</span>
            </div>

            <!-- Upload File / Folder Bukti Pendukung -->
            <ProofUploader
              id="oplah"
              label="Foto Bukti Distribusi / Nota Agen / Retur"
              hint="Unggah foto nota penerimaan agen, foto loper di titik temu, atau satu folder foto sirkulasi koran."
            />
          </div>

          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" onclick="this.closest('dialog').close()">Batal</button>
            <button type="submit" class="btn btn-primary">Simpan &amp; Ajukan ke HRD</button>
          </div>
        </form>
      </div>
    </dialog>

    <!-- Pop-Up Modal Sukses Pengajuan Oplah (Tengah Halaman, Simple & Modern) -->
    {created && (
      <dialog id="modal-success-oplah" class="success-popup-dialog">
        <div class="success-popup-card">
          <button type="button" class="success-popup-close" onclick="closeSuccessModal()" title="Tutup Pop-up">&times;</button>
          
          <div class="success-icon-wrap">
            <div class="success-icon-circle">
              <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
          </div>

          <span class="success-tag">BERHASIL DIAJUKAN</span>
          <h2 class="success-title">Laporan Oplah Berhasil Diajukan!</h2>
          <p class="success-desc">
            Pencatatan sirkulasi koran telah masuk ke dalam antrean sistem dan sedang menunggu verifikasi bukti fisik oleh tim HRD.
          </p>

          <div class="success-meta-box">
            <div class="meta-row">
              <span class="meta-lbl">ID Berkas Laporan</span>
              <span class="meta-val mono-badge">{created}</span>
            </div>
            <div class="meta-row">
              <span class="meta-lbl">Status Verifikasi</span>
              <span class="status-pill-pending">
                <span class="pending-dot"></span>
                Menunggu HRD
              </span>
            </div>
            <div class="meta-row">
              <span class="meta-lbl">Indikator Kinerja</span>
              <span class="meta-val">IND-01 Sirkulasi Oplah</span>
            </div>
          </div>

          <div class="success-actions">
            <a href="/aktivitas-saya" class="btn btn-primary" style="flex: 1; justify-content: center; gap: 0.45rem;">
              <Icon name="clipboard" size={16} />
              <span>Pantau di Aktivitas Saya</span>
            </a>
            <button
              type="button"
              class="btn btn-secondary"
              onclick="closeSuccessModal()"
              style="padding: 0.6rem 1.25rem;"
            >
              Tutup &amp; Selesai
            </button>
          </div>
        </div>
      </dialog>
    )}
  </div>
</Layout>

<script is:inline>
  const qInput = document.getElementById('oplah-qty');
  const rInput = document.getElementById('oplah-returnQty');
  const calcDisplay = document.getElementById('oplah-calc-display');
  function recalcOplah() {
    if (!qInput || !rInput || !calcDisplay) return;
    const q = Math.max(0, parseInt(qInput.value, 10) || 0);
    const r = Math.max(0, parseInt(rInput.value, 10) || 0);
    const sold = Math.max(0, q - r);
    calcDisplay.textContent = `${sold.toLocaleString('id-ID')} eksemplar`;
  }
  qInput?.addEventListener('input', recalcOplah);
  rInput?.addEventListener('input', recalcOplah);

  var urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('action') === 'new' || urlParams.get('retry') === '1') {
    const dlg = document.getElementById('modal-input-oplah');
    if (dlg && typeof dlg.showModal === 'function') dlg.showModal();
  }

  // Auto-open modal pop-up sukses pengajuan
  const successDlg = document.getElementById('modal-success-oplah');
  if (successDlg && typeof successDlg.showModal === 'function') {
    successDlg.showModal();
    // Tutup dialog saat klik di luar area kartu (backdrop)
    successDlg.addEventListener('click', (e) => {
      const rect = successDlg.getBoundingClientRect();
      const inDialog = (
        rect.top <= e.clientY && e.clientY <= rect.top + rect.height &&
        rect.left <= e.clientX && e.clientX <= rect.left + rect.width
      );
      if (!inDialog) closeSuccessModal();
    });
  }

  function closeSuccessModal() {
    const dlg = document.getElementById('modal-success-oplah');
    if (dlg) dlg.close();
    // Bersihkan parameter ?created dari URL tanpa me-reload halaman
    const url = new URL(window.location.href);
    url.searchParams.delete('created');
    window.history.replaceState({}, '', url.pathname + (url.search ? url.search : ''));
  }
</script>

<style>
  /* Success Popup Dialog (Tengah Halaman, Simple & Modern) */
  .success-popup-dialog {
    padding: 0;
    border: none;
    border-radius: 20px;
    background: transparent;
    max-width: 440px;
    width: 90%;
    margin: auto;
    box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.28);
    overflow: visible;
  }
  .success-popup-dialog::backdrop {
    background: rgba(15, 23, 42, 0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    animation: fadeInBackdrop 0.2s ease-out;
  }
  @keyframes fadeInBackdrop {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  .success-popup-card {
    background: #ffffff;
    border-radius: 20px;
    padding: 2.25rem 2rem 2rem;
    text-align: center;
    position: relative;
    border: 1px solid rgba(226, 232, 240, 0.85);
    animation: popUpScale 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes popUpScale {
    from {
      opacity: 0;
      transform: scale(0.92) translateY(12px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }
  .success-popup-close {
    position: absolute;
    top: 1rem;
    right: 1.15rem;
    background: #f1f5f9;
    border: none;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 1.25rem;
    color: #64748b;
    cursor: pointer;
    line-height: 1;
    transition: all 0.15s ease;
  }
  .success-popup-close:hover {
    background: #e2e8f0;
    color: #0f172a;
  }
  .success-icon-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 1.25rem;
  }
  .success-icon-circle {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #dcfce7;
    color: #16a34a;
    display: grid;
    place-items: center;
    box-shadow: 0 0 0 8px #f0fdf4;
    animation: pulseCheck 1.8s infinite;
  }
  @keyframes pulseCheck {
    0% { box-shadow: 0 0 0 0 rgba(22, 163, 74, 0.35); }
    70% { box-shadow: 0 0 0 12px rgba(22, 163, 74, 0); }
    100% { box-shadow: 0 0 0 0 rgba(22, 163, 74, 0); }
  }
  .success-tag {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #16a34a;
    background: #f0fdf4;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    border: 1px solid #bbf7d0;
    margin-bottom: 0.65rem;
  }
  .success-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 0.5rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .success-desc {
    font-size: 0.875rem;
    color: #64748b;
    margin: 0 0 1.5rem;
    line-height: 1.55;
  }
  .success-meta-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1rem 1.15rem;
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    text-align: left;
  }
  .meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8125rem;
  }
  .meta-lbl {
    color: #64748b;
    font-weight: 500;
  }
  .meta-val {
    font-weight: 700;
    color: #1e293b;
  }
  .mono-badge {
    font-family: monospace;
    background: #e2e8f0;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    font-size: 0.75rem;
    color: #0f172a;
  }
  .status-pill-pending {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: #fef3c7;
    color: #b45309;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
  }
  .pending-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #d97706;
  }
  .success-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
</style>
