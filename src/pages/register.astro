---
import AuthLayout from "../layouts/AuthLayout.astro";
import Alert from "../components/ui/Alert.astro";

if (Astro.locals.user) return Astro.redirect("/dashboard");
const error = Astro.url.searchParams.get("error");
const nameVal = Astro.url.searchParams.get("name") ?? "";
const emailVal = Astro.url.searchParams.get("email") ?? "";
---
<AuthLayout title="Pendaftaran Akun">
  <div class="auth-center-layout">
    <div class="auth-box">
      <!-- Header Identitas Brand di atas kartu -->
      <div class="auth-brand-center">
        <div class="brand-monogram">JP</div>
        <div class="brand-info">
          <div class="brand-title">JAWA POS RADAR KEDIRI</div>
          <div class="brand-sub">Sistem Informasi Manajemen Oplah, Kerja Sama &amp; Kinerja (SIMOKP)</div>
        </div>
      </div>

      <!-- Kartu Registrasi Tunggal di Tengah -->
      <div class="login-card">
        <div class="login-header">
          <div class="login-icon-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <line x1="19" y1="8" x2="19" y2="14"/>
              <line x1="22" y1="11" x2="16" y2="11"/>
            </svg>
          </div>
          <h2 class="login-title">Pendaftaran Akun Baru</h2>
          <p class="login-subtitle">Lengkapi formulir di bawah ini untuk membuat akun karyawan SIMOKP.</p>
        </div>

        {error && (
          <div class="mb-4">
            <Alert tone="danger" title="Pendaftaran gagal">{error}</Alert>
          </div>
        )}

        <form method="post" action="/api/auth/register" id="reg-form" class="login-form">
          <div class="form-group">
            <label for="name" class="form-label">Nama Lengkap</label>
            <div class="input-wrapper">
              <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
              </svg>
              <input
                class="form-input"
                id="name"
                name="name"
                type="text"
                autocomplete="name"
                required
                minlength="2"
                value={nameVal}
                placeholder="cth. Dewi Lestari"
                autofocus
              />
            </div>
          </div>

          <div class="form-group">
            <label for="email" class="form-label">Alamat Email Resmi</label>
            <div class="input-wrapper">
              <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect width="20" height="16" x="2" y="4" rx="2"/>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
              <input
                class="form-input"
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                required
                value={emailVal}
                placeholder="nama@email.com"
              />
            </div>
          </div>

          <div class="form-group">
            <div style="display:flex; justify-content:space-between; align-items:center">
              <label for="password" class="form-label">Kata Sandi</label>
              <button type="button" class="btn-toggle-pw" data-target="password">Lihat</button>
            </div>
            <div class="input-wrapper">
              <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
              <input
                class="form-input"
                id="password"
                name="password"
                type="password"
                autocomplete="new-password"
                required
                minlength="6"
                placeholder="Minimal 6 karakter"
              />
            </div>
            <span class="field-hint">Minimal 6 karakter alfanumerik.</span>
          </div>

          <div class="form-group">
            <div style="display:flex; justify-content:space-between; align-items:center">
              <label for="confirmPassword" class="form-label">Konfirmasi Kata Sandi</label>
              <button type="button" class="btn-toggle-pw" data-target="confirmPassword">Lihat</button>
            </div>
            <div class="input-wrapper">
              <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
              <input
                class="form-input"
                id="confirmPassword"
                name="confirmPassword"
                type="password"
                autocomplete="new-password"
                required
                minlength="6"
                placeholder="Ketik ulang kata sandi"
              />
            </div>
            <span id="pw-match-error" style="display:none; color:#ef4444; font-size:0.75rem; margin-top:0.25rem; font-weight:600">
              Kata sandi konfirmasi tidak cocok.
            </span>
          </div>

          <div class="checkbox-group">
            <label class="checkbox-label">
              <input type="checkbox" required class="checkbox-input" />
              <span>Saya menyetujui akun ini terdaftar sebagai Karyawan Radar Kediri.</span>
            </label>
          </div>

          <button class="btn-submit" id="submit-btn" type="submit">
            <span>Daftar Sekarang</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14"/>
              <path d="m12 5 7 7-7 7"/>
            </svg>
          </button>
        </form>

        <div class="login-footer">
          <span>Sudah memiliki akun terdaftar?</span>
          <a href="/login" class="link-register">Masuk ke aplikasi</a>
        </div>
      </div>

      <!-- Footer Hak Cipta -->
      <div class="auth-center-footer">
        &copy; 2026 PT Kediri Intermedia Pers (Jawa Pos Radar Kediri)
      </div>
    </div>
  </div>

  <script is:inline>
    // Toggle intip kata sandi
    document.querySelectorAll(".btn-toggle-pw").forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetId = btn.getAttribute("data-target");
        const input = document.getElementById(targetId);
        if (input) {
          if (input.type === "password") {
            input.type = "text";
            btn.textContent = "Sembunyikan";
          } else {
            input.type = "password";
            btn.textContent = "Lihat";
          }
        }
      });
    });

    // Validasi kecocokan kata sandi sebelum submit
    const form = document.getElementById("reg-form");
    const pw = document.getElementById("password");
    const cpw = document.getElementById("confirmPassword");
    const errText = document.getElementById("pw-match-error");

    function checkMatch() {
      if (cpw.value && pw.value !== cpw.value) {
        errText.style.display = "block";
        cpw.setAttribute("aria-invalid", "true");
        return false;
      } else {
        errText.style.display = "none";
        cpw.removeAttribute("aria-invalid");
        return true;
      }
    }

    if (pw && cpw) {
      cpw.addEventListener("input", checkMatch);
      pw.addEventListener("input", () => {
        if (cpw.value) checkMatch();
      });
    }

    if (form) {
      form.addEventListener("submit", (e) => {
        if (!checkMatch()) {
          e.preventDefault();
          cpw.focus();
        }
      });
    }
  </script>
</AuthLayout>

<style>
  .auth-center-layout {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #f0f4f8 0%, #e2e8f0 100%);
    padding: 2.5rem 1.25rem;
    box-sizing: border-box;
  }

  .auth-box {
    width: 100%;
    max-width: 460px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  /* ========== BRAND HEADER ========== */
  .auth-brand-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.65rem;
  }

  .brand-monogram {
    width: 3.25rem;
    height: 3.25rem;
    background: #12345a;
    color: #ffffff;
    font-weight: 900;
    font-size: 1.35rem;
    letter-spacing: -0.05em;
    display: grid;
    place-items: center;
    border-radius: 12px;
    box-shadow: 0 6px 16px rgba(18, 52, 90, 0.25);
  }

  .brand-title {
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #12345a;
  }

  .brand-sub {
    font-size: 0.775rem;
    color: #64748b;
    max-width: 38ch;
    line-height: 1.45;
  }

  /* ========== KARTU REGISTRASI ========== */
  .login-card {
    width: 100%;
    background: #ffffff;
    padding: 2.25rem 2rem;
    border-radius: 16px;
    border: 1px solid rgba(226, 232, 240, 0.9);
    box-shadow: 
      0 20px 25px -5px rgba(15, 23, 42, 0.06),
      0 8px 10px -6px rgba(15, 23, 42, 0.04);
  }

  .login-header {
    text-align: center;
    margin-bottom: 1.75rem;
  }

  .login-icon-box {
    width: 3.25rem;
    height: 3.25rem;
    background: #eaf2f8;
    color: #12345a;
    border-radius: 12px;
    display: grid;
    place-items: center;
    margin: 0 auto 0.85rem;
  }

  .login-title {
    font-size: 1.4rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 0.35rem;
  }

  .login-subtitle {
    font-size: 0.825rem;
    color: #64748b;
    margin: 0;
    line-height: 1.5;
  }

  .login-form {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-label {
    font-size: 0.825rem;
    font-weight: 600;
    color: #1e293b;
  }

  .btn-toggle-pw {
    background: none;
    border: none;
    color: #176b87;
    cursor: pointer;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0;
  }

  .btn-toggle-pw:hover {
    text-decoration: underline;
  }

  .input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-icon {
    position: absolute;
    left: 0.95rem;
    color: #94a3b8;
    pointer-events: none;
  }

  .form-input {
    width: 100%;
    padding: 0.7rem 0.95rem 0.7rem 2.65rem;
    border: 1.5px solid #cbd5e1;
    border-radius: 8px;
    font-size: 0.9rem;
    color: #0f172a;
    background: #ffffff;
    transition: all 0.15s ease;
  }

  .form-input:focus {
    outline: none;
    border-color: #176b87;
    box-shadow: 0 0 0 3px rgba(23, 107, 135, 0.15);
  }

  .field-hint {
    font-size: 0.725rem;
    color: #64748b;
  }

  .checkbox-group {
    margin-top: 0.25rem;
  }

  .checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.78rem;
    color: #475569;
    cursor: pointer;
    line-height: 1.45;
  }

  .checkbox-input {
    margin-top: 0.15rem;
    accent-color: #176b87;
  }

  .btn-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    width: 100%;
    min-height: 2.85rem;
    background: linear-gradient(135deg, #176b87 0%, #12345a 100%);
    color: #ffffff;
    font-size: 0.925rem;
    font-weight: 600;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(18, 52, 90, 0.2);
    transition: all 0.15s ease;
    margin-top: 0.35rem;
  }

  .btn-submit:hover {
    box-shadow: 0 6px 16px rgba(18, 52, 90, 0.3);
    transform: translateY(-1px);
  }

  .login-footer {
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid #f1f5f9;
    text-align: center;
    font-size: 0.85rem;
    color: #64748b;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .link-register {
    color: #176b87;
    font-weight: 600;
    text-decoration: none;
  }

  .link-register:hover {
    color: #12345a;
    text-decoration: underline;
  }

  /* ========== FOOTER ========== */
  .auth-center-footer {
    font-size: 0.75rem;
    color: #64748b;
    text-align: center;
  }

  /* ========== RESPONSIVE ========== */
  @media (max-width: 480px) {
    .auth-center-layout {
      padding: 1.5rem 1rem;
    }
    .login-card {
      padding: 1.75rem 1.25rem;
    }
  }
</style>
