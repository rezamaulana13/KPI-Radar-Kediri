---
// Redirect ke modul marketing masing-masing
const type = Astro.url.searchParams.get("type");
if (type === "oplah") return Astro.redirect("/marketing/oplah?action=new");
if (type === "client") return Astro.redirect("/marketing/clients?action=new");
if (type === "offer") return Astro.redirect("/marketing/offers?action=new");
if (type === "program") return Astro.redirect("/marketing/programs?action=new");
if (type === "profiling") return Astro.redirect("/marketing/profiling?action=new");
return Astro.redirect("/modul-marketing");
