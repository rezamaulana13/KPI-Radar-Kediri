---
import AuthLayout from "../layouts/AuthLayout.astro";
import Alert from "../components/ui/Alert.astro";
import { supabaseConfigured } from "../lib/supabase/server";
import { db, divisionName, positionName } from "../lib/data/store";
import { ROLE_LABEL } from "../lib/formatters";

if (Astro.locals.user) return Astro.redirect("/dashboard");
const error = Astro.url.searchParams.get("error");
const success = Astro.url.searchParams.get("success");
const next = Astro.url.searchParams.get("next") ?? "/dashboard";
// 3 Role: Super Admin (E07), Admin HRD (E06), Pengguna Karyawan (E02)
const demoIds = ["E07", "E06", "E02"];
const demo = demoIds.map((id) => db.employees.find((e) => e.id === id)!);
---
<AuthLayout title="Masuk">
  <div class="auth">
    <section class="auth-side">
      <div class="masthead"><span>Radar Kediri</span><span>Sistem internal</span><span>Edisi MKI</span></div>
      <div>
        <h1>Catat aktivitas. Verifikasi. Lihat kinerja.</h1>
        <p>Setiap aktivitas Marketing dicatat oleh Pengguna (Karyawan), diverifikasi oleh Admin (HRD), lalu dikalkulasi ke capaian KPI.</p>
        <p class="text-sm mt-3" style="color:#b6c9dc">Didukung 3 peran hak akses: <strong>Super Admin</strong>, <strong>Admin (HRD)</strong>, dan <strong>Pengguna (Karyawan)</strong>.</p>
      </div>
      <p class="text-sm" style="margin:0">Belum punya akun? <a href="/register" style="color:#fff;text-decoration:underline">Daftar sekarang</a></p>
    </section>
    <section class="auth-main">
      <div class="auth-card card"><div class="card-body">
        <h2 class="mb-4">Masuk ke aplikasi</h2>
        {error && <Alert tone="danger" title="Tidak bisa masuk">{error}</Alert>}
        {success && <Alert tone="success" title="Sukses">{success}</Alert>}

        {supabaseConfigured ? (
          <>
            <a class="btn-google mb-3" href={`/api/auth/google?next=${encodeURIComponent(next)}`}>
              <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
              </svg>
              Masuk dengan Google
            </a>

            <div class="auth-divider"><span>atau dengan email</span></div>

            <form method="post" action="/api/auth/login">
              <input type="hidden" name="next" value={next} />
              <div class="field"><label for="email">Email</label><input class="input" id="email" name="email" type="email" autocomplete="username" required placeholder="nama@radarkediri.com" /></div>
              <div class="field"><label for="password">Kata sandi</label><input class="input" id="password" name="password" type="password" autocomplete="current-password" required minlength="6" /></div>
              <button class="btn btn-primary" style="width:100%;justify-content:center" type="submit">Masuk</button>
            </form>
          </>
        ) : (
          <>
            <a class="btn-google mb-3" href={`/api/auth/google?next=${encodeURIComponent(next)}`}>
              <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
              </svg>
              Masuk dengan Google (Simulasi)
            </a>

            <div class="auth-divider"><span>atau pilih peran</span></div>

            <Alert tone="info" title="Mode demo">Pilih salah satu dari 3 peran contoh untuk melihat fitur masing-masing peran:</Alert>
            <form method="post" action="/api/auth/login" class="demo-users">
              <input type="hidden" name="next" value={next} />
              {demo.map((e) => (
                <button type="submit" name="employeeId" value={e.id}>
                  <span><strong>{e.name}</strong><br /><span class="muted text-xs">{positionName(e.positionId)} · {divisionName(e.divisionId)}</span></span>
                  <span class="badge badge-neutral">{ROLE_LABEL[e.role]}</span>
                </button>
              ))}
            </form>
          </>
        )}

        <div class="auth-links">
          Belum punya akun? <a href="/register">Daftar sekarang</a>
        </div>
      </div></div>
    </section>
  </div>
</AuthLayout>
