---
import AuthLayout from "../layouts/AuthLayout.astro";
import Alert from "../components/ui/Alert.astro";
import { db } from "../lib/data/store";
import { supabaseConfigured } from "../lib/supabase/server";

if (Astro.locals.user) {
  const dest = Astro.locals.user.role === "employee" ? "/" : "/dashboard";
  return Astro.redirect(dest);
}
const error = Astro.url.searchParams.get("error");
const success = Astro.url.searchParams.get("success");
const next = Astro.url.searchParams.get("next") ?? "/dashboard";
const hasAccounts = supabaseConfigured ? true : db.employees.length > 0;
---
<AuthLayout title="Masuk">
  <div class="auth-center-layout">
    <div class="auth-box">
      <!-- Header Identitas Brand di atas kartu -->
      <div class="auth-brand-center">
        <div class="brand-monogram">JP</div>
        <div class="brand-info">
          <div class="brand-title">JAWA POS RADAR KEDIRI</div>
          <div class="brand-sub">Sistem Informasi Manajemen Oplah, Kerja Sama &amp; Kinerja (SIMOKP)</div>
        </div>
      </div>

      <!-- Kartu Login Tunggal di Tengah -->
      <div class="login-card">
        <div class="login-header">
          <div class="login-icon-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
              <polyline points="10 17 15 12 10 7"/>
              <line x1="15" y1="12" x2="3" y2="12"/>
            </svg>
          </div>
          <h2 class="login-title">Masuk ke SIMOKP</h2>
          <p class="login-subtitle">Silakan masukkan email dan kata sandi akun Anda untuk melanjutkan.</p>
        </div>

        {error && (
          <div class="mb-4">
            <Alert tone="danger" title="Tidak bisa masuk">{error}</Alert>
          </div>
        )}
        {success && (
          <div class="mb-4">
            <Alert tone="success" title="Sukses">{success}</Alert>
          </div>
        )}

        {!hasAccounts && (
          <div class="mb-4">
            <Alert tone="warning" title="Belum Ada Akun Terdaftar">
              Sistem saat ini belum memiliki akun pengguna. Silakan daftarkan akun pertama Anda terlebih dahulu.
              <div style="margin-top:0.75rem">
                <a href="/register" class="btn btn-primary btn-sm" style="display:inline-flex">Buat Akun Sekarang</a>
              </div>
            </Alert>
          </div>
        )}

        <form method="post" action="/api/auth/login" class="login-form">
          <input type="hidden" name="next" value={next} />

          <div class="form-group">
            <label for="email" class="form-label">Alamat Email Resmi</label>
            <div class="input-wrapper">
              <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2"/>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
              <input 
                class="form-input" 
                id="email" 
                name="email" 
                type="email" 
                autocomplete="username" 
                required 
                placeholder="nama@email.com" 
                autofocus
              />
            </div>
          </div>

          <div class="form-group">
            <label for="password" class="form-label">Kata Sandi</label>
            <div class="input-wrapper">
              <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
              <input 
                class="form-input" 
                id="password" 
                name="password" 
                type="password" 
                autocomplete="current-password" 
                required 
                minlength="6" 
                placeholder="Masukkan kata sandi akun" 
              />
            </div>
          </div>

          <button class="btn-submit" type="submit">
            <span>Masuk ke Aplikasi</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"/>
              <path d="m12 5 7 7-7 7"/>
            </svg>
          </button>
        </form>

        <div class="login-footer">
          <span>Belum memiliki akun terdaftar?</span>
          <a href="/register" class="link-register">Daftar Akun Baru</a>
        </div>
      </div>

      <!-- Footer Hak Cipta -->
      <div class="auth-center-footer">
        &copy; 2026 PT Kediri Intermedia Pers (Jawa Pos Radar Kediri)
      </div>
    </div>
  </div>
</AuthLayout>

<style>
  .auth-center-layout {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #f0f4f8 0%, #e2e8f0 100%);
    padding: 2.5rem 1.25rem;
    box-sizing: border-box;
  }

  .auth-box {
    width: 100%;
    max-width: 440px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  /* ========== BRAND HEADER ========== */
  .auth-brand-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.65rem;
  }

  .brand-monogram {
    width: 3.25rem;
    height: 3.25rem;
    background: #12345a;
    color: #ffffff;
    font-weight: 900;
    font-size: 1.35rem;
    letter-spacing: -0.05em;
    display: grid;
    place-items: center;
    border-radius: 12px;
    box-shadow: 0 6px 16px rgba(18, 52, 90, 0.25);
  }

  .brand-title {
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #12345a;
  }

  .brand-sub {
    font-size: 0.775rem;
    color: #64748b;
    max-width: 36ch;
    line-height: 1.45;
  }

  /* ========== KARTU LOGIN ========== */
  .login-card {
    width: 100%;
    background: #ffffff;
    padding: 2.5rem 2.25rem;
    border-radius: 16px;
    border: 1px solid rgba(226, 232, 240, 0.9);
    box-shadow: 
      0 20px 25px -5px rgba(15, 23, 42, 0.06),
      0 8px 10px -6px rgba(15, 23, 42, 0.04);
  }

  .login-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .login-icon-box {
    width: 3.25rem;
    height: 3.25rem;
    background: #eaf2f8;
    color: #12345a;
    border-radius: 12px;
    display: grid;
    place-items: center;
    margin: 0 auto 1rem;
  }

  .login-title {
    font-size: 1.45rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 0.4rem;
  }

  .login-subtitle {
    font-size: 0.85rem;
    color: #64748b;
    margin: 0;
    line-height: 1.5;
  }

  .login-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .form-label {
    font-size: 0.825rem;
    font-weight: 600;
    color: #1e293b;
  }

  .input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-icon {
    position: absolute;
    left: 0.95rem;
    color: #94a3b8;
    pointer-events: none;
  }

  .form-input {
    width: 100%;
    padding: 0.75rem 0.95rem 0.75rem 2.65rem;
    border: 1.5px solid #cbd5e1;
    border-radius: 8px;
    font-size: 0.925rem;
    color: #0f172a;
    background: #ffffff;
    transition: all 0.15s ease;
  }

  .form-input:focus {
    outline: none;
    border-color: #176b87;
    box-shadow: 0 0 0 3px rgba(23, 107, 135, 0.15);
  }

  .form-input::placeholder {
    color: #94a3b8;
  }

  .btn-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    width: 100%;
    min-height: 2.85rem;
    background: linear-gradient(135deg, #176b87 0%, #12345a 100%);
    color: #ffffff;
    font-size: 0.925rem;
    font-weight: 600;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(18, 52, 90, 0.2);
    transition: all 0.15s ease;
    margin-top: 0.5rem;
  }

  .btn-submit:hover {
    box-shadow: 0 6px 16px rgba(18, 52, 90, 0.3);
    transform: translateY(-1px);
  }

  .btn-submit:active {
    transform: translateY(0);
  }

  .login-footer {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid #f1f5f9;
    text-align: center;
    font-size: 0.85rem;
    color: #64748b;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .link-register {
    color: #176b87;
    font-weight: 600;
    text-decoration: none;
  }

  .link-register:hover {
    color: #12345a;
    text-decoration: underline;
  }

  /* ========== FOOTER ========== */
  .auth-center-footer {
    font-size: 0.75rem;
    color: #64748b;
    text-align: center;
  }

  /* ========== RESPONSIVE ========== */
  @media (max-width: 480px) {
    .auth-center-layout {
      padding: 1.5rem 1rem;
    }
    .login-card {
      padding: 2rem 1.5rem;
    }
    .login-title {
      font-size: 1.3rem;
    }
  }
</style>
