---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import ListPage from "../../components/ui/ListPage.astro";
import Alert from "../../components/ui/Alert.astro";
import { db, divisions } from "../../lib/data/store";
const rows = divisions.map((d) => ({ ...d, members: db.employees.filter((e) => e.divisionId === d.id).length, status: d.active ? "active" : "closed" }));
---
<DashboardLayout title="Divisi">
  <ListPage title="Divisi Operasional" description="Struktur divisi fokus sistem informasi aktivitas & evaluasi kinerja Radar Kediri." crumbs={[{ label: "Admin" }]} rows={rows} searchKeys={["name", "code"]}
    columns={[{ key: "code", label: "Kode", type: "mono" }, { key: "name", label: "Nama divisi" }, { key: "members", label: "Anggota", type: "number" }, { key: "status", label: "Status", type: "badge" }]}>
    <Alert slot="before" tone="success" title="Fokus Divisi Pemasaran & Sirkulasi">Sistem ini dirancang khusus untuk memonitor dan mengevaluasi kinerja operasional Divisi Pemasaran & Sirkulasi PT Kediri Intermedia Pers.</Alert>
  </ListPage>
</DashboardLayout>
