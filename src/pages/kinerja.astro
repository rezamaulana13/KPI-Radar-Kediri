---
import PublicLayout from "../layouts/PublicLayout.astro";
import Icon from "../components/ui/Icon.astro";
import PeriodFilter from "../components/ui/PeriodFilter.astro";
import { db, activePeriod, activitiesFor, positions, divisionName } from "../lib/data/store";
import { achievements } from "../features/kpi/achievements";
import { selectedPeriod } from "../lib/utils/period";
import { num, rupiah, pct, dateID, TYPE_LABEL, initials } from "../lib/formatters";

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/login?next=/kinerja");
}

const p = selectedPeriod(Astro.url);

// Pastikan karyawan memiliki target individual standar jika belum diset manual oleh HRD
if (!db.targets.some((t) => t.employeeId === user.id && t.periodId === p.id)) {
  db.targets.push(
    { id: `TG-IND-${user.id.slice(0, 4)}-1`, indicatorId: "IND-02", periodId: p.id, scope: "individual", employeeId: user.id, value: 10 },
    { id: `TG-IND-${user.id.slice(0, 4)}-2`, indicatorId: "IND-03", periodId: p.id, scope: "individual", employeeId: user.id, value: 15 },
    { id: `TG-IND-${user.id.slice(0, 4)}-3`, indicatorId: "IND-04", periodId: p.id, scope: "individual", employeeId: user.id, value: 5 },
    { id: `TG-IND-${user.id.slice(0, 4)}-4`, indicatorId: "IND-08", periodId: p.id, scope: "individual", employeeId: user.id, value: 20 }
  );
}

// Data Profil Karyawan
const emp = db.employees.find((e) => e.id === user.id);
const posName = positions.find((pos) => pos.id === emp?.positionId)?.name ?? "Eksekutif Pemasaran";
const divName = divisionName(user.divisionId) || "Divisi Pemasaran & Sirkulasi";
const nip = emp?.nip || `RK-${user.id.slice(0, 4).toUpperCase()}`;

// Ambil target yang sah ditetapkan HRD
const allRows = achievements(p.id);
const myTargets = allRows.filter((r) => r.target.scope === "individual" && r.target.employeeId === user.id);
const divTargets = allRows.filter((r) => r.target.scope === "division" && (r.target.divisionId === user.divisionId || r.target.divisionId === "DIV-MKT"));

// Data Aktivitas Lapangan Karyawan
const acts = activitiesFor({ id: user.id, role: user.role }).filter((a) => a.periodId === p.id);
const approvedActs = acts.filter((a) => a.status === "approved");
const pendingCount = acts.filter((a) => a.status === "pending").length;
const revisionCount = acts.filter((a) => a.status === "revision" || a.status === "rejected").length;

// Hitung Indeks Kinerja Terbobot (Rata-rata Capaian Target Individu)
const measurable = myTargets.filter((r) => r.percent != null);
const avgPercent = measurable.length ? Math.round(measurable.reduce((s, r) => s + Math.min(r.percent!, 100), 0) / measurable.length) : 0;

// Penetapan Predikat Evaluasi Kinerja
let predikat = {
  grade: "D",
  label: "Kurang",
  color: "#ef4444",
  badgeBg: "#fee2e2",
  badgeColor: "#991b1b",
  desc: "Capaian target kinerja di bawah 55%. Diperlukan percepatan penutupan deal atau perluasan sebaran sirkulasi.",
};
if (avgPercent >= 85) {
  predikat = {
    grade: "A",
    label: "Sangat Baik",
    color: "#10b981",
    badgeBg: "#d1fae5",
    badgeColor: "#065f46",
    desc: "Performa luar biasa! Konsistensi dan kontribusi operasional melampaui standar target periode ini.",
  };
} else if (avgPercent >= 70) {
  predikat = {
    grade: "B",
    label: "Baik",
    color: "#0284c7",
    badgeBg: "#e0f2fe",
    badgeColor: "#075985",
    desc: "Kinerja stabil dan memenuhi seluruh standar target operasional utama divisi.",
  };
} else if (avgPercent >= 55) {
  predikat = {
    grade: "C",
    label: "Cukup",
    color: "#f59e0b",
    badgeBg: "#fef3c7",
    badgeColor: "#92400e",
    desc: "Sebagian target telah tercapai, optimalkan follow-up proposal penawaran untuk meningkatkan skor.",
  };
}

// 4 Metrik Operasional SIMOKP Karyawan
// 1. Kas Tunai
const userCash = approvedActs
  .filter((a) => a.type === "outcome" && a.outcome === "deal")
  .reduce((s, a) => s + (a.cashValue != null ? a.cashValue : (a.value || 0)), 0);

// 2. Nilai Barter
const userBarter = approvedActs
  .filter((a) => (a.type === "outcome" && a.outcome === "deal" && (a.barterValue || 0) > 0) || a.type === "program")
  .reduce((s, a) => s + (a.barterValue != null ? a.barterValue : 0), 0);

// 3. Oplah Bersih Terjual & Retur
const userSentOplah = approvedActs
  .filter((a) => a.type === "oplah")
  .reduce((s, a) => s + (a.qty || 0), 0);
const userReturnOplah = approvedActs
  .filter((a) => a.type === "oplah")
  .reduce((s, a) => s + (a.returnQty || 0), 0);
const userSoldOplah = approvedActs
  .filter((a) => a.type === "oplah")
  .reduce((s, a) => s + (a.soldQty != null ? a.soldQty : Math.max(0, (a.qty || 0) - (a.returnQty || 0))), 0);
const userReturnRate = userSentOplah > 0 ? ((userReturnOplah / userSentOplah) * 100).toFixed(1) : "0.0";

// Riwayat aktivitas disetujui terbaru
const contributingActs = approvedActs.slice(0, 6);

// Helper format angka & satuan
const formatVal = (val: number | null | undefined, unit: string) => {
  if (val == null) return "—";
  if (unit === "Rp" || unit.toLowerCase().includes("rupiah")) return rupiah(val);
  return `${num(val)} ${unit}`;
};
---

<PublicLayout
  title="Rapor Kinerja Karyawan (KPI) · SIMOKP"
  activeNav="kinerja"
  description="Evaluasi capaian indikator kinerja individu dan divisi PT Kediri Intermedia Pers (Jawa Pos Radar Kediri)."
>
  <div class="pub-page-container">
    <!-- Breadcrumb -->
    <nav class="pub-breadcrumb no-print" aria-label="Breadcrumb">
      <a href="/">Beranda</a>
      <span class="sep">/</span>
      <span class="current">Rapor Kinerja KPI</span>
    </nav>

    <!-- Header Halaman & Aksi Ekspor -->
    <div class="pub-page-header">
      <div class="header-main">
        <span class="header-tag">RAPOR KINERJA KARYAWAN</span>
        <h1>Evaluasi Kinerja &amp; Capaian KPI</h1>
        <p class="header-desc">
          Rangkuman realisasi target operasional perorangan dan kontribusi tim periode <strong>{p.name}</strong>. Seluruh angka dihitung otomatis dari aktivitas harian yang telah diverifikasi dan disetujui HRD.
        </p>
      </div>
      <div class="header-actions no-print">
        <PeriodFilter />
        <button type="button" class="btn btn-secondary btn-sm" onclick="window.print()" title="Cetak lembar rapor kinerja ke PDF / Printer">
          <Icon name="printer" size={15} />
          <span>Cetak Rapor</span>
        </button>
        <a href={`/api/export/excel?type=employee&period=${p.id}`} class="btn btn-primary btn-sm" download title="Unduh Rapor Kinerja Bulanan dalam format Microsoft Excel">
          <Icon name="download" size={15} />
          <span>Unduh Excel</span>
        </a>
      </div>
    </div>

    <!-- KARTU PROFIL KARYAWAN & PREDIKAT KINERJA EKSEKUTIF -->
    <section class="card profile-report-card">
      <div class="report-identity">
        <div class="report-avatar" aria-hidden="true">
          {initials(user.name)}
        </div>
        <div class="report-bio">
          <div class="report-bio-top">
            <span class="report-status-badge">🟢 Karyawan Aktif</span>
            <span class="report-period-badge">📅 Periode: {p.name}</span>
          </div>
          <h2 class="report-emp-name">{user.name}</h2>
          <div class="report-meta-grid">
            <div class="meta-item">
              <span class="meta-label">Nomor Induk Pegawai (NIP)</span>
              <span class="meta-val mono">{nip}</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Jabatan / Posisi</span>
              <span class="meta-val">{posName}</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Unit Kerja</span>
              <span class="meta-val">{divName}</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Status Verifikasi</span>
              <span class="meta-val text-success">{approvedActs.length} Disetujui ({acts.length > 0 ? Math.round((approvedActs.length / acts.length) * 100) : 0}% Lolos)</span>
            </div>
          </div>
        </div>
      </div>

      <div class="report-score-panel">
        <span class="score-label">INDEKS PRESTASI KPI</span>
        <div class="score-circle" style={`border-color: ${predikat.color};`}>
          <span class="score-number" style={`color: ${predikat.color};`}>{avgPercent}%</span>
          <span class="score-caption">Target Rata-rata</span>
        </div>
        <div class="score-grade-badge" style={`background-color: ${predikat.badgeBg}; color: ${predikat.badgeColor};`}>
          Predikat: {predikat.label} ({predikat.grade})
        </div>
        <p class="score-desc">{predikat.desc}</p>
      </div>
    </section>

    <!-- 4 STAT BOX PILAR OPERASIONAL SIMOKP -->
    <div class="stat-grid-4">
      <div class="stat-box tone-kas">
        <span class="stat-lbl">Omzet Kas Tunai</span>
        <span class="stat-val">{rupiah(userCash)}</span>
        <span class="stat-sub">Penerimaan kas riil dari deal iklan</span>
      </div>

      <div class="stat-box tone-barter">
        <span class="stat-lbl">Nilai Realisasi Barter</span>
        <span class="stat-val">{rupiah(userBarter)}</span>
        <span class="stat-sub">Barang/jasa promosi non-tunai</span>
      </div>

      <div class="stat-box tone-oplah">
        <span class="stat-lbl">Oplah Bersih Terjual</span>
        <span class="stat-val">{num(userSoldOplah)} <small style="font-size:0.9rem;font-weight:600;">Eks</small></span>
        <span class="stat-sub">Sirkulasi terverifikasi dikurangi retur</span>
      </div>

      <div class="stat-box tone-retur">
        <span class="stat-lbl">Rasio Retur Koran</span>
        <span class="stat-val">{userReturnRate}%</span>
        <span class="stat-sub">{num(userReturnOplah)} retur dari {num(userSentOplah)} kirim</span>
      </div>
    </div>

    <!-- KOTAK INFO SISTEM KPI -->
    <div class="info-kpi-banner card no-print">
      <div class="kpi-icon">
        <Icon name="award" size={24} />
      </div>
      <div>
        <h4>Transparansi Evaluasi Berbasis Key Performance Indicators (KPI)</h4>
        <p>
          Sistem Informasi Manajemen Oplah, Kerja Sama, dan Kinerja Pemasaran (SIMOKP) menghitung rapor kinerja secara tertutup dan objektif. Setiap indikator bersumber langsung dari bukti operasional yang diverifikasi tim verifikator/HRD, memisahkan transaksi kas tunai dari barter promosi, serta memperhitungkan retur oplah riil.
        </p>
      </div>
    </div>

    <!-- TABEL 1: TARGET DAN REALISASI INDIVIDU -->
    <section class="card table-card" style="margin-bottom: 2rem;">
      <div class="table-card-head">
        <div>
          <h3>Rincian Indikator Kinerja Individu</h3>
          <p class="table-card-sub">Sasaran target perorangan yang dibebankan kepada {user.name} pada periode {p.name}.</p>
        </div>
        <div class="head-right no-print">
          <a href="/modul-marketing" class="btn btn-primary btn-sm">
            <Icon name="plus" size={14} />
            <span>Input via Modul Marketing</span>
          </a>
        </div>
      </div>

      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th style="width: 90px;">Kode</th>
              <th>Indikator Kinerja</th>
              <th style="width: 120px;">Satuan</th>
              <th style="width: 120px; text-align: right;">Target</th>
              <th style="width: 120px; text-align: right;">Realisasi</th>
              <th style="width: 220px;">Capaian (%)</th>
              <th style="width: 130px; text-align: center;">Status</th>
            </tr>
          </thead>
          <tbody>
            {myTargets.length === 0 ? (
              <tr>
                <td colspan="7" style="text-align: center; padding: 2.5rem; color: var(--color-muted);">
                  Belum ada target individu khusus yang ditetapkan untuk periode ini.
                </td>
              </tr>
            ) : (
              myTargets.map((r) => {
                const pctVal = r.percent != null ? Math.round(r.percent) : 0;
                const barWidth = Math.min(pctVal, 100);
                const isSuccess = pctVal >= 100;
                const isGood = pctVal >= 70;
                const isWarning = pctVal >= 40;
                const barColor = isSuccess ? "#10b981" : isGood ? "#0284c7" : isWarning ? "#f59e0b" : "#ef4444";
                const statusLabel = isSuccess ? "Tercapai" : isGood ? "Progres Baik" : isWarning ? "Berjalan" : "Perlu Ditingkatkan";
                const statusBadgeBg = isSuccess ? "#d1fae5" : isGood ? "#e0f2fe" : isWarning ? "#fef3c7" : "#fee2e2";
                const statusBadgeColor = isSuccess ? "#065f46" : isGood ? "#075985" : isWarning ? "#92400e" : "#991b1b";

                return (
                  <tr>
                    <td><span class="mono-code">{r.indicator.code}</span></td>
                    <td>
                      <div class="font-bold text-dark">{r.indicator.name}</div>
                      <div class="indicator-def">{r.indicator.definition || "Indikator standar marketing operasional"}</div>
                    </td>
                    <td><span class="badge-unit">{r.indicator.unit}</span></td>
                    <td style="text-align: right; font-weight: 600;">{formatVal(r.target.value, r.indicator.unit)}</td>
                    <td style="text-align: right; font-weight: 700; color: var(--color-primary-900);">
                      {formatVal(r.actual, r.indicator.unit)}
                    </td>
                    <td>
                      <div class="meter-wrapper">
                        <div class="meter-track">
                          <div class="meter-fill" style={`width: ${barWidth}%; background-color: ${barColor};`}></div>
                        </div>
                        <span class="meter-pct font-bold" style={`color: ${barColor};`}>{pctVal}%</span>
                      </div>
                    </td>
                    <td style="text-align: center;">
                      <span class="status-pill" style={`background-color: ${statusBadgeBg}; color: ${statusBadgeColor};`}>
                        {statusLabel}
                      </span>
                    </td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>
    </section>

    <!-- TABEL 2: TARGET DIVISI PEMASARAN & SIRKULASI (KOLEKTIF) -->
    <section class="card table-card" style="margin-bottom: 2rem;">
      <div class="table-card-head">
        <div>
          <h3>Capaian Target Bersama Divisi Pemasaran &amp; Sirkulasi</h3>
          <p class="table-card-sub">Capaian agregat tim yang memengaruhi performa korporat dan rasio sirkulasi.</p>
        </div>
      </div>

      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th style="width: 90px;">Kode</th>
              <th>Indikator Sasaran Divisi</th>
              <th style="width: 120px;">Satuan</th>
              <th style="width: 150px; text-align: right;">Target Divisi</th>
              <th style="width: 150px; text-align: right;">Realisasi Tim</th>
              <th style="width: 220px;">Capaian (%)</th>
              <th style="width: 130px; text-align: center;">Status</th>
            </tr>
          </thead>
          <tbody>
            {divTargets.length === 0 ? (
              <tr>
                <td colspan="7" style="text-align: center; padding: 2.5rem; color: var(--color-muted);">
                  Belum ada target divisi yang ditetapkan untuk periode ini.
                </td>
              </tr>
            ) : (
              divTargets.map((r) => {
                const pctVal = r.percent != null ? Math.round(r.percent) : 0;
                const barWidth = Math.min(pctVal, 100);
                const isSuccess = pctVal >= 100;
                const isGood = pctVal >= 70;
                const isWarning = pctVal >= 40;
                const barColor = isSuccess ? "#10b981" : isGood ? "#0284c7" : isWarning ? "#f59e0b" : "#ef4444";
                const statusLabel = isSuccess ? "Tercapai" : isGood ? "Progres Baik" : isWarning ? "Berjalan" : "Perlu Ditingkatkan";
                const statusBadgeBg = isSuccess ? "#d1fae5" : isGood ? "#e0f2fe" : isWarning ? "#fef3c7" : "#fee2e2";
                const statusBadgeColor = isSuccess ? "#065f46" : isGood ? "#075985" : isWarning ? "#92400e" : "#991b1b";

                return (
                  <tr>
                    <td><span class="mono-code">{r.indicator.code}</span></td>
                    <td>
                      <div class="font-bold text-dark">{r.indicator.name}</div>
                      <div class="indicator-def">{r.indicator.definition}</div>
                    </td>
                    <td><span class="badge-unit">{r.indicator.unit}</span></td>
                    <td style="text-align: right; font-weight: 600;">{formatVal(r.target.value, r.indicator.unit)}</td>
                    <td style="text-align: right; font-weight: 700; color: var(--color-primary-900);">
                      {formatVal(r.actual, r.indicator.unit)}
                    </td>
                    <td>
                      <div class="meter-wrapper">
                        <div class="meter-track">
                          <div class="meter-fill" style={`width: ${barWidth}%; background-color: ${barColor};`}></div>
                        </div>
                        <span class="meter-pct font-bold" style={`color: ${barColor};`}>{pctVal}%</span>
                      </div>
                    </td>
                    <td style="text-align: center;">
                      <span class="status-pill" style={`background-color: ${statusBadgeBg}; color: ${statusBadgeColor};`}>
                        {statusLabel}
                      </span>
                    </td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>
    </section>

    <!-- TABEL 3: BUKTI RIWAYAT AKTIVITAS TERVERIFIKASI -->
    <section class="card table-card">
      <div class="table-card-head">
        <div>
          <h3>Bukti Aktivitas Terverifikasi Periode {p.name}</h3>
          <p class="table-card-sub">Audit trail aktivitas harian Anda yang telah diverifikasi dan berkontribusi terhadap angka KPI.</p>
        </div>
        <div class="head-right no-print">
          <a href="/aktivitas-saya" class="btn btn-secondary btn-sm">
            <span>Buka Semua Aktivitas ({acts.length}) &rarr;</span>
          </a>
        </div>
      </div>

      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th style="width: 110px;">ID Log</th>
              <th style="width: 110px;">Tanggal</th>
              <th style="width: 140px;">Kategori</th>
              <th>Deskripsi Aktivitas</th>
              <th style="width: 160px; text-align: right;">Nilai / Volume</th>
              <th style="width: 120px; text-align: center;">Status</th>
            </tr>
          </thead>
          <tbody>
            {contributingActs.length === 0 ? (
              <tr>
                <td colspan="6" style="text-align: center; padding: 2.5rem; color: var(--color-muted);">
                  Belum ada aktivitas terverifikasi untuk periode ini.
                </td>
              </tr>
            ) : (
              contributingActs.map((a) => {
                let volDisplay = "1 kegiatan";
                if (a.type === "oplah") {
                  volDisplay = `${num(a.soldQty ?? a.qty)} eks terjual`;
                } else if (a.type === "outcome" && a.outcome === "deal") {
                  const parts = [];
                  if ((a.cashValue || 0) > 0) parts.push(`Kas: ${rupiah(a.cashValue)}`);
                  if ((a.barterValue || 0) > 0) parts.push(`Barter: ${rupiah(a.barterValue)}`);
                  volDisplay = parts.join(" + ") || (a.value ? rupiah(a.value) : "Deal");
                } else if (a.type === "program" && a.value) {
                  volDisplay = rupiah(a.value);
                } else if (a.qty) {
                  volDisplay = `${num(a.qty)} item`;
                }

                return (
                  <tr>
                    <td><span class="mono-code">{a.id}</span></td>
                    <td>{dateID(a.date)}</td>
                    <td><span class="badge-unit">{TYPE_LABEL[a.type] || a.type}</span></td>
                    <td>
                      <div class="font-bold text-dark">{a.title}</div>
                      <div class="indicator-def">{a.description}</div>
                    </td>
                    <td style="text-align: right; font-weight: 600; color: #1e293b;">{volDisplay}</td>
                    <td style="text-align: center;">
                      <span class="status-pill" style="background-color: #d1fae5; color: #065f46;">
                        Disetujui
                      </span>
                    </td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>
    </section>

    <!-- LEMBAR PENGESAHAN CETAK (HANYA MUNCUL DI PRINT) -->
    <div class="print-signatures print-only">
      <div class="sig-col">
        <p class="sig-title">Pegawai yang Dinilai,</p>
        <div class="sig-space"></div>
        <p class="sig-name"><strong>{user.name}</strong></p>
        <p class="sig-nip">NIP: {nip}</p>
      </div>

      <div class="sig-col">
        <p class="sig-title">Kediri, {new Date().toLocaleDateString("id-ID", { day: "numeric", month: "long", year: "numeric" })}</p>
        <p class="sig-title">Manajer Pemasaran &amp; Sirkulasi,</p>
        <div class="sig-space"></div>
        <p class="sig-name"><strong>Drs. H. Bambang Iswahyudi</strong></p>
        <p class="sig-nip">PT Kediri Intermedia Pers</p>
      </div>
    </div>
  </div>
</PublicLayout>

<style>
  .pub-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-xs);
    color: var(--color-muted);
    margin-bottom: 1.25rem;
  }

  .pub-breadcrumb a {
    color: var(--color-primary-800);
    text-decoration: none;
    font-weight: 550;
  }

  .pub-breadcrumb a:hover {
    text-decoration: underline;
  }

  .pub-breadcrumb .sep {
    color: #cbd5e1;
  }

  .pub-breadcrumb .current {
    color: #475569;
    font-weight: 600;
  }

  .pub-page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
    flex-wrap: wrap;
  }

  .header-tag {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--color-primary-800);
    background: var(--color-primary-100);
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .pub-page-header h1 {
    font-family: var(--font-display);
    font-size: 1.85rem;
    font-weight: 700;
    color: var(--color-primary-900);
    margin: 0 0 0.4rem;
  }

  .header-desc {
    font-size: var(--text-sm);
    color: #475569;
