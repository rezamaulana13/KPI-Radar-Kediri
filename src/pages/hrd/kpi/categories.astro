---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import ListPage from "../../../components/ui/ListPage.astro";
import { categories, indicators } from "../../../lib/data/store";
import { SCOPE_LABEL } from "../../../lib/formatters";
const rows = categories.map((c) => ({ ...c, scopeLabel: SCOPE_LABEL[c.scope], count: indicators.filter((i) => i.categoryId === c.id).length }));
---
<DashboardLayout title="Kategori KPI">
  <ListPage title="Kategori KPI" description="KPI dibedakan menurut cakupan: perusahaan, divisi, dan individu." crumbs={[{ label: "HRD" }, { label: "KPI" }]} rows={rows}
    columns={[{ key: "name", label: "Kategori" }, { key: "scopeLabel", label: "Cakupan" }, { key: "description", label: "Keterangan" }, { key: "count", label: "Indikator", type: "number" }]} />
</DashboardLayout>
