---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import PageHeader from "../../../components/layout/PageHeader.astro";
import Alert from "../../../components/ui/Alert.astro";
import Badge from "../../../components/ui/Badge.astro";
import FormError from "../../../components/ui/FormError.astro";
import ConfirmDialog from "../../../components/ui/ConfirmDialog.astro";
import ActivityDetail from "../../../components/ui/ActivityDetail.astro";
import Icon from "../../../components/ui/Icon.astro";
import { activity, db, historyOf, employeeName, mappings, indicators } from "../../../lib/data/store";
import { contribution } from "../../../features/kpi/achievements";
import { canVerify } from "../../../features/verification/rules";
import { takeFormState } from "../../../lib/utils/flash";
import { dateTimeID, rupiah, num } from "../../../lib/formatters";

const a = activity(Astro.params.id!);
if (!a) return new Response(null, { status: 404 });
const u = Astro.locals.user!;
const check = canVerify(u, a, db.employees);
const st = takeFormState(Astro.cookies, Astro.url);
const hist = historyOf(a.id);

// Proyeksi kontribusi aktivitas ke indikator KPI
const m = mappings.find((x) => x.activityType === a.type && (!x.outcome || x.outcome === a.outcome));
const ind = m ? indicators.find((i) => i.id === m.indicatorId) : null;
const projVal = ind ? contribution(a, ind.id) : null;
---
<DashboardLayout title={`Verifikasi ${a.id}`}>
  <PageHeader title={`Verifikasi ${a.id}`} description="Periksa data aktivitas, lalu setujui, minta revisi, atau tolak." crumbs={[{ label: "HRD" }, { label: "Verifikasi", href: "/hrd/verifications" }]} />
  {st.error && <Alert tone="danger" title="Keputusan belum tersimpan">{st.error}</Alert>}
  {!check.ok && <Alert tone="warning" title="Anda tidak dapat memverifikasi aktivitas ini">{check.reason}</Alert>}
  <div class="grid-3-1">
    <section class="card"><div class="card-head"><h2>Data aktivitas</h2><Badge status={a.status} /></div><div class="card-body"><ActivityDetail activity={a} /></div></section>
    <div class="stack">
      {ind ? (
        <section class="card" style="background:#f0fdf4;border-color:#bbf7d0;">
          <div class="card-head" style="border-bottom-color:#bbf7d0;">
            <h3 style="font-size:0.95rem;color:#166534;margin:0;">Proyeksi Kontribusi KPI</h3>
            <span class="badge badge-success">Terpetakan</span>
          </div>
          <div class="card-body" style="font-size:var(--text-sm);color:#14532d;">
            <p style="margin:0 0 0.35rem;">
              Jika disetujui, akan menambah realisasi <strong>{ind.name} ({ind.code})</strong>:
            </p>
            <div style="font-size:1.25rem;font-weight:700;color:#0f5a2b;margin-bottom:0.25rem;">
              +{projVal !== null ? (ind.unit === "Rp" ? rupiah(projVal) : `${num(projVal)} ${ind.unit}`) : "—"}
            </div>
            <span class="muted text-xs" style="color:#15803d;">Mapping: {m?.note}</span>
          </div>
        </section>
      ) : (
        <section class="card" style="background:#fffbeb;border-color:#fde68a;">
          <div class="card-head" style="border-bottom-color:#fde68a;">
            <h3 style="font-size:0.95rem;color:#92400e;margin:0;">Status Mapping KPI</h3>
            <span class="badge badge-pending">Manual</span>
          </div>
          <div class="card-body" style="font-size:var(--text-xs);color:#78350f;">
            Aktivitas jenis ini belum terpetakan otomatis ke KPI. Persetujuan tetap dicatat sah pada audit sistem.
          </div>
        </section>
      )}

      {check.ok && (
        <section class="card"><div class="card-head"><h2>Keputusan HRD</h2></div><div class="card-body">
          <form method="post" action={`/api/verifications/${a.id}`} id="vform">
            <div class="field"><label for="note">Catatan pemeriksaan</label><textarea class="textarea" id="note" name="note" aria-invalid={st.fields.note ? "true" : undefined} placeholder="Tuliskan alasan jika meminta revisi atau menolak...">{st.values.note ?? ""}</textarea><span class="hint">Wajib diisi saat meminta revisi atau menolak.</span><FormError message={st.fields.note} /></div>
            <div class="stack" style="gap:0.6rem;">
              <button class="btn btn-primary" style="width:100%;justify-content:center;background:#16a34a;border-color:#16a34a;font-weight:600;" name="status" value="approved" type="button" data-confirm-open="dlg-approve">
                {a.type === "offer" ? "Setujui (Deal Iklan Sah)" : "Setujui Laporan (Valid)"}
              </button>
              <button class="btn btn-warn" style="width:100%;justify-content:center;font-weight:600;" name="status" value="revision" type="submit">
                Minta Perbaikan / Revisi Bukti
              </button>
              <button class="btn btn-danger" style="width:100%;justify-content:center;font-weight:600;" name="status" value="rejected" type="button" data-confirm-open="dlg-reject">
                {a.type === "offer" ? "Tolak (Penawaran Batal / NO)" : "Tolak Laporan (Tidak Valid)"}
              </button>
            </div>
          </form>

          <form method="post" action="/api/activities/delete" style="margin-top:0.75rem;" onsubmit="return confirm('PERINGATAN: Apakah Anda yakin ingin menghapus data laporan ini secara permanen dari sistem dan database Supabase? Tindakan ini tidak dapat dibatalkan.');">
            <input type="hidden" name="activityId" value={a.id} />
            <input type="hidden" name="back" value="/hrd/verifications" />
            <button type="submit" class="btn btn-secondary btn-sm" style="width:100%;justify-content:center;color:#dc2626;border-color:#fca5a5;">
              <Icon name="trash" size={14} />
              <span>Hapus Laporan Ini (Permanen)</span>
            </button>
          </form>
        </div></section>
      )}
      <section class="card"><div class="card-head"><h2>Riwayat verifikasi</h2></div><div class="card-body">
        {hist.length === 0 ? <p class="muted mb-0">Belum ada riwayat.</p> : <ol class="timeline">{hist.map((h) => <li><Badge status={h.status} /> <span class="text-xs muted">{dateTimeID(h.at)} · {employeeName(h.by)}</span><p class="text-sm mb-0">{h.note}</p></li>)}</ol>}
      </div></section>
    </div>
  </div>
  <ConfirmDialog id="dlg-approve" title="Setujui aktivitas ini?" confirmLabel="Ya, setujui"><p class="mb-0">Aktivitas akan dihitung ke realisasi KPI sesuai mapping.</p></ConfirmDialog>
  <ConfirmDialog id="dlg-reject" title="Tolak aktivitas ini?" confirmLabel="Ya, tolak" danger><p class="mb-0">Aktivitas ditolak tidak dihitung ke KPI. Pastikan catatan alasan sudah diisi.</p></ConfirmDialog>
  <script is:inline>
    const form = document.getElementById("vform");
    ["approve", "reject"].forEach((k) => {
      const d = document.getElementById("dlg-" + k); if (!d || !form) return;
      d.addEventListener("close", () => { if (d.returnValue === "ok") { const h = document.createElement("input"); h.type = "hidden"; h.name = "status"; h.value = k === "approve" ? "approved" : "rejected"; form.appendChild(h); form.submit(); } });
    });
  </script>
</DashboardLayout>

