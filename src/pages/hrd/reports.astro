---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import PageHeader from "../../components/layout/PageHeader.astro";
import PeriodFilter from "../../components/ui/PeriodFilter.astro";
import Icon from "../../components/ui/Icon.astro";
import Badge from "../../components/ui/Badge.astro";
import { db, divisionName, positions, employeeName, employee, client } from "../../lib/data/store";
import { achievements } from "../../features/kpi/achievements";
import { selectedPeriod } from "../../lib/utils/period";
import { rupiah, num, dateID, dateTimeID, TYPE_LABEL, STATUS_LABEL } from "../../lib/formatters";

const u = Astro.locals.user!;
if (!u || (u.role !== "admin" && u.role !== "hrd")) {
  return Astro.redirect("/login?next=/hrd/reports");
}

const p = selectedPeriod(Astro.url);
const acts = db.activities.filter((a) => a.periodId === p.id);
const ach = achievements(p.id);

// Urutkan aktivitas berdasarkan tanggal terbaru dan ID terbesar
const sortedActs = [...acts].sort(
  (a, b) => (b.date || "").localeCompare(a.date || "") || (b.id || "").localeCompare(a.id || "", undefined, { numeric: true })
);

// Metrik Status Administrasi Seluruh Berkas Periode Ini
const totalActsCount = sortedActs.length;
const approvedActsCount = sortedActs.filter((a) => a.status === "approved").length;
const pendingActsCount = sortedActs.filter((a) => a.status === "pending").length;
const revisionActsCount = sortedActs.filter((a) => a.status === "revision").length;
const rejectedActsCount = sortedActs.filter((a) => a.status === "rejected").length;
const approvalRate = totalActsCount > 0 ? ((approvedActsCount / totalActsCount) * 100).toFixed(1) : "0.0";

// Predikat Mutu Kinerja
const getPredikat = (score: number) => {
  if (score >= 85) return { label: "Sangat Baik", grade: "A", bg: "#dcfce7", color: "#15803d" };
  if (score >= 70) return { label: "Baik", grade: "B", bg: "#e0f2fe", color: "#0369a1" };
  if (score >= 55) return { label: "Cukup", grade: "C", bg: "#fef3c7", color: "#b45309" };
  return { label: "Kurang", grade: "D", bg: "#fee2e2", color: "#b91c1c" };
};

// Hanya staf pemasaran lapangan (role employee)
const employeeStaff = db.employees.filter((e) => e.role === "employee");

const rows = employeeStaff.map((e) => {
  const mine = acts.filter((a) => a.ownerId === e.id);
  const c = (s: string) => mine.filter((a) => a.status === s).length;
  const pr = ach.filter((r) => r.target.employeeId === e.id && r.percent != null);
  const pos = positions.find((pos) => pos.id === e.positionId)?.name ?? "Staf Pemasaran";

  const approvedActs = mine.filter((a) => a.status === "approved");
  const cashVal = approvedActs
    .filter((a) => a.type === "outcome" && a.outcome === "deal")
    .reduce((s, a) => s + (a.cashValue != null ? a.cashValue : (a.value || 0)), 0);
  const barterVal = approvedActs
    .filter((a) => (a.type === "outcome" && a.outcome === "deal" && (a.barterValue || 0) > 0) || a.type === "program")
    .reduce((s, a) => s + (a.barterValue != null ? a.barterValue : 0), 0);
  const soldOplah = approvedActs
    .filter((a) => a.type === "oplah")
    .reduce((s, a) => s + (a.soldQty != null ? a.soldQty : Math.max(0, (a.qty || 0) - (a.returnQty || 0))), 0);

  const avg = pr.length ? Math.round(pr.reduce((s, r) => s + Math.min(r.percent!, 100), 0) / pr.length) : 0;
  const predikat = getPredikat(avg);

  return {
    id: e.id,
    name: e.name,
    nip: e.nip || `RK-${e.id.slice(0, 4).toUpperCase()}`,
    position: pos,
    total: mine.length,
    approved: c("approved"),
    pending: c("pending"),
    revision: c("revision"),
    rejected: c("rejected"),
    cashVal,
    barterVal,
    soldOplah,
    avg,
    predikat,
  };
});

// Akumulasi agregat level divisi
const divApproved = acts.filter((a) => a.status === "approved");
const divCash = divApproved
  .filter((a) => a.type === "outcome" && a.outcome === "deal")
  .reduce((s, a) => s + (a.cashValue != null ? a.cashValue : (a.value || 0)), 0);
const divBarter = divApproved
  .filter((a) => (a.type === "outcome" && a.outcome === "deal" && (a.barterValue || 0) > 0) || a.type === "program")
  .reduce((s, a) => s + (a.barterValue != null ? a.barterValue : 0), 0);
const divSentOplah = divApproved
  .filter((a) => a.type === "oplah")
  .reduce((s, a) => s + (a.qty || 0), 0);
const divReturnOplah = divApproved
  .filter((a) => a.type === "oplah")
  .reduce((s, a) => s + (a.returnQty || 0), 0);
const divSoldOplah = divApproved
  .filter((a) => a.type === "oplah")
  .reduce((s, a) => s + (a.soldQty != null ? a.soldQty : Math.max(0, (a.qty || 0) - (a.returnQty || 0))), 0);
const divReturnRate = divSentOplah > 0 ? ((divReturnOplah / divSentOplah) * 100).toFixed(1) : "0.0";
const divAvgPercent = rows.length ? Math.round(rows.reduce((s, r) => s + r.avg, 0) / rows.length) : 0;

// Detail Data Berkas Laporan Lapangan
const actRows = sortedActs.map((a) => {
  const emp = employee(a.ownerId);
  const typeLabel = TYPE_LABEL[a.type] ?? a.type;
  let volumeDesc = "—";
  if (a.type === "oplah") {
    const s = a.soldQty != null ? a.soldQty : Math.max(0, (a.qty || 0) - (a.returnQty || 0));
    volumeDesc = `${num(s)} eks terjual (Kirim: ${num(a.qty || 0)}, Retur: ${num(a.returnQty || 0)})`;
  } else if (a.type === "outcome") {
    if (a.outcome === "deal") {
      const parts = [];
      if (a.cashValue || a.value) parts.push(`Kas: ${rupiah(a.cashValue || a.value || 0)}`);
      if (a.barterValue) parts.push(`Barter: ${rupiah(a.barterValue)}`);
      volumeDesc = parts.length ? parts.join(" + ") : "Deal Closing";
    } else {
      volumeDesc = "Belum Deal (Follow-up)";
    }
  } else if (a.type === "offer") {
    const val = (a.cashValue || 0) + (a.barterValue || 0) > 0 ? (a.cashValue || 0) + (a.barterValue || 0) : (a.value || 0);
    volumeDesc = `Nilai Ajuan: ${rupiah(val)}`;
  } else if (a.type === "client") {
    const cl = client(a.clientId);
    volumeDesc = cl ? `Mitra: ${cl.name} (${cl.city || "Kediri"})` : "Pendaftaran Klien";
  } else if (a.type === "profiling") {
    const cl = client(a.clientId);
    volumeDesc = cl ? `Riset Mitra: ${cl.name}` : "Riset Potensi Klien";
  } else if (a.type === "program") {
    volumeDesc = a.value ? `Nilai: ${rupiah(a.value)}` : "Program Event";
  }

  const proofUrl = a.proofUrl || a.evidence;

  return {
    ...a,
    ownerName: employeeName(a.ownerId),
    ownerNip: emp?.nip || "",
    typeLabel,
    volumeDesc,
    hasProof: Boolean(proofUrl && proofUrl.trim().length > 0),
    proofUrl: proofUrl || "",
  };
});

// Metrik Per Modul Operasional
const oplahActs = acts.filter((a) => a.type === "oplah");
const offerActs = acts.filter((a) => a.type === "offer");
const dealActs = acts.filter((a) => a.type === "outcome" && a.outcome === "deal");
const clientActs = acts.filter((a) => a.type === "client");
const profilingActs = acts.filter((a) => a.type === "profiling");

const activeTabParam = Astro.url.searchParams.get("tab") || "staf";
---

<DashboardLayout title="Rekapitulasi Laporan & Kinerja Divisi Pemasaran">
  <!-- Print Header Only -->
  <div class="print-only" style="display:none;margin-bottom:1.5rem;border-bottom:2px solid #0f172a;padding-bottom:1rem;">
    <h1 style="font-size:1.4rem;font-weight:800;color:#0f172a;margin:0 0 0.25rem;">PT RADAR KEDIRI — LAPORAN RESMI REKAPITULASI DIVISI PEMASARAN</h1>
    <p style="font-size:0.85rem;color:#475569;margin:0;">Periode Evaluasi Operasional: <strong>{p.name}</strong> · Dicetak oleh: <strong>{u.name} ({u.role.toUpperCase()})</strong></p>
  </div>

  <div class="no-print">
    <PageHeader
      title="Rekapitulasi Laporan & Kinerja Divisi Pemasaran"
      description={`Rekapitulasi berkas laporan operasional lapangan staf, status verifikasi HRD (Disetujui/Menunggu/Revisi/Ditolak), breakdown per modul, serta evaluasi capaian kinerja periode ${p.name}.`}
      crumbs={[{ label: "Admin Pemasaran" }, { label: "Rekapitulasi Laporan" }]}
    >
      <Fragment slot="actions">
        <PeriodFilter />
        <button type="button" class="btn btn-secondary" onclick="window.print()" title="Cetak lembar rekapitulasi ke format PDF atau printer">
          <Icon name="printer" size={15} />
          <span>Cetak Laporan</span>
        </button>
        <a class="btn btn-primary" href={`/api/export/excel?type=hrd&period=${p.id}`} download title="Unduh Rekapitulasi Operasional Lengkap Berstandar Excel (.xlsx)">
          <Icon name="download" size={15} />
          <span>Unduh Excel (.xlsx)</span>
        </a>
        <a class="btn btn-secondary" href={`/hrd/reports/export.csv?period=${p.id}`} title="Unduh File CSV Ringkas">
          <span>CSV</span>
        </a>
      </Fragment>
    </PageHeader>
  </div>

  <!-- ======================================================== -->
  <!-- BAGIAN 1: STAT BOX UTAMA (PILAR FINANSIAL & OPERASIONAL) -->
  <!-- ======================================================== -->
  <div class="stat-grid-4" style="margin-bottom: 1rem;">
    <div class="stat-box tone-kas">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;">
        <span class="stat-lbl">Omzet Kas Tunai Divisi</span>
        <span class="badge" style="background:#dcfce7;color:#15803d;font-size:0.7rem;font-weight:700;">IKLAN RIIL</span>
      </div>
      <span class="stat-val">{rupiah(divCash)}</span>
      <span class="stat-sub">Penerimaan kas sah deal iklan/advertorial</span>
    </div>

    <div class="stat-box tone-barter">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;">
        <span class="stat-lbl">Nilai Realisasi Barter</span>
        <span class="badge" style="background:#ede9fe;color:#6b21a8;font-size:0.7rem;font-weight:700;">PROMOSI</span>
      </div>
      <span class="stat-val">{rupiah(divBarter)}</span>
      <span class="stat-sub">Sponsorship barang/jasa promosi non-tunai</span>
    </div>

    <div class="stat-box tone-oplah">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;">
        <span class="stat-lbl">Oplah Bersih Terjual</span>
        <span class="badge" style="background:#e0f2fe;color:#0369a1;font-size:0.7rem;font-weight:700;">SIRKULASI</span>
      </div>
      <span class="stat-val">{num(divSoldOplah)} <small style="font-size:0.9rem;font-weight:600;">Eks</small></span>
      <span class="stat-sub">Total kirim {num(divSentOplah)} eks (Retur: {divReturnRate}%)</span>
    </div>

    <div class="stat-box tone-kpi">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;">
        <span class="stat-lbl">Rata-rata Capaian Divisi</span>
        <span class="badge" style="background:#f1f5f9;color:#334155;font-size:0.7rem;font-weight:700;">EVALUASI</span>
      </div>
      <span class="stat-val">{divAvgPercent}%</span>
      <span class="stat-sub">{employeeStaff.length} staf pemasaran dievaluasi</span>
    </div>
  </div>

  <!-- ======================================================== -->
  <!-- BAGIAN 2: RINGKASAN STATUS ADMINISTRASI VERIFIKASI BERKAS-->
  <!-- ======================================================== -->
  <div class="admin-summary-strip" style="margin-bottom: 1.5rem;">
    <div class="strip-card">
      <div class="strip-item">
        <span class="strip-title">Total Berkas Diajukan</span>
        <span class="strip-num">{totalActsCount}</span>
        <span class="strip-desc">Laporan masuk bulan ini</span>
      </div>
      <div class="strip-divider"></div>
      <div class="strip-item">
        <span class="strip-title" style="color:#15803d;">Disetujui HRD (Approved)</span>
        <span class="strip-num" style="color:#15803d;">{approvedActsCount} <small style="font-size:0.8rem;font-weight:600;">({approvalRate}%)</small></span>
        <span class="strip-desc">Sah dihitung ke target KPI</span>
      </div>
      <div class="strip-divider"></div>
      <div class="strip-item">
        <span class="strip-title" style="color:#b45309;">Menunggu Verifikasi</span>
        <span class="strip-num" style="color:#b45309;">{pendingActsCount}</span>
        <span class="strip-desc">Perlu diperiksa verifikator</span>
      </div>
      <div class="strip-divider"></div>
      <div class="strip-item">
        <span class="strip-title" style="color:#b91c1c;">Perlu Revisi / Ditolak</span>
        <span class="strip-num" style="color:#b91c1c;">{revisionActsCount + rejectedActsCount}</span>
        <span class="strip-desc">{revisionActsCount} revisi · {rejectedActsCount} ditolak</span>
      </div>
    </div>
  </div>

  <!-- ======================================================== -->
  <!-- BAGIAN 3: TAB NAVIGASI REKAPITULASI LENGKAP              -->
  <!-- ======================================================== -->
  <div class="report-nav-tabs-bar no-print">
    <button
      type="button"
      class={`report-tab-btn ${activeTabParam === "staf" ? "is-active" : ""}`}
      id="btn-tab-staf"
      onclick="window.switchReportTab('staf')"
    >
      <Icon name="users" size={16} />
      <span>Rekapitulasi Kinerja Individual Staf ({rows.length})</span>
    </button>
    <button
      type="button"
      class={`report-tab-btn ${activeTabParam === "berkas" ? "is-active" : ""}`}
      id="btn-tab-berkas"
      onclick="window.switchReportTab('berkas')"
    >
      <Icon name="clipboard" size={16} />
      <span>Daftar Seluruh Berkas Laporan ({sortedActs.length})</span>
    </button>
    <button
      type="button"
      class={`report-tab-btn ${activeTabParam === "modul" ? "is-active" : ""}`}
      id="btn-tab-modul"
      onclick="window.switchReportTab('modul')"
    >
      <Icon name="chart" size={16} />
      <span>Breakdown per Modul Operasional</span>
    </button>
  </div>

  <!-- ======================================================== -->
  <!-- TAB 1: REKAPITULASI CAPAIAN INDIVIDUAL STAF              -->
  <!-- ======================================================== -->
  <section class="tab-pane" id="pane-tab-staf" style={activeTabParam === "staf" ? "display:block;" : "display:none;"}>
    <div class="card table-card">
      <div class="card-head">
        <div>
          <h2>Rekapitulasi Capaian Individual Staf Pemasaran</h2>
          <p class="muted font-xs" style="margin: 0.15rem 0 0;">Monitoring kontribusi finansial, oplah sirkulasi, status approval, dan predikat evaluasi bulanan masing-masing personel.</p>
        </div>
        <span class="badge badge-info">{rows.length} Staf Terdata</span>
      </div>

      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th style="min-width: 180px;">Staf Pemasaran</th>
              <th style="text-align: right; width: 140px;">Kas Tunai</th>
              <th style="text-align: right; width: 140px;">Nilai Barter</th>
              <th style="text-align: right; width: 130px;">Oplah Bersih</th>
              <th style="text-align: center; width: 150px;">Status Berkas</th>
              <th style="width: 170px;">Capaian Rata-Rata</th>
              <th style="text-align: center; width: 120px;">Predikat</th>
              <th style="width: 100px; text-align: center;" class="no-print">Aksi</th>
            </tr>
          </thead>
          <tbody>
            {rows.length === 0 ? (
              <tr>
                <td colspan="8" style="text-align: center; padding: 3rem 1.5rem; color: var(--color-muted);">
                  Belum ada data staf pemasaran untuk periode {p.name}.
                </td>
              </tr>
            ) : (
              rows.map((r) => {
                const isSuccess = r.avg >= 85;
                const isGood = r.avg >= 70;
                const isWarning = r.avg >= 55;
                const barColor = isSuccess ? "#10b981" : isGood ? "#0284c7" : isWarning ? "#f59e0b" : "#ef4444";

                return (
                  <tr>
                    <td>
                      <div style="font-weight: 700; color: #0f172a;">{r.name}</div>
                      <div class="muted text-xs">NIP: {r.nip} · {r.position}</div>
                    </td>
                    <td style="text-align: right; font-weight: 700; color: #065f46;">
                      {r.cashVal > 0 ? rupiah(r.cashVal) : "—"}
                    </td>
                    <td style="text-align: right; font-weight: 700; color: #3730a3;">
                      {r.barterVal > 0 ? rupiah(r.barterVal) : "—"}
                    </td>
                    <td style="text-align: right; font-weight: 700; color: #0369a1;">
                      {r.soldOplah > 0 ? `${num(r.soldOplah)} eks` : "—"}
                    </td>
                    <td style="text-align: center;">
                      <div style="display:flex;justify-content:center;gap:0.35rem;font-size:0.75rem;">
                        <span class="badge-status-pill st-app" title={`${r.approved} berkas disetujui`}>{r.approved}</span>
                        <span class="badge-status-pill st-pen" title={`${r.pending} berkas menunggu verifikasi`}>{r.pending}</span>
                        <span class="badge-status-pill st-rev" title={`${r.revision + r.rejected} berkas revisi/ditolak`}>{r.revision + r.rejected}</span>
                      </div>
                    </td>
                    <td>
                      <div class="meter-wrapper">
                        <div class="meter-track">
                          <div class="meter-fill" style={`width: ${Math.min(r.avg, 100)}%; background-color: ${barColor};`}></div>
                        </div>
                        <span class="meter-pct font-bold" style={`color: ${barColor};`}>{r.avg}%</span>
                      </div>
                    </td>
                    <td style="text-align: center;">
                      <span class="badge" style={`background:${r.predikat.bg};color:${r.predikat.color};font-weight:700;font-size:0.75rem;padding:0.2rem 0.55rem;border-radius:4px;white-space:nowrap;`}>
                        {r.predikat.label} ({r.predikat.grade})
                      </span>
                    </td>
                    <td style="text-align: center;" class="no-print">
                      <a href={`/hrd/kpi/achievements?tab=individu&staff=${r.id}&period=${p.id}`} class="btn btn-secondary btn-xs" title="Lihat rincian rapor target KPI staf ini">
                        Rapor &rarr;
                      </a>
                    </td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ======================================================== -->
  <!-- TAB 2: DAFTAR SELURUH BERKAS LAPORAN LAPANGAN LENGKAP    -->
  <!-- ======================================================== -->
  <section class="tab-pane" id="pane-tab-berkas" style={activeTabParam === "berkas" ? "display:block;" : "display:none;"}>
    <!-- Filter Status & Pencarian Interaktif -->
    <div class="filter-controls-wrap no-print">
      <div class="filter-tabs-bar" id="report-act-filter-tabs">
        <button type="button" class="filter-tab is-active" data-status-filter="all">
          Semua ({totalActsCount})
        </button>
        <button type="button" class="filter-tab" data-status-filter="approved">
          Disetujui ({approvedActsCount})
        </button>
        <button type="button" class="filter-tab" data-status-filter="pending">
          Menunggu ({pendingActsCount})
        </button>
        {revisionActsCount > 0 && (
          <button type="button" class="filter-tab tab-warn" data-status-filter="revision">
            Perlu Revisi ({revisionActsCount})
          </button>
        )}
        {rejectedActsCount > 0 && (
          <button type="button" class="filter-tab tab-bad" data-status-filter="rejected">
            Ditolak ({rejectedActsCount})
          </button>
        )}
      </div>

      <div class="search-box-wrap">
        <input
          type="text"
          id="report-act-search-input"
          class="search-input"
          placeholder="Cari ID berkas, nama staf, kategori, atau deskripsi..."
          aria-label="Cari daftar seluruh berkas laporan"
        />
      </div>
    </div>

    <div class="card table-card">
      <div class="card-head">
        <div>
          <h2>Rekapitulasi Berkas Laporan Lapangan Masuk</h2>
          <p class="muted font-xs" style="margin: 0.15rem 0 0;">Daftar seluruh berkas kegiatan yang disubmit staf pemasaran pada periode {p.name} (Urutan Tanggal Terbaru &amp; ID Terbesar).</p>
        </div>
        <span class="badge badge-primary">{sortedActs.length} Berkas Tercatat</span>
      </div>

      <div class="table-responsive">
        <table class="data-table" id="table-all-reports">
          <thead>
            <tr>
              <th style="width: 110px;">ID Berkas</th>
              <th style="width: 110px;">Tanggal</th>
              <th style="width: 140px;">Kategori</th>
              <th style="width: 170px;">Staf Pelapor</th>
              <th>Rincian &amp; Deskripsi Laporan Lapangan</th>
              <th style="width: 180px; text-align: right;">Volume / Komersial</th>
              <th style="width: 110px; text-align: center;">Bukti Fisik</th>
              <th style="width: 120px; text-align: center;">Status</th>
              <th style="width: 110px; text-align: center;" class="no-print">Tindakan</th>
            </tr>
          </thead>
          <tbody>
            {actRows.length === 0 ? (
              <tr>
                <td colspan="9" style="text-align: center; padding: 3rem 1.5rem; color: var(--color-muted);">
                  Tidak ada laporan lapangan yang diajukan pada periode {p.name}.
                </td>
              </tr>
            ) : (
              actRows.map((a) => (
                <tr
                  class="act-row-item"
                  data-status={a.status}
                  data-search={`${a.id} ${a.ownerName} ${a.ownerNip} ${a.typeLabel} ${a.description} ${a.volumeDesc}`.toLowerCase()}
                >
                  <td>
                    <span class="mono-id">{a.id}</span>
                  </td>
                  <td>
                    <span class="date-txt">{dateID(a.date)}</span>
                  </td>
                  <td>
                    <span class={`type-pill-badge type-${a.type}`}>
                      {a.typeLabel}
                    </span>
                  </td>
                  <td>
                    <div style="font-weight: 700; color: #0f172a;">{a.ownerName}</div>
                    <div class="muted text-xs">NIP: {a.ownerNip}</div>
                  </td>
                  <td>
                    <div style="font-weight: 600; color: #1e293b; margin-bottom: 0.15rem;">{a.description}</div>
                    {a.type === "oplah" && a.editionName && (
                      <div class="muted text-xs">Edisi: {a.editionName} · Kanal: {a.source || "Agen"} ({a.sourceName || "—"})</div>
                    )}
                  </td>
