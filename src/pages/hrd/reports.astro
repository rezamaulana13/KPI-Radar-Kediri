---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import ListPage from "../../components/ui/ListPage.astro";
import PeriodFilter from "../../components/ui/PeriodFilter.astro";
import { db, divisionName, divisions } from "../../lib/data/store";
import { achievements } from "../../features/kpi/achievements";
import { selectedPeriod } from "../../lib/utils/period";
const p = selectedPeriod(Astro.url);
const acts = db.activities.filter((a) => a.periodId === p.id);
const ach = achievements(p.id);
// Filter: Hanya tampilkan staf pemasaran (role employee), Super Admin dan HRD tidak masuk tabel penilaian kerja lapangan
const employeeStaff = db.employees.filter((e) => e.role === "employee");

const rows = employeeStaff.map((e) => {
  const mine = acts.filter((a) => a.ownerId === e.id);
  const c = (s: string) => mine.filter((a) => a.status === s).length;
  const pr = ach.filter((r) => r.target.employeeId === e.id && r.percent != null);
  return {
    id: e.id,
    name: e.name,
    divisionId: e.divisionId,
    division: "Divisi Pemasaran & Sirkulasi",
    total: mine.length,
    approved: c("approved"),
    pending: c("pending"),
    revision: c("revision"),
    rejected: c("rejected"),
    avg: pr.length ? pr.reduce((s, r) => s + Math.min(r.percent!, 100), 0) / pr.length : 0,
  };
});
---
<DashboardLayout title="Rekapitulasi Laporan Bulanan">
  <ListPage title="Rekapitulasi Kinerja Divisi Pemasaran" description={`Rekapitulasi pengajuan aktivitas lapangan oleh staf marketing, verifikasi HRD (Disetujui/Revisi/Ditolak), dan persentase capaian target untuk periode ${p.name}.`} crumbs={[{ label: "HRD" }, { label: "Laporan Bulanan" }]} rows={rows} searchKeys={["name"]}
    columns={[{ key: "name", label: "Staf Pemasaran" }, { key: "division", label: "Divisi" }, { key: "total", label: "Total Diajukan", type: "number" }, { key: "pending", label: "Menunggu HRD", type: "number" }, { key: "approved", label: "Disetujui (Diterima)", type: "number" }, { key: "revision", label: "Perlu Revisi", type: "number" }, { key: "rejected", label: "Ditolak", type: "number" }, { key: "avg", label: "Capaian Rata-Rata", type: "meter" }]}>
    <Fragment slot="actions">
      <PeriodFilter />
      <a class="btn btn-primary" href={`/api/export/excel?type=hrd&period=${p.id}`} download title="Unduh Rekapitulasi Operasional Lengkap (Excel .xlsx)">Unduh Excel (.xlsx)</a>
      <a class="btn btn-secondary" href={`/hrd/reports/export.csv?period=${p.id}`}>Unduh CSV</a>
    </Fragment>
  </ListPage>
</DashboardLayout>
