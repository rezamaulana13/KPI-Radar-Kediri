<!-- Client Script untuk Navigasi Tab & Live Search Berkas -->
<script is:inline>
  window.switchReportTab = function(tabName) {
    var panes = document.querySelectorAll(".tab-pane");
    panes.forEach(function(p) { p.style.display = "none"; });

    var btns = document.querySelectorAll(".report-tab-btn");
    btns.forEach(function(b) { b.classList.remove("is-active"); });

    var targetPane = document.getElementById("pane-tab-" + tabName);
    var targetBtn = document.getElementById("btn-tab-" + tabName);
    if (targetPane) targetPane.style.display = "block";
    if (targetBtn) targetBtn.classList.add("is-active");

    // Update URL parameter tanpa reload
    var url = new URL(window.location.href);
    url.searchParams.set("tab", tabName);
    window.history.replaceState({}, "", url.toString());
  };

  // Live Filter & Search pada Tab Daftar Berkas Laporan
  document.addEventListener("DOMContentLoaded", function() {
    var filterTabs = document.querySelectorAll("#report-act-filter-tabs .filter-tab");
    var searchInput = document.getElementById("report-act-search-input");
    var rows = document.querySelectorAll("#table-all-reports .act-row-item");

    var currentFilter = "all";
    var currentQuery = "";

    function applyFilterAndSearch() {
      rows.forEach(function(row) {
        var status = row.getAttribute("data-status");
        var searchData = row.getAttribute("data-search") || "";
        var matchFilter = currentFilter === "all" || status === currentFilter;
        var matchSearch = !currentQuery || searchData.indexOf(currentQuery) !== -1;

        if (matchFilter && matchSearch) {
          row.style.display = "";
        } else {
          row.style.display = "none";
        }
      });
    }

    filterTabs.forEach(function(tab) {
      tab.addEventListener("click", function() {
        filterTabs.forEach(function(t) { t.classList.remove("is-active"); });
        this.classList.add("is-active");
        currentFilter = this.getAttribute("data-status-filter") || "all";
        applyFilterAndSearch();
      });
    });

    if (searchInput) {
      searchInput.addEventListener("input", function() {
        currentQuery = this.value.toLowerCase().trim();
        applyFilterAndSearch();
      });
    }
  });
</script>

