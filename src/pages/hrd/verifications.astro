---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import ListPage from "../../components/ui/ListPage.astro";
import Alert from "../../components/ui/Alert.astro";
import { db, employeeName } from "../../lib/data/store";
import { canVerify } from "../../features/verification/rules";
import { TYPE_LABEL, STATUS_LABEL } from "../../lib/formatters";

const u = Astro.locals.user!;
const rows = db.activities.filter((a) => a.status === "pending").sort((a, b) => a.date.localeCompare(b.date)).map((a) => {
  const c = canVerify(u, a, db.employees);
  return { ...a, owner: employeeName(a.ownerId), creator: employeeName(a.createdBy), typeLabel: TYPE_LABEL[a.type], note: c.ok ? "Siap diperiksa" : c.reason, action: c.ok ? "Periksa" : "Tidak dapat" };
});
const done = Astro.url.searchParams.get("done");
const as = Astro.url.searchParams.get("as");
const deleted = Astro.url.searchParams.get("deleted");
---
<DashboardLayout title="Antrean Verifikasi Berkas">
  <ListPage title="Antrean Verifikasi Berkas Lapangan" description="Daftar laporan kerja dan bukti nota yang diajukan oleh staf pemasaran & sirkulasi. Periksa bukti fisik lalu tentukan apakah disetujui (Deal), diminta revisi, atau ditolak." crumbs={[{ label: "HRD" }, { label: "Antrean Verifikasi" }]} rows={rows} searchKeys={["owner", "description", "id"]}
    filters={[{ name: "type", label: "Jenis Aktivitas", options: Object.entries(TYPE_LABEL).map(([value, label]) => ({ value, label })) }]}
    columns={[{ key: "id", label: "ID Berkas", type: "mono", href: (r) => r.action === "Periksa" ? `/hrd/verifications/${r.id}` : undefined }, { key: "date", label: "Tanggal", type: "date" }, { key: "typeLabel", label: "Jenis Kegiatan" }, { key: "owner", label: "Staf Pemasaran" }, { key: "description", label: "Rincian Kegiatan" }, { key: "note", label: "Status Verifikasi" }]}
    emptyTitle="Antrean Bersih / Kosong" emptyHint="Tidak ada laporan kegiatan yang menunggu verifikasi saat ini. Semua berkas telah diperiksa.">
    {done && <Alert slot="before" tone="success" title={`Aktivitas ${done} Berhasil Diproses`}>Keputusan verifikasi telah tersimpan dan tercatat di riwayat operasional serta database.</Alert>}
    {deleted && <Alert slot="before" tone="success" title="Laporan Berhasil Dihapus">Laporan aktivitas {deleted} telah berhasil dihapus secara permanen dari antrean dan database Supabase.</Alert>}
  </ListPage>
</DashboardLayout>

