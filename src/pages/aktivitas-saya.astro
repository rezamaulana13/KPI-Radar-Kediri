---
import PublicLayout from "../layouts/PublicLayout.astro";
import Icon from "../components/ui/Icon.astro";
import Badge from "../components/ui/Badge.astro";
import Alert from "../components/ui/Alert.astro";
import { db, activePeriod, activitiesFor, historyOf } from "../lib/data/store";
import { dateID, num, rupiah, TYPE_LABEL, STATUS_LABEL } from "../lib/formatters";

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/login?next=/aktivitas-saya");
}

const p = activePeriod();
const mine = activitiesFor({ id: user.id, role: user.role })
  .filter((a) => a.periodId === p.id && (a.ownerId === user.id || a.createdBy === user.id))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const count = (s: string) => mine.filter((a) => a.status === s).length;
const approvedCount = count("approved");
const pendingCount = count("pending");
const revisionCount = count("revision");
const rejectedCount = count("rejected");
const created = Astro.url.searchParams.get("created");
---

<PublicLayout
  title="Aktivitas Saya"
  activeNav="aktivitas-saya"
  description="Daftar riwayat pencatatan aktivitas, progres kerja lapangan, dan status verifikasi berkas oleh HRD."
>
  <div class="pub-page-container">
    <!-- Breadcrumb -->
    <nav class="pub-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Beranda</a>
      <span class="sep">/</span>
      <span class="current">Aktivitas Saya</span>
    </nav>

    <!-- Header Halaman -->
    <div class="pub-page-header">
      <div class="header-main">
        <span class="header-tag">RIWAYAT &amp; STATUS VERIFIKASI</span>
        <h1>Aktivitas Lapangan Saya</h1>
        <p class="header-desc">
          Pantau seluruh kegiatan yang Anda laporkan di periode <strong>{p.name}</strong>. Cek apakah berkas Anda sudah disetujui, sedang diperiksa, atau perlu revisi bukti.
        </p>
      </div>
      <div class="header-actions" style="display:flex;align-items:center;gap:0.6rem;flex-wrap:wrap;">
        <a href={`/api/export/excel?type=employee&period=${p.id}`} class="btn btn-secondary" download title="Ekspor seluruh log aktivitas bulanan ke format Excel">
          <Icon name="download" size={16} />
          <span>Ekspor Excel</span>
        </a>
        <a href="/catat-aktivitas" class="btn btn-primary">
          <Icon name="plus" size={16} />
          <span>Catat Aktivitas Baru</span>
        </a>
      </div>
    </div>

    {created && (
      <div class="alert-box alert-success" style="margin-bottom: 1.5rem;">
        <Icon name="check" size={20} />
        <div>
          <strong>Aktivitas {created} Berhasil Disimpan!</strong>
          <p style="margin: 0.2rem 0 0; font-size: var(--text-sm);">
            Laporan Anda saat ini berada dalam status <em>Menunggu Verifikasi</em> oleh HRD.
          </p>
        </div>
      </div>
    )}

    <!-- Bar Statistik Ringkas -->
    <div class="stat-grid-4">
      <div class="stat-box">
        <span class="stat-val">{mine.length}</span>
        <span class="stat-lbl">Total Laporan</span>
        <span class="stat-sub">Periode {p.name}</span>
      </div>
      <div class="stat-box tone-ok">
        <span class="stat-val">{approvedCount}</span>
        <span class="stat-lbl">Disetujui HRD</span>
        <span class="stat-sub">Dihitung ke skor KPI</span>
      </div>
      <div class="stat-box tone-warn">
        <span class="stat-val">{pendingCount}</span>
        <span class="stat-lbl">Menunggu Verifikasi</span>
        <span class="stat-sub">Dalam antrean HRD</span>
      </div>
      <div class="stat-box tone-bad">
        <span class="stat-val">{revisionCount + rejectedCount}</span>
        <span class="stat-lbl">Perlu Revisi / Ditolak</span>
        <span class="stat-sub">{revisionCount > 0 ? `${revisionCount} perlu perbaikan` : "Tidak ada revisi"}</span>
      </div>
    </div>

    <!-- Filter Tabs Status -->
    <div class="filter-tabs-bar">
      <button type="button" class="filter-tab is-active" data-filter="all">
        Semua ({mine.length})
      </button>
      <button type="button" class="filter-tab" data-filter="pending">
        Menunggu ({pendingCount})
      </button>
      <button type="button" class="filter-tab" data-filter="approved">
        Disetujui ({approvedCount})
      </button>
      {revisionCount > 0 && (
        <button type="button" class="filter-tab tab-warn" data-filter="revision">
          Perlu Revisi ({revisionCount})
        </button>
      )}
      {rejectedCount > 0 && (
        <button type="button" class="filter-tab tab-bad" data-filter="rejected">
          Ditolak ({rejectedCount})
        </button>
      )}
    </div>

    <!-- Tabel Data Aktivitas -->
    <div class="card table-card">
      {mine.length === 0 ? (
        <div class="empty-state">
          <div class="empty-icon"><Icon name="clipboard" size={40} /></div>
          <h3>Belum Ada Laporan Aktivitas</h3>
          <p>Anda belum mencatat kegiatan lapangan untuk periode {p.name}. Mulai dengan menambahkan aktivitas baru.</p>
          <a href="/catat-aktivitas" class="btn btn-primary" style="margin-top: 1rem;">
            <Icon name="plus" size={16} />
            <span>Catat Aktivitas Sekarang</span>
          </a>
        </div>
      ) : (
        <div class="table-responsive">
          <table class="data-table" id="table-user-activities">
            <thead>
              <tr>
                <th style="width: 110px;">ID</th>
                <th style="width: 120px;">Tanggal</th>
                <th style="width: 140px;">Jenis Kegiatan</th>
                <th>Rincian &amp; Deskripsi Pekerjaan</th>
                <th style="width: 130px;">Status</th>
                <th style="width: 110px; text-align: center;">Aksi</th>
              </tr>
            </thead>
            <tbody>
              {mine.map((a) => (
                <tr data-status={a.status}>
                  <td>
                    <span class="mono-id">{a.id}</span>
                  </td>
                  <td>
                    <span class="date-txt">{dateID(a.date)}</span>
                  </td>
                  <td>
                    <span class={`type-pill-badge type-${a.type}`}>
                      {TYPE_LABEL[a.type] ?? a.type}
                    </span>
                  </td>
                  <td>
                    <div class="desc-cell">
                      <p class="desc-main">{a.description}</p>
                      <div class="payload-chips">
                        {a.qty && <span class="chip">Oplah: <strong>{num(a.qty)} eks</strong></span>}
                        {a.sourceName && <span class="chip">Penerima/Sumber: <strong>{a.sourceName}</strong></span>}
                        {a.value && <span class="chip">Nilai: <strong>{rupiah(a.value)}</strong></span>}
                        {a.progressType && <span class="chip">Progres: <strong>{a.progressType}</strong></span>}
                        {a.potential && <span class="chip">Potensi: <strong>{a.potential}</strong></span>}
                        {a.outcome && <span class="chip">Hasil: <strong>{a.outcome === "deal" ? "Deal Closing" : "Belum Deal"}</strong></span>}
                      </div>
                      {historyOf(a.id).at(-1)?.note && (a.status === "revision" || a.status === "rejected") && (
                        <div class="note-box">
                          <Icon name="alert-triangle" size={13} />
                          <span><strong>Catatan HRD:</strong> {historyOf(a.id).at(-1)?.note}</span>
                        </div>
                      )}
                    </div>
                  </td>
                  <td>
                    <span class={`status-badge st-${a.status}`}>
                      <span class="badge-dot"></span>
                      <span>{STATUS_LABEL[a.status] ?? a.status}</span>
                    </span>
                  </td>
                  <td style="text-align: center;">
                    <a href={`/employee/activities/${a.id}`} class="btn btn-secondary btn-xs" title="Lihat detail lengkap">
                      <span>Rincian &rarr;</span>
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </div>
</PublicLayout>

<!-- Client Script untuk Filter Status -->
<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    const tabs = document.querySelectorAll(".filter-tabs-bar .filter-tab");
    const rows = document.querySelectorAll("#table-user-activities tbody tr");

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        tabs.forEach((t) => t.classList.remove("is-active"));
        tab.classList.add("is-active");

        const f = tab.dataset.filter;
        rows.forEach((r) => {
          if (f === "all" || r.dataset.status === f) {
            r.style.display = "";
          } else {
            r.style.display = "none";
          }
        });
      });
    });
  });
</script>

<style>
  .pub-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-xs);
    color: var(--color-muted);
    margin-bottom: 1.25rem;
  }

  .pub-breadcrumb a {
    color: var(--color-primary-800);
    text-decoration: none;
    font-weight: 550;
  }

  .pub-breadcrumb a:hover {
    text-decoration: underline;
  }

  .pub-breadcrumb .sep {
    color: #cbd5e1;
  }

  .pub-breadcrumb .current {
    color: #475569;
    font-weight: 600;
  }

  .pub-page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .header-tag {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--color-primary-800);
    background: var(--color-primary-100);
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .pub-page-header h1 {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-primary-900);
    margin: 0 0 0.5rem;
  }

  .header-desc {
    font-size: var(--text-sm);
    color: #475569;
    max-width: 48rem;
    line-height: 1.6;
    margin: 0;
  }

  /* Grid 4 Stat Box */
  .stat-grid-4 {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  @media (max-width: 860px) {
    .stat-grid-4 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .stat-grid-4 {
      grid-template-columns: 1fr;
    }
  }

  .stat-box {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    border-left: 4px solid var(--color-primary-800);
  }

  .stat-box.tone-ok { border-left-color: #10b981; }
  .stat-box.tone-warn { border-left-color: #f59e0b; }
  .stat-box.tone-bad { border-left-color: #ef4444; }

  .stat-val {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-primary-900);
    line-height: 1;
    margin-bottom: 0.35rem;
  }

  .tone-ok .stat-val { color: #047857; }
  .tone-warn .stat-val { color: #b45309; }
  .tone-bad .stat-val { color: #b91c1c; }

  .stat-lbl {
    font-size: var(--text-xs);
    font-weight: 700;
    color: #334155;
    margin-bottom: 0.15rem;
  }

  .stat-sub {
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  /* Filter Tabs Bar */
  .filter-tabs-bar {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .filter-tab {
    padding: 0.45rem 0.95rem;
    background: #f1f5f9;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    font-weight: 600;
    color: #475569;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .filter-tab:hover {
    background: #e2e8f0;
    color: var(--color-primary-900);
  }

  .filter-tab.is-active {
    background: var(--color-primary-900);
    color: #ffffff;
    border-color: var(--color-primary-900);
  }

  .filter-tab.tab-warn { color: #b45309; }
  .filter-tab.tab-warn.is-active { background: #d97706; border-color: #d97706; color: #fff; }

  .filter-tab.tab-bad { color: #b91c1c; }
  .filter-tab.tab-bad.is-active { background: #dc2626; border-color: #dc2626; color: #fff; }

  /* Table Card */
  .table-card {
    background: #ffffff;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .table-responsive {
    overflow-x: auto;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    text-align: left;
  }

  .data-table th {
    background: #f8fafc;
    padding: 0.85rem 1rem;
    font-size: var(--text-xs);
    font-weight: 700;
    color: #475569;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--color-border);
  }

  .data-table td {
    padding: 0.95rem 1rem;
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
  }

  .data-table tbody tr:hover {
    background: #fafbfd;
  }

  .mono-id {
    font-family: monospace;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-primary-800);
    background: #f1f5f9;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
  }

  .date-txt {
    font-size: var(--text-xs);
    color: #475569;
    font-weight: 550;
    white-space: nowrap;
  }

  .type-pill-badge {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .type-oplah { background: #e0f2fe; color: #0369a1; }
  .type-client { background: #dbeafe; color: #1d4ed8; }
  .type-offer { background: #f3e8ff; color: #7e22ce; }
  .type-progress { background: #e0e7ff; color: #4338ca; }
  .type-profiling { background: #fef3c7; color: #b45309; }
  .type-program { background: #ccfbf1; color: #0f766e; }
  .type-outcome { background: #dcfce7; color: #15803d; }

  .desc-cell {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .desc-main {
    margin: 0;
    font-size: var(--text-sm);
    color: #1e293b;
    line-height: 1.5;
  }

  .payload-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .chip {
    font-size: 0.6875rem;
    background: #f1f5f9;
    color: #475569;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
    border: 1px solid #e2e8f0;
  }

  .note-box {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-xs);
    background: #fef2f2;
    color: #b91c1c;
    border: 1px dashed #fca5a5;
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-sm);
  }

  /* Status Badges */
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .st-approved { background: #dcfce7; color: #15803d; }
  .st-approved .badge-dot { background: #16a34a; }

  .st-pending { background: #fef3c7; color: #b45309; }
  .st-pending .badge-dot { background: #d97706; }

  .st-revision { background: #fee2e2; color: #b91c1c; }
  .st-revision .badge-dot { background: #dc2626; }

  .st-rejected { background: #f1f5f9; color: #64748b; }
  .st-rejected .badge-dot { background: #94a3b8; }

  .btn-xs {
    padding: 0.3rem 0.65rem;
    font-size: var(--text-xs);
  }

  /* Empty State */
  .empty-state {
    padding: 4rem 2rem;
    text-align: center;
    max-width: 28rem;
    margin: 0 auto;
  }

  .empty-icon {
    color: #94a3b8;
    margin-bottom: 1rem;
  }

  .empty-state h3 {
    font-size: 1.25rem;
    color: var(--color-primary-900);
    margin: 0 0 0.5rem;
  }

  .empty-state p {
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin: 0;
    line-height: 1.6;
  }

  .alert-box {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-sm);
  }

  .alert-success {
    background: #ecfdf5;
    border: 1px solid #10b981;
    color: #065f46;
  }
</style>

