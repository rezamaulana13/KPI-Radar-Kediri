---
import PublicLayout from "../layouts/PublicLayout.astro";
import Icon from "../components/ui/Icon.astro";
import Badge from "../components/ui/Badge.astro";
import Alert from "../components/ui/Alert.astro";
import PeriodFilter from "../components/ui/PeriodFilter.astro";
import { db, activePeriod, activitiesFor, employee, divisionName, positionName, historyOf } from "../lib/data/store";
import { achievements, ensureEmployeeTargets, contribution } from "../features/kpi/achievements";
import { selectedPeriod } from "../lib/utils/period";
import { dateID, num, rupiah, TYPE_LABEL, STATUS_LABEL } from "../lib/formatters";

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/login?next=/aktivitas-saya");
}

const p = selectedPeriod(Astro.url);
const emp = employee(user.id);
const mine = activitiesFor({ id: user.id, role: user.role })
  .filter((a) => a.periodId === p.id && (a.ownerId === user.id || a.createdBy === user.id))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const count = (s: string) => mine.filter((a) => a.status === s).length;
const approvedCount = count("approved");
const pendingCount = count("pending");
const revisionCount = count("revision");
const rejectedCount = count("rejected");
const created = Astro.url.searchParams.get("created");

// KPI & Target Capaian Real-Time (Maks 100%)
ensureEmployeeTargets(user.id, p.id);
const allRows = achievements(p.id);
const myTargets = allRows.filter((r) => r.target.scope === "individual" && r.target.employeeId === user.id);
const divTargets = allRows.filter((r) => r.target.scope === "division" && (r.target.divisionId === emp?.divisionId || r.target.divisionId === "DIV-MKT"));

// Hitung Indeks Kinerja Terbobot (Rata-rata Capaian Target Individu, Maksimal 100%)
const measurable = myTargets.filter((r) => r.percent != null);
const avgPercent = measurable.length
  ? Math.min(100, Math.round(measurable.reduce((s, r) => s + Math.min(r.percent!, 100), 0) / measurable.length))
  : 0;

// Status Progres Real-Time Karyawan
const progressStatusText = avgPercent >= 100 ? "Tercapai Penuh (100%)" : avgPercent > 0 ? `In Progress (${avgPercent}%)` : "Belum Ada Realisasi (0%)";
const progressBadgeBg = avgPercent >= 100 ? "#d1fae5" : avgPercent > 0 ? "#e0f2fe" : "#f1f5f9";
const progressBadgeColor = avgPercent >= 100 ? "#065f46" : avgPercent > 0 ? "#0284c7" : "#64748b";
const progressDotColor = avgPercent >= 100 ? "#10b981" : avgPercent > 0 ? "#0284c7" : "#94a3b8";

// Penetapan Predikat Evaluasi Kinerja
let predikat = {
  grade: "D",
  label: "Kurang",
  color: "#ef4444",
  badgeBg: "#fee2e2",
  badgeColor: "#991b1b",
  desc: "Capaian target kinerja di bawah 55%. Diperlukan percepatan penutupan deal atau perluasan sebaran sirkulasi.",
};
if (avgPercent >= 85) {
  predikat = {
    grade: "A",
    label: "Sangat Baik",
    color: "#10b981",
    badgeBg: "#d1fae5",
    badgeColor: "#065f46",
    desc: "Performa luar biasa! Konsistensi dan kontribusi operasional melampaui standar target periode ini.",
  };
} else if (avgPercent >= 70) {
  predikat = {
    grade: "B",
    label: "Baik",
    color: "#0284c7",
    badgeBg: "#e0f2fe",
    badgeColor: "#075985",
    desc: "Kinerja stabil dan memenuhi seluruh standar target operasional utama divisi.",
  };
} else if (avgPercent >= 55) {
  predikat = {
    grade: "C",
    label: "Cukup",
    color: "#f59e0b",
    badgeBg: "#fef3c7",
    badgeColor: "#92400e",
    desc: "Sebagian target telah tercapai, optimalkan follow-up proposal penawaran untuk meningkatkan skor.",
  };
}

// 4 Metrik Operasional SIMOKP Karyawan (Selalu dikonversi ke Number agar kalkulasi multi-aktivitas akurat)
const approvedActs = mine.filter((a) => a.status === "approved");
const userCash = approvedActs
  .filter((a) => a.type === "outcome" && a.outcome === "deal")
  .reduce((s, a) => s + Number(a.cashValue != null ? a.cashValue : (a.value || 0)), 0);
const userBarter = approvedActs
  .filter((a) => (a.type === "outcome" && a.outcome === "deal" && (a.barterValue || 0) > 0) || a.type === "program")
  .reduce((s, a) => s + Number(a.barterValue != null ? a.barterValue : 0), 0);
const userSentOplah = approvedActs
  .filter((a) => a.type === "oplah")
  .reduce((s, a) => s + Number(a.qty || 0), 0);
const userReturnOplah = approvedActs
  .filter((a) => a.type === "oplah")
  .reduce((s, a) => s + Number(a.returnQty || 0), 0);
const userSoldOplah = approvedActs
  .filter((a) => a.type === "oplah")
  .reduce((s, a) => s + Number(a.soldQty != null ? a.soldQty : Math.max(0, (Number(a.qty) || 0) - (Number(a.returnQty) || 0))), 0);
const userReturnRate = userSentOplah > 0 ? ((userReturnOplah / userSentOplah) * 100).toFixed(1) : "0.0";

const formatVal = (val: number | null | undefined, unit: string) => {
  if (val == null) return "—";
  if (unit === "Rp" || unit.toLowerCase().includes("rupiah")) return rupiah(val);
  return `${num(val)} ${unit}`;
};

function getActionLink(indicator: { id?: string; code?: string; name?: string }) {
  const code = (indicator.code || "").toUpperCase();
  const id = (indicator.id || "").toUpperCase();
  const name = (indicator.name || "").toLowerCase();

  if (id === "IND-01" || code === "OPL" || name.includes("oplah")) {
    return { label: "+ Input Oplah", href: "/marketing/oplah?action=new", icon: "news" };
  }
  if (id === "IND-02" || code === "CLN" || name.includes("client") || name.includes("klien")) {
    return { label: "+ Tambah Klien", href: "/marketing/clients?action=new", icon: "building" };
  }
  if (id === "IND-03" || code === "PNW" || name.includes("penawaran") || name.includes("proposal")) {
    return { label: "+ Buat Proposal", href: "/marketing/offers?action=new", icon: "folder" };
  }
  if (id === "IND-04" || code === "DEA" || name.includes("deal") || name.includes("closing")) {
    return { label: "+ Catat Closing", href: "/marketing/offers?action=new", icon: "check" };
  }
  if (id === "IND-05" || code === "OMZ" || name.includes("omzet") || name.includes("kas tunai")) {
    return { label: "+ Catat Omzet", href: "/marketing/offers?action=new", icon: "folder" };
  }
  if (id === "IND-07" || code === "BAR" || name.includes("barter")) {
    return { label: "+ Input Barter", href: "/marketing/programs?action=new", icon: "handshake" };
  }
  if (id === "IND-08" || code === "KNJ" || name.includes("kunjungan") || name.includes("prospek")) {
    return { label: "+ Catat Kunjungan", href: "/marketing/profiling?action=new", icon: "users" };
  }
  return { label: "+ Input Progres", href: "/modul-marketing", icon: "plus" };
}
---

<PublicLayout
  title="Aktivitas Lapangan & Rapor Kinerja · SIMOKP"
  activeNav="aktivitas-saya"
  description="Daftar riwayat aktivitas lapangan, evaluasi progres target individu, capaian sasaran tim divisi, dan rapor kinerja SIMOKP."
>
  <div class="pub-page-container">
    <!-- Breadcrumb -->
    <nav class="pub-breadcrumb no-print" aria-label="Breadcrumb">
      <a href="/">Beranda</a>
      <span class="sep">/</span>
      <span class="current">Aktivitas &amp; Rapor Kinerja</span>
    </nav>

    <!-- Header Halaman -->
    <div class="pub-page-header">
      <div class="header-main">
        <span class="header-tag">OPERASIONAL &amp; EVALUASI KINERJA</span>
        <h1>Aktivitas &amp; Rapor Kinerja Saya</h1>
        <p class="header-desc">
          Pantau seluruh progres pelaporan lapangan, rincian target individu, sasaran kinerja tim divisi, dan evaluasi capaian periode <strong>{p.name}</strong> yang telah diverifikasi sah oleh HRD.
        </p>
      </div>
      <div class="header-actions no-print" style="display:flex;align-items:center;gap:0.6rem;flex-wrap:wrap;">
        <PeriodFilter />
        <button type="button" class="btn btn-secondary btn-sm" onclick="window.print()" title="Cetak Rapor Kinerja">
          <Icon name="printer" size={15} />
          <span>Cetak</span>
        </button>
        <a href={`/api/export/excel?type=employee&period=${p.id}`} class="btn btn-secondary btn-sm" download title="Ekspor seluruh log aktivitas bulanan ke format Excel">
          <Icon name="download" size={15} />
          <span>Ekspor Excel</span>
        </a>
        <a href="/modul-marketing" class="btn btn-primary btn-sm">
          <Icon name="plus" size={15} />
          <span>Input via Modul</span>
        </a>
      </div>
    </div>

    {created && (
      <div class="alert-box alert-success" style="margin-bottom: 1.5rem;">
        <Icon name="check" size={20} />
        <div>
          <strong>Aktivitas {created} Berhasil Disimpan!</strong>
          <p style="margin: 0.2rem 0 0; font-size: var(--text-sm);">
            Laporan Anda saat ini berada dalam status <em>Menunggu Verifikasi</em> oleh HRD.
          </p>
        </div>
      </div>
    )}

    <!-- ======================================================== -->
    <!-- BAGIAN 1: RAPOR SKOR KPI & 4 METRIK OPERASIONAL UTAMA   -->
    <!-- ======================================================== -->
    <div class="kpi-score-overview" style="margin-bottom: 1.5rem;">
      <!-- Panel Indeks Prestasi KPI -->
      <div class="kpi-grade-box">
        <div class="grade-circle" style={`border-color: ${predikat.color};`}>
          <span class="grade-pct" style={`color: ${predikat.color};`}>{avgPercent}%</span>
          <span class="grade-caption">CAPAIAN</span>
        </div>
        <div class="grade-info">
          <div class="grade-badges-row">
            <span class="grade-progress-pill" style={`background-color: ${progressBadgeBg}; color: ${progressBadgeColor};`}>
              <span class="pulse-dot" style={`background-color: ${progressDotColor};`}></span>
              {progressStatusText}
            </span>
            <span class="grade-badge" style={`background-color: ${predikat.badgeBg}; color: ${predikat.badgeColor};`}>
              Predikat: {predikat.label} ({predikat.grade})
            </span>
          </div>
          <p class="grade-desc">{predikat.desc}</p>
          <div class="grade-meter-row">
            <div class="grade-meter-track">
              <div class="grade-meter-fill" style={`width: ${avgPercent}%; background-color: ${predikat.color};`}></div>
            </div>
            <span class="grade-meter-note">{avgPercent}% dari 100% target</span>
          </div>
        </div>
      </div>

      <!-- 4 Kotak Metrik SIMOKP -->
      <div class="kpi-metrics-grid">
        <div class="kpi-metric-card tone-kas">
          <div class="metric-head">
            <span class="metric-label">Omzet Kas Tunai</span>
            <span class="metric-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </span>
          </div>
          <div class="metric-value">{rupiah(userCash)}</div>
          <div class="metric-note">Penerimaan kas riil deal iklan</div>
        </div>

        <div class="kpi-metric-card tone-barter">
          <div class="metric-head">
            <span class="metric-label">Realisasi Barter</span>
            <span class="metric-icon">
              <Icon name="handshake" size={15} />
            </span>
          </div>
          <div class="metric-value">{rupiah(userBarter)}</div>
          <div class="metric-note">Barang/jasa promosi non-tunai</div>
        </div>

        <div class="kpi-metric-card tone-oplah">
          <div class="metric-head">
            <span class="metric-label">Oplah Bersih Terjual</span>
            <span class="metric-icon">
              <Icon name="news" size={15} />
            </span>
          </div>
          <div class="metric-value">{num(userSoldOplah)} <small style="font-size:0.8rem;font-weight:600;">Eks</small></div>
          <div class="metric-note">Sirkulasi terverifikasi bersih</div>
        </div>

        <div class="kpi-metric-card tone-retur">
          <div class="metric-head">
            <span class="metric-label">Rasio Retur Koran</span>
            <span class="metric-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></svg>
            </span>
          </div>
          <div class="metric-value">{userReturnRate}%</div>
          <div class="metric-note">{num(userReturnOplah)} retur / {num(userSentOplah)} kirim</div>
        </div>
      </div>
    </div>

    <!-- ======================================================== -->
    <!-- BAGIAN 2: RINCIAN TARGET KINERJA (INDIVIDU & TIM DIVISI) -->
    <!-- ======================================================== -->
    <div class="target-sections-container" style="display: flex; flex-direction: column; gap: 1.5rem; margin-bottom: 2rem;">
      <!-- KARTU 1: TARGET KINERJA INDIVIDU -->
      <section class="card target-table-card">
        <div class="card-head" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem;">
          <div style="display:flex; align-items:center; gap:0.6rem;">
            <span class="badge badge-primary" style="font-size:0.75rem; text-transform:uppercase; font-weight:700;">Target Individu</span>
            <div>
              <h3 style="font-size:1.05rem; margin:0; font-weight:700;">Rincian Target Kinerja Individu</h3>
              <p class="muted text-xs" style="margin:0.2rem 0 0;">Sasaran kerja operasional staf yang ditetapkan HRD periode {p.name}</p>
            </div>
          </div>
          <span class="text-xs muted font-mono">{myTargets.length} Indikator Terpantau</span>
        </div>

        <div class="table-responsive">
          <table class="target-table">
            <thead>
              <tr>
                <th style="width: 70px;">Kode</th>
                <th>Indikator Kinerja</th>
                <th style="width: 90px;">Satuan</th>
                <th style="width: 110px; text-align: right;">Target</th>
                <th style="width: 110px; text-align: right;">Realisasi</th>
                <th style="width: 160px;">Capaian (%)</th>
                <th style="width: 130px; text-align: center;">Status Progres</th>
                <th style="width: 145px; text-align: center;">Kerjakan Progres</th>
              </tr>
            </thead>
            <tbody>
              {myTargets.length === 0 ? (
                <tr>
                  <td colspan="8" style="text-align: center; padding: 2rem; color: var(--color-muted);">
                    Belum ada target individu yang ditetapkan untuk periode ini.
                  </td>
                </tr>
              ) : (
                myTargets.map((r) => {
                  const pctVal = r.percent != null ? Math.min(100, Math.round(r.percent)) : 0;
                  const barWidth = Math.min(pctVal, 100);
                  const isSuccess = pctVal >= 100;
                  const isGood = pctVal >= 70;
                  const isWarning = pctVal >= 40;
                  const barColor = isSuccess ? "#10b981" : isGood ? "#0284c7" : isWarning ? "#f59e0b" : "#ef4444";
                  const statusLabel = isSuccess ? "Tercapai (100%)" : pctVal > 0 ? `In Progress (${pctVal}%)` : "Belum Ada Realisasi (0%)";
                  const statusBadgeBg = isSuccess ? "#d1fae5" : pctVal > 0 ? "#e0f2fe" : "#f1f5f9";
                  const statusBadgeColor = isSuccess ? "#065f46" : pctVal > 0 ? "#0284c7" : "#64748b";
                  const action = getActionLink(r.indicator);

                  return (
                    <tr>
                      <td><span class="mono-code">{r.indicator.code}</span></td>
                      <td>
                        <div class="font-bold text-dark">{r.indicator.name}</div>
                        <div class="indicator-def">{r.indicator.definition || "Indikator standar marketing operasional"}</div>
                      </td>
                      <td><span class="badge-unit">{r.indicator.unit}</span></td>
                      <td style="text-align: right; font-weight: 600;">{formatVal(r.target.value, r.indicator.unit)}</td>
                      <td style="text-align: right; font-weight: 700; color: var(--color-primary-900);">
                        {formatVal(r.actual, r.indicator.unit)}
                      </td>
                      <td>
                        <div class="meter-wrapper">
                          <div class="meter-track">
                            <div class="meter-fill" style={`width: ${barWidth}%; background-color: ${barColor};`}></div>
                          </div>
                          <span class="meter-pct font-bold" style={`color: ${barColor};`}>{pctVal}%</span>
                        </div>
                      </td>
                      <td style="text-align: center;">
                        <span class="status-pill" style={`background-color: ${statusBadgeBg}; color: ${statusBadgeColor}; white-space: nowrap; font-weight: 600; font-size: 0.75rem;`}>
                          {statusLabel}
                        </span>
                      </td>
                      <td style="text-align: center;">
                        <a href={action.href} class="btn-kerjakan-progres" title={`Mulai kerjakan atau laporkan progres ${r.indicator.name}`}>
                          <Icon name={action.icon as any} size={14} />
                          <span>{action.label}</span>
                        </a>
                      </td>
                    </tr>
                  );
                })
              )}
            </tbody>
          </table>
        </div>
      </section>

      <!-- KARTU 2: TARGET KINERJA TIM (KOLEKTIF DIVISI) -->
      {divTargets.length > 0 && (
        <section class="card target-table-card">
          <div class="card-head" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem;">
            <div style="display:flex; align-items:center; gap:0.6rem;">
              <span class="badge" style="background:#f3e8ff; color:#7e22ce; font-size:0.75rem; text-transform:uppercase; font-weight:700;">Target Kinerja Tim</span>
              <div>
                <h3 style="font-size:1.05rem; margin:0; font-weight:700;">Target Kinerja Tim (Divisi Pemasaran &amp; Sirkulasi)</h3>
                <p class="muted text-xs" style="margin:0.2rem 0 0;">Capaian bersama seluruh tim divisi yang memengaruhi kinerja korporat periode {p.name}</p>
              </div>
            </div>
            <span class="text-xs muted font-mono">{divTargets.length} Sasaran Tim</span>
          </div>

          <div class="table-responsive">
            <table class="target-table">
              <thead>
                <tr>
                  <th style="width: 70px;">Kode</th>
                  <th>Sasaran Tim Divisi</th>
                  <th style="width: 90px;">Satuan</th>
                  <th style="width: 120px; text-align: right;">Target Divisi</th>
                  <th style="width: 120px; text-align: right;">Realisasi Tim</th>
                  <th style="width: 160px;">Capaian (%)</th>
                  <th style="width: 130px; text-align: center;">Status Progres</th>
                  <th style="width: 145px; text-align: center;">Kerjakan Progres</th>
                </tr>
              </thead>
              <tbody>
                {divTargets.map((r) => {
                  const pctVal = r.percent != null ? Math.min(100, Math.round(r.percent)) : 0;
                  const barWidth = Math.min(pctVal, 100);
                  const isSuccess = pctVal >= 100;
                  const isGood = pctVal >= 70;
                  const isWarning = pctVal >= 40;
                  const barColor = isSuccess ? "#10b981" : isGood ? "#0284c7" : isWarning ? "#f59e0b" : "#ef4444";
                  const statusLabel = isSuccess ? "Tercapai (100%)" : pctVal > 0 ? `In Progress (${pctVal}%)` : "Belum Ada Realisasi (0%)";
                  const statusBadgeBg = isSuccess ? "#d1fae5" : pctVal > 0 ? "#e0f2fe" : "#f1f5f9";
                  const statusBadgeColor = isSuccess ? "#065f46" : pctVal > 0 ? "#0284c7" : "#64748b";
                  const action = getActionLink(r.indicator);
                  const myContrib = approvedActs
                    .filter((a) => contribution(a, r.indicator.id) !== null)
                    .reduce((s, a) => s + (contribution(a, r.indicator.id) ?? 0), 0);

                  return (
                    <tr>
                      <td><span class="mono-code">{r.indicator.code}</span></td>
                      <td class="font-bold">{r.indicator.name}</td>
                      <td><span class="badge-unit">{r.indicator.unit}</span></td>
                      <td style="text-align: right; font-weight: 600;">{formatVal(r.target.value, r.indicator.unit)}</td>
                      <td style="text-align: right;">
                        <div style="font-weight: 700; color: var(--color-primary-900);">{formatVal(r.actual, r.indicator.unit)}</div>
                        {myContrib > 0 && (
                          <div style="font-size: 0.72rem; color: #0284c7; font-weight: 600; margin-top: 0.15rem; background: #e0f2fe; padding: 0.1rem 0.35rem; border-radius: 4px; display: inline-block;">
                            Kontribusi Anda: {formatVal(myContrib, r.indicator.unit)}
                          </div>
                        )}
                      </td>
                      <td>
                        <div class="meter-wrapper">
                          <div class="meter-track">
                            <div class="meter-fill" style={`width: ${barWidth}%; background-color: ${barColor};`}></div>
                          </div>
                          <span class="meter-pct font-bold" style={`color: ${barColor};`}>{pctVal}%</span>
                        </div>
                      </td>
                      <td style="text-align: center;">
                        <span class="status-pill" style={`background-color: ${statusBadgeBg}; color: ${statusBadgeColor}; white-space: nowrap; font-weight: 600; font-size: 0.75rem;`}>
                          {statusLabel}
                        </span>
                      </td>
                      <td style="text-align: center;">
                        <a href={action.href} class="btn-kerjakan-progres btn-kerjakan-tim" title={`Mulai berkontribusi pada target tim ${r.indicator.name}`}>
                          <Icon name={action.icon as any} size={14} />
                          <span>{action.label}</span>
                        </a>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>
      )}
    </div>

    <!-- ======================================================== -->
    <!-- BAGIAN 3: RIWAYAT LAPORAN & BUKTI LAPANGAN               -->
    <!-- ======================================================== -->
    <div class="section-title-wrap" style="margin-top: 1rem; margin-bottom: 0.85rem; display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 0.5rem;">
      <div>
        <h2 class="section-main-title" style="font-size: 1.25rem; font-weight: 700; color: var(--color-primary-900); margin: 0 0 0.2rem;">Riwayat Laporan &amp; Bukti Lapangan</h2>
        <p class="section-sub-title" style="font-size: var(--text-xs); color: var(--color-muted); margin: 0;">Daftar aktivitas yang telah Anda laporkan ke HRD beserta status verifikasi bukti fisiknya.</p>
      </div>
      <span class="text-xs muted font-mono">{mine.length} Total Berkas</span>
    </div>

    <!-- Filter Controls Bar (Status Tabs + Live Search) -->
    <div class="filter-controls-wrap">
      <div class="filter-tabs-bar">
        <button type="button" class="filter-tab is-active" data-filter="all">
          Semua ({mine.length})
        </button>
        <button type="button" class="filter-tab" data-filter="pending">
          Menunggu ({pendingCount})
        </button>
        <button type="button" class="filter-tab" data-filter="approved">
