                              <span class="chip chip-warn">
                                Retur: <strong>{num(a.returnQty)} eks</strong>
                                <small style="margin-left:0.25rem;">({a.returnCondition === "layak_stok" ? "Layak Stok" : "Rusak/Afkir"})</small>
                              </span>
                            )}
                            <span class="chip chip-success">Terjual Neto: <strong>{num(a.soldQty ?? a.qty)} eks</strong></span>
                            {a.sourceName && <span class="chip">Penerima/Kanal: <strong>{a.sourceName}</strong></span>}
                          </>
                        )}

                        {(a.type === "offer" || a.type === "outcome") && (
                          <>
                            {a.partnershipType && (
                              <span class={`chip ${a.partnershipType === 'barter' ? 'chip-info' : a.partnershipType === 'hybrid' ? 'chip-purple' : 'chip-success'}`}>
                                Kemitraan: <strong>{a.partnershipType.toUpperCase()}</strong>
                              </span>
                            )}
                            {(a.cashValue || 0) > 0 && (
                              <span class="chip chip-success">Kas Tunai: <strong>{rupiah(a.cashValue)}</strong></span>
                            )}
                            {(a.barterValue || 0) > 0 && (
                              <span class="chip chip-info">
                                Barter ({a.barterType || "barang"}): <strong>{rupiah(a.barterValue)}</strong>
                              </span>
                            )}
                            {a.barterDesc && (
                              <span class="chip">Kompensasi: <em>{a.barterDesc}</em></span>
                            )}
                            {a.realizationStatus && (
                              <span class="chip">Muat Koran: <strong>{a.realizationStatus}</strong></span>
                            )}
                            {!(a.cashValue || 0) && !(a.barterValue || 0) && a.value && (
                              <span class="chip chip-success">Nilai: <strong>{rupiah(a.value)}</strong></span>
                            )}
                            {a.outcome && (
                              <span class={`chip ${a.outcome === "deal" ? "chip-success" : "chip-neutral"}`}>
                                Hasil: <strong>{a.outcome === "deal" ? "Deal Closing" : "Belum Deal"}</strong>
                              </span>
                            )}
                          </>
                        )}

                        {a.type !== "oplah" && a.type !== "offer" && a.type !== "outcome" && (
                          <>
                            {a.qty && <span class="chip">Volume: <strong>{num(a.qty)}</strong></span>}
                            {a.sourceName && <span class="chip">Lokasi/Mitra: <strong>{a.sourceName}</strong></span>}
                            {a.value && <span class="chip">Nilai: <strong>{rupiah(a.value)}</strong></span>}
                            {a.progressType && <span class="chip">Progres: <strong>{a.progressType}</strong></span>}
                            {a.potential && <span class="chip">Potensi: <strong>{a.potential}</strong></span>}
                          </>
                        )}
                      </div>

                      {historyOf(a.id).at(-1)?.note && (a.status === "revision" || a.status === "rejected") && (
                        <div class="note-box">
                          <Icon name="alert-triangle" size={13} />
                          <span><strong>Catatan HRD:</strong> {historyOf(a.id).at(-1)?.note}</span>
                        </div>
                      )}
                    </div>
                  </td>
                  <td>
                    <span class={`status-badge st-${a.status}`}>
                      <span class="badge-dot"></span>
                      <span>{STATUS_LABEL[a.status] ?? a.status}</span>
                    </span>
                  </td>
                  <td style="text-align: center;">
                    {a.status === "revision" ? (
                      <a href={`/employee/activities/${a.id}`} class="btn btn-xs" style="background:#fef3c7; border:1px solid #f59e0b; color:#92400e; font-weight:700; display:inline-flex; align-items:center; gap:0.25rem; white-space:nowrap;" title="Buka formulir perbaikan revisi dan kirim ulang ke HRD">
                        <span>Perbaiki &rarr;</span>
                      </a>
                    ) : (
                      <a href={`/employee/activities/${a.id}`} class="btn btn-secondary btn-xs" title="Lihat detail lengkap">
                        <span>Rincian &rarr;</span>
                      </a>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </div>
</PublicLayout>

<!-- Client Script untuk Filter Status & Live Search -->
<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    const tabs = document.querySelectorAll(".filter-tabs-bar .filter-tab");
    const rows = document.querySelectorAll("#table-user-activities tbody tr");
    const searchInput = document.getElementById("activity-search-input");
    let currentFilter = "all";

    function applyFilters() {
      const q = (searchInput?.value || "").toLowerCase().trim();

      rows.forEach((r) => {
        const matchesStatus = currentFilter === "all" || r.dataset.status === currentFilter;
        const matchesQuery = !q || (r.dataset.search || "").includes(q);

        if (matchesStatus && matchesQuery) {
          r.style.display = "";
        } else {
          r.style.display = "none";
        }
      });
    }

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        tabs.forEach((t) => t.classList.remove("is-active"));
        tab.classList.add("is-active");
        currentFilter = tab.dataset.filter || "all";
        applyFilters();
      });
    });

    if (searchInput) {
      searchInput.addEventListener("input", applyFilters);
    }
  });
</script>

