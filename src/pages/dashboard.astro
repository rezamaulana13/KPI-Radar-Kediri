---
import DashboardLayout from "../layouts/DashboardLayout.astro";
import PageHeader from "../components/layout/PageHeader.astro";
import StatCard from "../components/dashboard/StatCard.astro";
import DataTable from "../components/ui/DataTable.astro";
import Alert from "../components/ui/Alert.astro";
import Badge from "../components/ui/Badge.astro";
import Meter from "../components/ui/Meter.astro";
import Icon from "../components/ui/Icon.astro";
import { db, activePeriod, employeeName, divisionName } from "../lib/data/store";
import { achievements, achievementSummary } from "../features/kpi/achievements";
import { rupiah, num, TYPE_LABEL } from "../lib/formatters";
import { canVerify } from "../features/verification/rules";

const user = Astro.locals.user!;
// Karyawan diarahkan ke Portal Landing Page Utama
if (user.role === "employee") {
  return Astro.redirect("/");
}

const p = activePeriod();
const sum = achievementSummary(p.id);
const rows = achievements(p.id);
const titles: Record<string, string> = {
  admin: "Dashboard Super Admin",
  hrd: "Dashboard Pemasaran & Sirkulasi",
};

const waiting = user.role === "hrd" || user.role === "admin" ? db.activities.filter((a) => a.status === "pending" && canVerify(user, a, db.employees).ok) : [];
const divRows = rows.filter((r) => r.target.scope !== "individual");
const subjectName = (r: (typeof rows)[number]) => r.target.scope === "company" ? "Perusahaan" : r.target.scope === "division" ? divisionName(r.target.divisionId) : employeeName(r.target.employeeId);

// 3 Pilar Metrik Utama SIMOKP Periode Aktif
const approvedActivities = db.activities.filter((a) => a.periodId === p.id && a.status === "approved");
const totalSoldOplah = approvedActivities
  .filter((a) => a.type === "oplah")
  .reduce((s, a) => s + (a.soldQty != null ? a.soldQty : Math.max(0, (a.qty || 0) - (a.returnQty || 0))), 0);
const totalSentOplah = approvedActivities
  .filter((a) => a.type === "oplah")
  .reduce((s, a) => s + (a.qty || 0), 0);
const totalReturnOplah = approvedActivities
  .filter((a) => a.type === "oplah")
  .reduce((s, a) => s + (a.returnQty || 0), 0);
const totalCashDeals = approvedActivities
  .filter((a) => a.type === "outcome" && a.outcome === "deal")
  .reduce((s, a) => s + (a.cashValue != null ? a.cashValue : (a.value || 0)), 0);
const totalBarterDeals = approvedActivities
  .filter((a) => (a.type === "outcome" && a.outcome === "deal" && (a.barterValue || 0) > 0) || a.type === "program")
  .reduce((s, a) => s + (a.barterValue != null ? a.barterValue : 0), 0);
---
<DashboardLayout title={titles[user.role]}>
  <PageHeader title={titles[user.role]} description={`${p.name}. Halo, ${user.name.split(" ")[0]}.`} crumbs={[]}>
    <Fragment slot="actions">
      {user.role === "admin" && (
        <a href={`/api/export/excel?type=admin&period=${p.id}`} class="btn btn-primary" download title="Unduh Laporan Eksekutif Korporat Bulanan (Excel)">
          <Icon name="download" size={16} />
          <span>Unduh Laporan Korporat (Excel)</span>
        </a>
      )}
      {user.role === "hrd" && (
        <a href={`/api/export/excel?type=hrd&period=${p.id}`} class="btn btn-primary" download title="Unduh Rekapitulasi Kinerja Bulanan (Excel)">
          <Icon name="download" size={16} />
          <span>Unduh Rekap Kinerja (.xlsx)</span>
        </a>
      )}
    </Fragment>
  </PageHeader>

  {user.role === "admin" && (<>
    {user.mode === "demo" && <Alert tone="info" title="Mode demo">Data berasal dari contoh di memori server dan akan kembali seperti semula saat server dimulai ulang.</Alert>}
    
    <!-- 4 Stat Card Utama: 3 Pilar SIMOKP & Capaian KPI Keseluruhan -->
    <div class="stat-grid" style="margin-bottom: 1.25rem;">
      <StatCard label="Omzet Kas Tunai" value={rupiah(totalCashDeals)} tone="ok" note="Penerimaan riil iklan & advertorial" />
      <StatCard label="Nilai Realisasi Barter" value={rupiah(totalBarterDeals)} tone="info" note="Kerja sama barang/jasa promosi" />
      <StatCard label="Oplah Bersih Terjual" value={`${num(totalSoldOplah)} Eks`} note={`Kirim: ${num(totalSentOplah)} | Retur: ${num(totalReturnOplah)}`} />
      <StatCard label="Rata-rata Capaian KPI" value={sum.avgPercent == null ? "—" : `${num(sum.avgPercent)}%`} tone={sum.avgPercent && sum.avgPercent >= 70 ? "ok" : "warn"} note={`${sum.targets} sasaran operasional aktif`} />
    </div>

    <!-- 4 Stat Card Tata Kelola Platform, HRD & Staf -->
    <div class="stat-grid">
      <StatCard label="Pengguna Terdaftar" value={db.employees.length} note={`${db.employees.filter((e) => e.active).length} akun berstatus aktif`} />
      <StatCard label="Aktivitas Terverifikasi" value={sum.approved} tone="ok" note={`${sum.total} total laporan masuk`} />
      <StatCard label="Menunggu Verifikasi" value={sum.pending} tone={sum.pending ? "warn" : "ok"} note="Dapat diverifikasi langsung oleh Admin" />
      <StatCard label="Catatan Audit Log" value={db.auditLogs.length} note="Integritas ISO/IEC 25010" />
    </div>

    <!-- Alert jika ada laporan pending yang butuh verifikasi -->
    {sum.pending > 0 && (
      <div style="margin-top: 1.25rem;">
        <Alert tone="warning" title={`${sum.pending} Laporan Menunggu Verifikasi`}>
          Ada berkas laporan lapangan dari karyawan yang belum diperiksa. Super Admin berhak menyetujui, meminta revisi, atau menolak laporan secara langsung.
          <a href="/hrd/verifications" style="margin-left: 0.5rem; font-weight: 700; text-decoration: underline;">Buka Antrean Verifikasi &rarr;</a>
        </Alert>
      </div>
    )}

    <div class="grid-3-1" style="margin-top: 1.5rem;">
      <!-- Kolom Kiri: Capaian Target Divisi & Perusahaan + Audit Trail -->
      <div class="stack" style="gap: 1.5rem;">
        <section class="card">
          <div class="card-head">
            <div>
              <h2>Monitoring Target Divisi &amp; Perusahaan</h2>
              <p class="muted font-xs" style="margin: 0.15rem 0 0;">Capaian sasaran tim Marketing &amp; Sirkulasi periode {p.name}.</p>
            </div>
            <a href="/hrd/kpi/achievements">Rincian KPI &rarr;</a>
          </div>
          <DataTable
            caption="Capaian target"
            columns={[
              { key: "subject", label: "Cakupan" },
              { key: "name", label: "Indikator" },
              { key: "targetDisplay", label: "Target" },
              { key: "actualDisplay", label: "Realisasi" },
              { key: "percent", label: "Capaian", type: "meter" }
            ]}
            rows={divRows.map((r) => {
              const u = r.indicator.unit;
              return {
                ...r,
                subject: subjectName(r),
                name: r.indicator.name,
                targetDisplay: u === "Rp" ? rupiah(r.target.value) : `${num(r.target.value)} ${u}`,
                actualDisplay: u === "Rp" ? rupiah(r.actual ?? 0) : `${num(r.actual)} ${u}`,
              };
            })}
            emptyTitle="Belum ada target divisi"
            emptyHint="Atur target indikator pada menu Target Kinerja."
          />
        </section>

        <section class="card">
          <div class="card-head">
            <div>
              <h2>Audit Trail &amp; Log Sistem Terkini</h2>
              <p class="muted font-xs" style="margin: 0.15rem 0 0;">Jejak perubahan data penting untuk akuntabilitas sistem.</p>
            </div>
            <a href="/admin/audit-logs">Buka Semua Log &rarr;</a>
          </div>
          <DataTable
            caption="Audit terbaru"
            columns={[
              { key: "at", label: "Waktu", type: "datetime" },
              { key: "actor", label: "Pelaku" },
              { key: "action", label: "Aksi", type: "mono" },
              { key: "detail", label: "Keterangan Operasional" }
            ]}
            rows={db.auditLogs.slice(0, 6).map((l) => ({ ...l, actor: employeeName(l.actorId) }))}
            emptyTitle="Belum ada catatan audit"
            emptyHint="Setiap aktivitas perubahan penting akan terekam otomatis di sini."
          />
        </section>
      </div>

      <!-- Kolom Kanan: Status Lingkungan Sistem & Pusat Kendali Penuh Super Admin -->
      <div class="stack">
        <section class="card" style="background: #f8fafc; border-color: #e2e8f0;">
          <div class="card-head">
            <h3 style="font-size:0.95rem;margin:0;font-weight:700;">Status Hak Akses Super Admin</h3>
          </div>
          <div class="card-body" style="font-size:var(--text-sm);">
            <div style="display:flex;justify-content:space-between;padding:0.4rem 0;border-bottom:1px solid #e2e8f0;">
              <span class="muted">Otoritas:</span>
              <span class="badge badge-admin" style="font-size:0.75rem;">Full Control (Tertinggi)</span>
            </div>
            <div style="display:flex;justify-content:space-between;padding:0.4rem 0;border-bottom:1px solid #e2e8f0;">
              <span class="muted">Kelola HRD:</span>
              <strong style="color:#16a34a;">Aktif (Penuh)</strong>
            </div>
            <div style="display:flex;justify-content:space-between;padding:0.4rem 0;border-bottom:1px solid #e2e8f0;">
              <span class="muted">Kelola Karyawan:</span>
              <strong style="color:#16a34a;">Aktif (Penuh)</strong>
            </div>
            <div style="display:flex;justify-content:space-between;padding:0.4rem 0;border-bottom:1px solid #e2e8f0;">
              <span class="muted">Periode Aktif:</span>
              <span class="badge badge-approved">{p.name}</span>
            </div>
            <div style="display:flex;justify-content:space-between;padding:0.4rem 0;">
              <span class="muted">Standar Audit:</span>
              <span class="badge badge-info" style="font-size:0.75rem;">ISO/IEC 25010</span>
            </div>
          </div>
        </section>

        <section class="card">
          <div class="card-head">
            <h3 style="font-size:0.95rem;margin:0;font-weight:700;">Pusat Kendali Eksekutif</h3>
          </div>
          <div class="card-body stack" style="gap:0.5rem;">
            <a href="/hrd/verifications" class="btn btn-secondary" style="width:100%;justify-content:flex-start;">
              <Icon name="check" size={16} />
              <span>Verifikasi Berkas Lapangan ({sum.pending}) &rarr;</span>
            </a>
            <a href="/marketing/oplah" class="btn btn-secondary" style="width:100%;justify-content:flex-start;">
              <Icon name="news" size={16} />
              <span>Monitoring Sirkulasi Oplah &rarr;</span>
            </a>
            <a href="/hrd/kpi/targets" class="btn btn-secondary" style="width:100%;justify-content:flex-start;">
              <Icon name="flag" size={16} />
              <span>Atur Target &amp; Indikator KPI &rarr;</span>
            </a>
            <a href="/hrd/reports" class="btn btn-secondary" style="width:100%;justify-content:flex-start;">
              <Icon name="clipboard" size={16} />
              <span>Rekapitulasi Kinerja Lengkap &rarr;</span>
            </a>
            <a href="/admin/users" class="btn btn-secondary" style="width:100%;justify-content:flex-start;">
              <Icon name="users" size={16} />
              <span>Kelola Pengguna (HRD &amp; Staf) &rarr;</span>
            </a>
            <a href="/admin/employees" class="btn btn-secondary" style="width:100%;justify-content:flex-start;">
              <Icon name="badge" size={16} />
              <span>Kelola Personel &amp; Jabatan &rarr;</span>
            </a>
            <a href="/admin/audit-logs" class="btn btn-secondary" style="width:100%;justify-content:flex-start;">
              <Icon name="shield" size={16} />
              <span>Pusat Audit Trail Sistem &rarr;</span>
            </a>
          </div>
        </section>
      </div>
    </div>
  </>)}

  {user.role === "hrd" && (<>
    <!-- Stat Grid 1: 3 Pilar Utama SIMOKP & Indeks KPI -->
    <div class="stat-grid" style="margin-bottom: 1.25rem;">
      <StatCard label="Omzet Kas Tunai" value={rupiah(totalCashDeals)} tone="ok" note="Penerimaan riil iklan & advertorial" />
      <StatCard label="Nilai Realisasi Barter" value={rupiah(totalBarterDeals)} tone="info" note="Kerja sama barang/jasa promosi" />
      <StatCard label="Oplah Bersih Terjual" value={`${num(totalSoldOplah)} Eks`} note={`Kirim: ${num(totalSentOplah)} | Retur: ${num(totalReturnOplah)}`} />
      <StatCard label="Rata-rata Capaian KPI" value={sum.avgPercent == null ? "—" : `${num(sum.avgPercent)}%`} tone={sum.avgPercent && sum.avgPercent >= 70 ? "ok" : "warn"} note={`${sum.targets} sasaran operasional aktif`} />
    </div>

    <!-- Stat Grid 2: Operasional Verifikasi & Lapangan -->
    <div class="stat-grid">
      <StatCard label="Aktivitas periode ini" value={sum.total} note={`${sum.approved} disetujui HRD`} />
      <StatCard label="Menunggu verifikasi" value={sum.pending} tone={sum.pending ? "warn" : "ok"} note="Perlu ditinjau segera" />
      <StatCard label="Perlu revisi / ditolak" value={sum.revision + sum.rejected} tone={sum.revision + sum.rejected ? "bad" : "ok"} note="Ada catatan perbaikan" />
      <StatCard label="Petugas Pemasaran" value={db.employees.filter((e) => e.role === "employee").length} note="Staf pelaksana lapangan" />
    </div>

    {sum.unmapped > 0 && <Alert tone="warning" title="Ada indikator tanpa mapping">{sum.unmapped} target tidak punya mapping aktivitas, sehingga realisasinya tidak dihitung otomatis.</Alert>}

    <div class="grid-3-1" style="margin-top: 1.5rem;">
      <section class="card">
        <div class="card-head">
          <div>
            <h2>Capaian Target Perusahaan &amp; Divisi</h2>
            <p class="muted font-xs" style="margin: 0.15rem 0 0;">Monitoring sasaran korporat dan target divisi pemasaran &amp; sirkulasi periode {p.name}.</p>
          </div>
          <a href="/hrd/kpi/achievements">Rincian Realisasi &rarr;</a>
        </div>
        <DataTable
          caption="Capaian perusahaan dan divisi"
          columns={[
            { key: "subject", label: "Cakupan" },
            { key: "name", label: "Indikator" },
            { key: "targetDisplay", label: "Target" },
            { key: "actualDisplay", label: "Realisasi" },
            { key: "percent", label: "Capaian", type: "meter" }
          ]}
          rows={divRows.map((r) => {
            const isCurrency = r.indicator.unit === "Rp" || r.indicator.unit.toLowerCase().includes("rupiah");
            return {
              subject: subjectName(r),
              name: r.indicator.name,
              targetDisplay: isCurrency ? rupiah(r.target.value) : `${num(r.target.value)} ${r.indicator.unit}`,
              actualDisplay: r.actual != null ? (isCurrency ? rupiah(r.actual) : `${num(r.actual)} ${r.indicator.unit}`) : "—",
              percent: r.percent,
            };
          })}
        />
      </section>

      <section class="card">
        <div class="card-head">
          <div>
            <h2>Antrean Verifikasi</h2>
            <p class="muted font-xs" style="margin: 0.15rem 0 0;">Laporan staf yang butuh persetujuan.</p>
          </div>
          <a href="/hrd/verifications">Buka Antrean &rarr;</a>
        </div>
        <DataTable
          caption="Antrean verifikasi"
          columns={[
            { key: "id", label: "ID", href: (r) => `/hrd/verifications/${r.id}` },
            { key: "owner", label: "Pemilik" },
            { key: "typeLabel", label: "Jenis" }
          ]}
          rows={waiting.slice(0, 5).map((a) => ({ ...a, owner: employeeName(a.ownerId), typeLabel: TYPE_LABEL[a.type] }))}
          emptyTitle="Antrean kosong"
          emptyHint="Tidak ada aktivitas yang menunggu verifikasi saat ini."
        />
      </section>
    </div>
  </>)}
</DashboardLayout>
