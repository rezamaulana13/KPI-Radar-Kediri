---
import PublicLayout from "../layouts/PublicLayout.astro";
import Icon from "../components/ui/Icon.astro";
import StatCard from "../components/dashboard/StatCard.astro";
import Badge from "../components/ui/Badge.astro";
import Meter from "../components/ui/Meter.astro";
import Alert from "../components/ui/Alert.astro";
import ActivityFields from "../components/ui/ActivityFields.astro";
import FormError from "../components/ui/FormError.astro";
import { ROLE_LABEL, rupiah, num, dateID, TYPE_LABEL } from "../lib/formatters";
import { db, activePeriod, activitiesFor, employee, divisionName, positions } from "../lib/data/store";
import { achievements } from "../features/kpi/achievements";
import { takeFormState } from "../lib/utils/flash";

const user = Astro.locals.user;

// Admin dan HRD diarahkan langsung ke Dashboard Manajemen / Verifikasi
if (user && (user.role === "hrd" || user.role === "admin")) {
  return Astro.redirect("/dashboard");
}

const p = activePeriod();

// Data flash form setelah pengiriman
const st = takeFormState(Astro.cookies, Astro.url);
const created = Astro.url.searchParams.get("created");
const values = { ...st.values, type: st.values?.type ?? Astro.url.searchParams.get("type") ?? "oplah" };

// Data khusus karyawan jika sedang login
let mine: any[] = [];
let emp: any = null;
let posName = "Eksekutif Marketing";
let divName = "Divisi Pemasaran & Sirkulasi";
let nip = "RK-0000";
let myTargets: any[] = [];
let divRows: any[] = [];
let avgPercent: number | null = null;
let approvalRate = 0;
const today = new Date().toLocaleDateString("sv-SE", { timeZone: "Asia/Jakarta" });

if (user && user.role === "employee") {
  emp = db.employees.find((e) => e.id === user.id) || employee(user.id);
  posName = positions.find((pos) => pos.id === emp?.positionId)?.name ?? "Eksekutif Marketing";
  divName = divisionName(user.divisionId) || "Divisi Pemasaran & Sirkulasi";
  nip = emp?.nip || `RK-${user.id.slice(0, 4).toUpperCase()}`;

  // Pastikan target individu standar tersedia jika belum diset manual oleh HRD
  if (!db.targets.some((t) => t.employeeId === user.id && t.periodId === p.id)) {
    db.targets.push(
      { id: `TG-IND-${user.id.slice(0, 4)}-1`, indicatorId: "IND-02", periodId: p.id, scope: "individual", employeeId: user.id, value: 10 },
      { id: `TG-IND-${user.id.slice(0, 4)}-2`, indicatorId: "IND-03", periodId: p.id, scope: "individual", employeeId: user.id, value: 15 },
      { id: `TG-IND-${user.id.slice(0, 4)}-3`, indicatorId: "IND-04", periodId: p.id, scope: "individual", employeeId: user.id, value: 5 },
      { id: `TG-IND-${user.id.slice(0, 4)}-4`, indicatorId: "IND-08", periodId: p.id, scope: "individual", employeeId: user.id, value: 20 }
    );
  }

  // Ambil aktivitas dan target yang sah ditetapkan HRD untuk karyawan ini
  mine = activitiesFor({ id: user.id, role: user.role }).filter((a) => a.periodId === p.id);
  const rows = achievements(p.id);
  myTargets = rows.filter((r) => r.target.scope === "individual" && r.target.employeeId === user.id);
  divRows = rows.filter((r) => r.target.scope === "division" && (r.target.divisionId === user.divisionId || r.target.divisionId === "DIV-MKT"));

  const measurable = myTargets.filter((r) => r.percent != null);
  avgPercent = measurable.length ? Math.round(measurable.reduce((s, r) => s + Math.min(r.percent!, 100), 0) / measurable.length) : null;
  approvalRate = mine.length > 0 ? Math.round((mine.filter((a) => a.status === "approved").length / mine.length) * 100) : 0;
}

const count = (list: typeof mine, s: string) => list.filter((a) => a.status === s).length;
---

<PublicLayout
  title={user?.role === "employee" ? `Portal Karyawan · ${user.name}` : "Portal Kinerja & Aktivitas Karyawan"}
  activeNav="beranda"
  description="Sistem Informasi Kinerja & Aktivitas Karyawan PT Kediri Intermedia Pers (Jawa Pos Radar Kediri). Monitoring Oplah, Iklan, Event, & Evaluasi Capaian Kinerja Karyawan."
>
  <!-- Hero Section -->
  <section class="landing-hero" id="beranda">
    <div class="landing-hero-container">
      {user && user.role === "employee" ? (
        <>
          <div class="landing-pill">
            <span class="dot-online"></span>
            <span>Akun Karyawan Aktif · {posName} ({divName})</span>
          </div>

          <h1>Portal Kerja &amp; Aktivitas Karyawan</h1>
          
          <p>
            Halo <strong>{user.name}</strong> ({posName}). Catat kegiatan harian lapangan Anda seperti oplah koran dan penawaran iklan, lalu pantau progres capaian target Anda untuk bulan <strong>{p.name}</strong> di sini.
          </p>

          <div class="landing-hero-btns">
            <a class="btn btn-primary btn-hero" href="/catat-aktivitas">
              <Icon name="plus" size={18} />
              <span>Catat Kegiatan Baru</span>
            </a>
            <a class="btn btn-secondary btn-hero" href="/aktivitas-saya">
              <span>Riwayat Saya ({mine.length})</span>
            </a>
            <a class="btn btn-secondary btn-hero" href="/kinerja">
              <span>Capaian Target</span>
            </a>
            <a class="btn btn-secondary btn-hero" href="/modul-marketing">
              <span>Data Marketing</span>
            </a>
          </div>

          {created && (
            <div class="landing-notice notice-success">
              <Icon name="check" size={16} />
              <span>Aktivitas <strong>{created}</strong> berhasil disimpan! Berstatus menunggu verifikasi HRD. <a href="/aktivitas-saya" style="color:#fff;text-decoration:underline;margin-left:0.5rem;">Lihat di Riwayat &rarr;</a></span>
            </div>
          )}

          {count(mine, "revision") > 0 && (
            <div class="landing-notice notice-warning">
              <Icon name="bell" size={16} />
              <span>Perhatian: Ada <strong>{count(mine, "revision")} aktivitas</strong> yang memerlukan revisi perbaikan. <a href="/aktivitas-saya" style="color:#fff;text-decoration:underline;margin-left:0.5rem;">Periksa Sekarang &rarr;</a></span>
            </div>
          )}
        </>
      ) : (
        <>
          <div class="landing-pill">
            <Icon name="shield" size={14} />
            <span>Sistem Informasi Terintegrasi · Jawa Pos Radar Kediri</span>
          </div>

          <h1>Portal Pencatatan Aktivitas &amp; Evaluasi Kinerja Karyawan</h1>
          
          <p>
            Platform resmi PT Kediri Intermedia Pers untuk monitoring progres kerja harian tim marketing, sirkulasi oplah, verifikasi berkas oleh HRD, serta transparansi evaluasi capaian kinerja berkala yang objektif, akuntabel, dan terukur.
          </p>

          <div class="landing-hero-btns">
            {user ? (
              <a class="btn btn-primary btn-hero" href="/dashboard">
                <span>Buka Dashboard ({ROLE_LABEL[user.role]})</span>
                <span>&rarr;</span>
              </a>
            ) : (
              <>
                <a class="btn btn-primary btn-hero" href="/login">
                  <span>Masuk Akun Karyawan</span>
                  <span>&rarr;</span>
                </a>
                <a class="btn btn-secondary btn-hero" href="/register">
                  <span>Daftar Akun Baru</span>
                </a>
              </>
            )}
          </div>

          <div class="landing-notice">
            <Icon name="bell" size={16} />
            <span>
              <strong>Aturan Akses:</strong> Seluruh pencatatan progres kerja lapangan dan verifikasi berkas mewajibkan login akun terdaftar.
            </span>
          </div>
        </>
      )}
    </div>
  </section>

  <!-- KONTEN KHUSUS KARYAWAN: WORKSPACE LANDING PAGE INTERAKTIF -->
  {user && user.role === "employee" ? (
    <>
      <!-- Bar Statistik Ringkasan Karyawan -->
      <section class="landing-metrics">
        <div class="metrics-container">
          <div class="metric-item">
            <span class="metric-number">{mine.length}</span>
            <span class="metric-label">Total Aktivitas Periode Ini</span>
            <span class="metric-desc">Semua laporan kegiatan yang telah dicatat</span>
          </div>
          <div class="metric-item">
            <span class="metric-number" style="color: var(--color-success);">{count(mine, "approved")}</span>
            <span class="metric-label">Disetujui ({approvalRate}%)</span>
            <span class="metric-desc">Resmi diverifikasi dan masuk ke skor KPI</span>
          </div>
          <div class="metric-item">
            <span class="metric-number" style="color: var(--color-warning);">{count(mine, "pending")}</span>
            <span class="metric-label">Menunggu Verifikasi</span>
            <span class="metric-desc">Sedang dalam antrean pemeriksaan HRD</span>
          </div>
          <div class="metric-item">
            <span class="metric-number" style={count(mine, "revision") > 0 ? "color: var(--color-danger);" : ""}>
              {count(mine, "revision")}
            </span>
            <span class="metric-label">Perlu Revisi</span>
            <span class="metric-desc">{count(mine, "revision") > 0 ? "Ada catatan perbaikan dari verifikator" : "Tidak ada revisi pending"}</span>
          </div>
        </div>
      </section>

      <!-- 1. PUSAT AKSI CEPAT (6 MODUL KARTU LANGSUNG KE HALAMAN) -->
      <section class="landing-section">
        <div class="section-header">
          <span class="section-tag">PUSAT AKSI CEPAT</span>
          <h2>Pencatatan Aktivitas Lapangan</h2>
          <p>
            Pilih jenis pekerjaan di bawah ini untuk membuka halaman input formulir spesifik secara cepat dan rapi.
          </p>
          <div style="display: flex; justify-content: center; gap: 0.65rem; margin-top: 1.25rem;">
            <a href="/modul-marketing" class="btn btn-secondary btn-sm">
              <span>Buka Pusat Modul Marketing &rarr;</span>
            </a>
          </div>
        </div>

        <div class="module-grid">
          <!-- Card 1: Oplah Koran -->
          <div class="module-card">
            <div>
              <div class="module-icon icon-teal"><Icon name="news" size={26} /></div>
              <h3>Oplah Koran</h3>
              <p>Pencatatan sirkulasi distribusi koran harian dari agen, loper, dan pelanggan eceran di seluruh wilayah liputan.</p>
            </div>
            <div class="module-footer" style="display:flex;gap:0.5rem;">
              <a href="/catat-aktivitas?type=oplah" class="btn btn-primary btn-sm" style="flex:1;justify-content:center;">
                <Icon name="plus" size={14} /> <span>Input Oplah</span>
              </a>
              <a href="/marketing/oplah" class="btn btn-secondary btn-sm" title="Buka data oplah">
                <span>Data &rarr;</span>
              </a>
            </div>
          </div>

          <!-- Card 2: Klien Baru -->
          <div class="module-card">
            <div>
              <div class="module-icon icon-blue"><Icon name="building" size={26} /></div>
              <h3>Klien &amp; Mitra Baru</h3>
              <p>Pendaftaran calon pemasang iklan dari dinas pemerintahan (OPD), perusahaan swasta, dan UMKM baru.</p>
            </div>
            <div class="module-footer" style="display:flex;gap:0.5rem;">
              <a href="/catat-aktivitas?type=client" class="btn btn-primary btn-sm" style="flex:1;justify-content:center;">
                <Icon name="plus" size={14} /> <span>Tambah Klien</span>
              </a>
              <a href="/marketing/clients" class="btn btn-secondary btn-sm" title="Database klien">
                <span>Data &rarr;</span>
              </a>
            </div>
          </div>

          <!-- Card 3: Penawaran Iklan -->
          <div class="module-card">
            <div>
              <div class="module-icon icon-purple"><Icon name="file" size={26} /></div>
              <h3>Penawaran Iklan</h3>
              <p>Pengajuan proposal tarif iklan cetak display, advertorial khusus, paket liputan, maupun sponsorship event.</p>
            </div>
            <div class="module-footer" style="display:flex;gap:0.5rem;">
              <a href="/catat-aktivitas?type=offer" class="btn btn-primary btn-sm" style="flex:1;justify-content:center;">
                <Icon name="plus" size={14} /> <span>Buat Penawaran</span>
              </a>
              <a href="/marketing/offers" class="btn btn-secondary btn-sm" title="Daftar proposal penawaran">
                <span>Data &rarr;</span>
              </a>
            </div>
          </div>

          <!-- Card 4: Progres Kunjungan -->
          <div class="module-card">
            <div>
              <div class="module-icon icon-indigo"><Icon name="clipboard" size={26} /></div>
              <h3>Progres &amp; Kunjungan</h3>
              <p>Dokumentasi aktivitas pertemuan prospek, presentasi penawaran, serta negosiasi lanjutan dengan mitra.</p>
            </div>
            <div class="module-footer" style="display:flex;gap:0.5rem;">
              <a href="/catat-aktivitas?type=progress" class="btn btn-primary btn-sm" style="flex:1;justify-content:center;">
                <Icon name="plus" size={14} /> <span>Catat Kunjungan</span>
              </a>
              <a href="/catat-aktivitas?type=outcome" class="btn btn-secondary btn-sm" title="Closing deal">
                <span>Deal &rarr;</span>
              </a>
            </div>
          </div>

          <!-- Card 5: Riset Profiling -->
          <div class="module-card">
            <div>
              <div class="module-icon icon-blue"><Icon name="search" size={26} /></div>
              <h3>Riset Profiling</h3>
              <p>Analisis profil potensi anggaran promosi klien, segmentasi pembaca, serta preferensi media mitra.</p>
            </div>
            <div class="module-footer" style="display:flex;gap:0.5rem;">
              <a href="/catat-aktivitas?type=profiling" class="btn btn-primary btn-sm" style="flex:1;justify-content:center;">
                <Icon name="plus" size={14} /> <span>Input Profiling</span>
              </a>
              <a href="/marketing/profiling" class="btn btn-secondary btn-sm" title="Data riset pasar">
                <span>Data &rarr;</span>
              </a>
            </div>
          </div>

          <!-- Card 6: Program & Barter -->
          <div class="module-card">
            <div>
              <div class="module-icon icon-teal"><Icon name="handshake" size={26} /></div>
              <h3>Program &amp; Barter</h3>
              <p>Pencatatan kegiatan kolaborasi promosi barter media partner, event festival, dan kerjasama sponsorship.</p>
            </div>
            <div class="module-footer" style="display:flex;gap:0.5rem;">
              <a href="/catat-aktivitas?type=program" class="btn btn-primary btn-sm" style="flex:1;justify-content:center;">
                <Icon name="plus" size={14} /> <span>Buat Program</span>
              </a>
              <a href="/marketing/programs" class="btn btn-secondary btn-sm" title="Daftar program event">
                <span>Data &rarr;</span>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- 2. TARGET & CAPAIAN KINERJA (PREVIEW RINGKAS DENGAN LINK KE /kinerja) -->
      <section class="landing-section landing-section-alt">
        <div class="section-header">
          <span class="section-tag">RAPOR KINERJA</span>
          <h2>Target &amp; Capaian Kinerja ({p.name})</h2>
          <p>
            Perolehan realisasi dihitung secara otomatis dari seluruh aktivitas Anda yang telah <strong>Disetujui</strong> oleh verifikator HRD.
          </p>
          <div style="display: flex; justify-content: center; gap: 0.65rem; margin-top: 1.25rem; flex-wrap: wrap;">
            <a href={`/api/export/excel?type=employee&period=${p.id}`} class="btn btn-secondary btn-sm" download title="Unduh Rapor Kinerja Excel Bulanan">
              <Icon name="download" size={14} />
              <span>Unduh Rekap (Excel)</span>
            </a>
            <a href="/kinerja" class="btn btn-secondary btn-sm">
              <span>Buka Rapor KPI Lengkap &rarr;</span>
            </a>
          </div>
        </div>

        <div class="target-grid">
          <!-- Kolom 1: Target Individu Karyawan -->
          <div class="card" style="padding: var(--space-5);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 1px solid var(--color-border); padding-bottom: 0.75rem;">
              <div>
                <h3 style="font-size: 1.1rem; font-weight: 700; margin: 0;">Target Individu Saya</h3>
                <span class="muted text-xs">Evaluasi penilaian kinerja personal karyawan</span>
              </div>
              <span class="badge badge-employee">Individu</span>
            </div>

            {myTargets.length === 0 ? (
              <p class="muted text-sm" style="text-align: center; padding: 2rem 0;">Belum ada target individu yang ditetapkan.</p>
            ) : (
              myTargets.map((r) => (
                <div class="target-row">
                  <div class="target-info">
                    <span class="target-name">{r.indicator.name}</span>
                    <span class="mono target-values">
                      {num(r.actual)} / {num(r.target.value)} {r.indicator.unit}
                    </span>
                  </div>
                  <div class="target-meter-wrap">
                    <div style="flex: 1;"><Meter value={r.percent} /></div>
                    <span class="mono target-pct">{r.percent != null ? `${num(r.percent, 0)}%` : "0%"}</span>
                  </div>
                </div>
              ))
            )}
          </div>

          <!-- Kolom 2: Target Divisi Pemasaran -->
          <div class="card" style="padding: var(--space-5);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 1px solid var(--color-border); padding-bottom: 0.75rem;">
              <div>
                <h3 style="font-size: 1.1rem; font-weight: 700; margin: 0;">Target Bersama Divisi Pemasaran</h3>
                <span class="muted text-xs">Sasaran kolektif tim Marketing &amp; Sirkulasi</span>
              </div>
              <span class="badge badge-hrd">Divisi</span>
            </div>

            {divRows.length === 0 ? (
              <p class="muted text-sm" style="text-align: center; padding: 2rem 0;">Belum ada target divisi.</p>
            ) : (
              divRows.map((r) => (
                <div class="target-row">
                  <div class="target-info">
                    <span class="target-name">{r.indicator.name}</span>
                    <span class="mono target-values">
                      {r.indicator.unit === "Rp" ? rupiah(r.actual ?? 0) : num(r.actual)} / {r.indicator.unit === "Rp" ? rupiah(r.target.value) : num(r.target.value)} {r.indicator.unit !== "Rp" ? r.indicator.unit : ""}
                    </span>
                  </div>
                  <div class="target-meter-wrap">
                    <div style="flex: 1;"><Meter value={r.percent} /></div>
                    <span class="mono target-pct">{r.percent != null ? `${num(r.percent, 0)}%` : "0%"}</span>
                  </div>
                </div>
              ))
            )}
          </div>
        </div>
      </section>

      <!-- 3. TABEL LOG AKTIVITAS TERKINI (PREVIEW DENGAN LINK KE /aktivitas-saya) -->
      <section class="landing-section">
        <div class="section-header">
          <span class="section-tag">HISTORI LAPORAN</span>
          <h2>Log Aktivitas Terkini</h2>
          <p>
            Laporan kegiatan terbaru Anda pada periode <strong>{p.name}</strong>.
          </p>
          <div style="display: flex; justify-content: center; gap: 0.65rem; margin-top: 1.25rem; flex-wrap: wrap;">
            <a href="/catat-aktivitas" class="btn btn-primary btn-sm">
              <Icon name="plus" size={14} /> <span>Catat Aktivitas</span>
            </a>
            <a href="/aktivitas-saya" class="btn btn-secondary btn-sm">
              <span>Buka Semua Riwayat ({mine.length}) &rarr;</span>
            </a>
          </div>
        </div>

        <div class="card" style="overflow: hidden;">
          {mine.length === 0 ? (
            <div class="empty" style="padding: 3.5rem 1.5rem;">
              <div style="width: 3.5rem; height: 3.5rem; border-radius: 50%; background: var(--color-primary-100); color: var(--color-primary-700); display: grid; place-items: center; margin: 0 auto 1rem;">
                <Icon name="clipboard" size={28} />
              </div>
              <h3 style="font-size: 1.15rem; margin-bottom: 0.4rem;">Belum ada aktivitas yang dicatat</h3>
              <p class="muted text-sm" style="max-width: 42ch; margin: 0 auto 1.5rem;">
                Gunakan Pusat Aksi Cepat di atas untuk mencatat kegiatan kerja harian Anda seperti Oplah, Klien Baru, atau Penawaran Iklan.
              </p>
              <a href="/catat-aktivitas" class="btn btn-primary btn-sm">
                <Icon name="plus" size={14} /> <span>Catat Aktivitas Pertama</span>
              </a>
            </div>
          ) : (
            <div class="table-wrap">
              <table class="table">
                <thead>
                  <tr>
                    <th scope="col">ID &amp; Tanggal</th>
                    <th scope="col">Jenis Aktivitas</th>
                    <th scope="col">Rincian Deskripsi</th>
                    <th scope="col">Jumlah / Nilai</th>
                    <th scope="col">Status Verifikasi</th>
                    <th scope="col" style="text-align: right;">Aksi</th>
                  </tr>
                </thead>
                <tbody>
                  {mine.slice(0, 5).map((a) => (
                    <tr>
                      <td>
                        <div class="mono" style="font-weight: 700; color: var(--color-primary-900); font-size: var(--text-xs);">{a.id}</div>
                        <div class="muted text-xs">{dateID(a.date)}</div>
                      </td>
                      <td>
                        <span class="badge badge-neutral" style="font-size: 0.75rem;">
                          {TYPE_LABEL[a.type] ?? a.type}
                        </span>
                      </td>
                      <td style="max-width: 22rem;">
                        <div style="font-weight: 500; font-size: var(--text-sm); line-height: 1.4;">{a.description}</div>
                      </td>
                      <td style="white-space: nowrap;">
                        {a.qty && <span class="mono text-xs font-bold">{num(a.qty)} eks</span>}
                        {a.value && <span class="mono text-xs font-bold" style="color:#059669;">{rupiah(a.value)}</span>}
                        {!a.qty && !a.value && <span class="muted text-xs">—</span>}
                      </td>
                      <td>
                        <Badge status={a.status} />
                      </td>
                      <td style="text-align: right; white-space: nowrap;">
                        <a href={`/employee/activities/${a.id}`} class="btn btn-secondary btn-sm" style="padding: 0.25rem 0.55rem; font-size: var(--text-xs);">
                          Rincian &rarr;
                        </a>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
              {mine.length > 5 && (
                <div style="padding: 0.85rem 1.25rem; background: #fafbfd; border-top: 1px solid var(--color-border); text-align: center;">
                  <a href="/aktivitas-saya" class="btn btn-secondary btn-sm">
                    Lihat Seluruh {mine.length} Laporan Aktivitas di Halaman Riwayat &rarr;
                  </a>
                </div>
              )}
            </div>
          )}
        </div>
      </section>
    </>
  ) : (
    /* TAMPILAN STANDAR JIKA BELUM LOGIN ATAU ROLE ADMIN/HRD */
    <>
      <!-- Metric Counter Bar -->
      <section class="landing-metrics">
        <div class="metrics-container">
          <div class="metric-item">
            <span class="metric-number">100%</span>
            <span class="metric-label">Divisi Pemasaran &amp; Sirkulasi</span>
            <span class="metric-desc">Pusat kendali terpadu operasional komersial</span>
          </div>
          <div class="metric-item">
            <span class="metric-number">6</span>
            <span class="metric-label">Modul Aktivitas Lapangan</span>
            <span class="metric-desc">Sirkulasi, Klien Iklan, Event, Profiling, Penawaran, Closing</span>
          </div>
